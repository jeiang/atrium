#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 2 ] || ! [ "$1" -ge 1 ] 2>/dev/null || ! [ "$2" -ge "$1" ] 2>/dev/null; then
  echo "usage: tools/go-test-shard SHARD TOTAL (1 <= SHARD <= TOTAL)" >&2
  exit 2
fi
shard=$1 total=$2
pkg=./cmd/atrium
flags=(-race ${ATRIUM_GO_TAGS:+-tags "$ATRIUM_GO_TAGS"})

bin=$(mktemp -d)
trap 'rm -rf "$bin"' EXIT
go build ${ATRIUM_GO_TAGS:+-tags "$ATRIUM_GO_TAGS"} -o "$bin/atrium" ./cmd/atrium
if [ "$shard" -eq 1 ]; then
  go test "${flags[@]}" -count=1 -exec true ./... >/dev/null
else
  go test "${flags[@]}" -count=1 -exec true "$pkg" >/dev/null
fi
export ATRIUM_E2E_BINARY=$bin/atrium

mapfile -t names < <(go test "${flags[@]}" -list '^(Test|Example|Fuzz)' "$pkg" | grep -E '^(Test|Example|Fuzz)' |
  awk -v times=.ci/go-test-times.tsv 'BEGIN { FS = "\t"; while ((getline line < times) > 0) { split(line, f, "\t"); w[f[1]] = f[2] } } { print (($0 in w) ? w[$0] : 2) "\t" $0 }' |
  LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -k2,2 |
  awk -F '\t' -v n="$total" -v k="$shard" '{ m = 1; for (i = 2; i <= n; i++) if (load[i] < load[m]) m = i; load[m] += $1; if (m == k) print $2 }')
if [ ${#names[@]} -eq 0 ]; then
  echo "go-test-shard: shard $shard of $total has no tests" >&2
  exit 1
fi
echo "go-test-shard: shard $shard of $total runs ${#names[@]} tests of $pkg" >&2

run_tests() {
  if [ -z "${ATRIUM_GO_TEST_JSON:-}" ]; then
    bash tools/e2e-loopback go test "${flags[@]}" -count=1 -timeout 60m "$@"
    return
  fi
  local status=0
  bash tools/e2e-loopback go test "${flags[@]}" -json -count=1 -timeout 60m "$@" >"$bin/report.json" || status=$?
  cat "$bin/report.json" >>"$ATRIUM_GO_TEST_JSON"
  if [ "$status" -ne 0 ]; then
    jq -rj 'select(.Action == "output" or .Action == "build-output") | .Output' "$bin/report.json"
  else
    jq -rj 'select(.Action == "output" and .Test == null) | .Output' "$bin/report.json"
  fi
  return "$status"
}

if [ "$shard" -eq 1 ]; then
  mapfile -t rest < <(go list ./... | grep -v '/cmd/atrium$')
  run_tests "${rest[@]}"
fi
run=$(IFS='|'; echo "${names[*]}")
run_tests -run "^($run)\$" "$pkg"
