{
  "components": {
    "schemas": {
      "ApplicationReadCommandsStatus": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CommandsStatus"
          },
          "revision": {
            "type": "string"
          }
        },
        "required": [
          "revision",
          "data"
        ],
        "type": "object"
      },
      "CommandsAuditRow": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "operation": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "operation",
          "outcome"
        ],
        "type": "object"
      },
      "CommandsStatus": {
        "additionalProperties": false,
        "properties": {
          "audit": {
            "items": {
              "$ref": "#/components/schemas/CommandsAuditRow"
            },
            "type": "array"
          },
          "command_id": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "effect_ids": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "running",
              "succeeded",
              "failed",
              "interrupted"
            ],
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "command_id",
          "state",
          "created_at",
          "audit",
          "effect_ids"
        ],
        "type": "object"
      },
      "CoremoduleIdentity": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "type": "integer"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "subject",
          "email",
          "name",
          "api_version"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "api_unavailable",
                  "auth_unavailable",
                  "bad_cursor",
                  "bad_request",
                  "budget_exceeded",
                  "canceled",
                  "command_interrupted",
                  "command_result_withheld",
                  "conflict",
                  "cross_origin",
                  "effect_partial",
                  "effect_unknown",
                  "forbidden",
                  "idempotency_in_progress",
                  "idempotency_mismatch",
                  "internal",
                  "invalid",
                  "invalid_token",
                  "not_configured",
                  "not_found",
                  "rate_limited",
                  "refused",
                  "too_large",
                  "unauthenticated",
                  "unavailable",
                  "unsupported_media_type"
                ],
                "type": "string"
              },
              "command_id": {
                "type": "string"
              },
              "diagnostic_id": {
                "type": "string"
              },
              "effect_ids": {
                "items": {
                  "format": "int64",
                  "type": "integer"
                },
                "type": "array"
              },
              "fields": {
                "items": {
                  "properties": {
                    "ctx": {
                      "type": "object"
                    },
                    "input": {},
                    "loc": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "loc",
                    "msg"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "instance": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retry_after": {
                "type": "integer"
              },
              "status": {
                "type": "integer"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "atrium API",
    "version": "1"
  },
