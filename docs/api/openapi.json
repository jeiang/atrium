{
  "components": {
    "schemas": {
      "CoremoduleIdentity": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "type": "integer"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "subject",
          "email",
          "name",
          "api_version"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "api_unavailable",
                  "auth_unavailable",
                  "bad_cursor",
                  "bad_request",
                  "budget_exceeded",
                  "canceled",
                  "conflict",
                  "cross_origin",
                  "effect_partial",
                  "effect_unknown",
                  "forbidden",
                  "idempotency_in_progress",
                  "idempotency_mismatch",
                  "internal",
                  "invalid",
                  "invalid_token",
                  "not_configured",
                  "not_found",
                  "rate_limited",
                  "refused",
                  "too_large",
                  "unauthenticated",
                  "unavailable",
                  "unsupported_media_type"
                ],
                "type": "string"
              },
              "diagnostic_id": {
                "type": "string"
              },
              "effect_ids": {
                "items": {
                  "format": "int64",
                  "type": "integer"
                },
                "type": "array"
              },
              "fields": {
                "items": {
                  "properties": {
                    "ctx": {
                      "type": "object"
                    },
                    "input": {},
                    "loc": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "loc",
                    "msg"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "instance": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retry_after": {
                "type": "integer"
              },
              "status": {
                "type": "integer"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "atrium API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/me": {
      "get": {
        "operationId": "auth.identity",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoremoduleIdentity"
                }
              }
            },
            "description": "OK",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "tags": [
          "settings"
        ],
        "x-atrium-area": "settings",
        "x-atrium-module": "core"
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
