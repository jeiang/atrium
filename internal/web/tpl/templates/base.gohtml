<!doctype html>
<html lang="en" data-theme="{{.Theme}}"{{if eq .Theme "dark"}} class="dark"{{end}}>
<head>
  {{template "document_head" .}}
</head>
<body class="app" hx-headers='{{tojson (dict "X-CSRF-Token" .CSRF)}}'{{block "body_attrs" .}}{{end}}>
  <a href="#content" class="sr-only rounded-md bg-primary px-3 py-2 text-sm text-primary-foreground focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50">Skip to content</a>
  {{template "app_sidebar" .}}
  <div id="sidebar-backdrop" class="sb-backdrop" data-action="close-sidebar"></div>
  <main class="app-main">
    <div class="sticky top-0 z-30 bg-background">
    {{if .Auth.NoAuth}}<div class="flex items-start gap-2 border-b border-warning/30 bg-warning/10 px-3 py-1.5 text-sm text-warning md:px-6">{{icon "circle-alert"}}<span>Authentication is disabled</span></div>{{end}}
    {{with .NotifyFailing}}<div class="flex items-start gap-2 border-b border-destructive/30 bg-destructive/10 px-3 py-1.5 text-sm text-destructive md:px-6" data-notify-failing>{{icon "circle-alert"}}<span>Push failing: {{join ", " .}}. <a class="underline underline-offset-4" href="/settings/notifications">Check devices</a></span></div>{{end}}
    {{with .IntegrationAlerts}}<div class="flex items-start gap-2 border-b border-destructive/30 bg-destructive/10 px-3 py-1.5 text-sm text-destructive md:px-6" data-integration-alerts>{{icon "circle-alert"}}<span>Integrations: {{join ", " .}}. <a class="underline underline-offset-4" href="/settings/integrations">Check integrations</a></span></div>{{end}}
    <header class="topbar">
      <button id="nav-toggle" type="button" class="btn md:hidden" data-variant="ghost" data-size="icon-sm" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false" data-action="open-sidebar">{{icon "menu"}}</button>
      <h1>{{block "heading" .}}{{end}}</h1>
      {{block "header_meta" .}}{{end}}
      <div class="ms-auto flex shrink-0 items-center gap-2">
        <button id="palette-open" type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="Open command palette" aria-haspopup="dialog" aria-controls="palette" title="Search and commands (⌘K)" data-action="open-palette">{{icon "search"}}</button>
        {{block "header_actions" .}}{{end}}
        {{template "mode_badge" (dict "mode" .Mode "paused" .Paused)}}
        {{if and (eq .Mode "live") (or .Auth.Admin (not .Paused))}}
        <form method="post" action="/live/{{if .Paused}}resume{{else}}pause{{end}}">
          <input type="hidden" name="csrf_token" value="{{.CSRF}}">
          <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon (ternary .Paused "zap" "lock")}}{{if .Paused}}Resume{{else}}Pause{{end}}</button>
        </form>
        {{end}}
      </div>
    </header>
    {{with .Tabs}}<nav class="hub-tabs" aria-label="Sections">{{range .}}<a href="{{.URL}}" class="hub-tab"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>{{end}}
    </div>
    <div id="content" tabindex="-1" class="{{block "content_class" .}}page-content{{end}}">
      {{block "content" .}}{{end}}
    </div>
  </main>

  <dialog id="reader" class="drawer" data-side="right" aria-label="Message">
    <article class="w-full max-w-none sm:max-w-2xl">
      <header class="flex-row items-center justify-between border-b">
        <h2 class="text-sm font-medium">Message</h2>
        <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="Close message" data-action="close-dialog">{{icon "x"}}</button>
      </header>
      <section id="reader-body" data-loading="reader-loading" class="p-4 md:p-6"></section>
    </article>
  </dialog>

  {{template "palette" .}}

  <template id="reader-loading">
    <div class="flex flex-col gap-3" role="status" aria-label="Loading message">
      <div class="skeleton h-6 w-3/4 rounded-md bg-muted"></div>
      <div class="skeleton h-4 w-1/2 rounded-md bg-muted"></div>
      <div class="skeleton mt-4 h-40 w-full rounded-md bg-muted"></div>
    </div>
  </template>

  {{$toasts := list}}
  {{with .Toast}}{{$toasts = list (dict "category" .Category "title" .Title "description" .Description)}}{{end}}
  {{template "toaster" (dict "toasts" $toasts)}}
</body>
</html>
{{define "app_sidebar"}}{{$path := .Path}}
<aside id="sidebar" class="app-sidebar" data-rail="{{.Rail}}" aria-label="Sidebar">
  <div class="sb-head">
    <a href="{{or .BrandURL "/"}}" class="sb-brand">{{template "brand_mark"}}</a>
    {{$railLabel := ternary .Rail "Expand sidebar" "Collapse sidebar"}}<button type="button" class="btn ms-auto max-md:hidden" data-variant="ghost" data-size="icon-sm" data-action="toggle-rail" aria-controls="sidebar" aria-expanded="{{not .Rail}}" aria-label="{{$railLabel}}" title="{{$railLabel}}">{{icon "panel-left"}}</button>
    <button type="button" class="btn ms-auto md:hidden" data-variant="ghost" data-size="icon-sm" data-action="close-sidebar" aria-label="Close navigation">{{icon "x"}}</button>
  </div>
  <nav class="sb-body" aria-label="Primary">
    {{if .Threads}}<a href="/chat" class="sb-item" title="Today"{{if eq $path "/chat"}} aria-current="page"{{end}} data-today>{{icon "sun"}}<span class="sb-label">Today</span></a>{{end}}
    {{range .Nav}}
    <section class="sb-section"{{with .Label}} aria-label="{{.}}"{{end}}>
      {{with .Label}}<h2 class="sb-title">{{.}}</h2>{{end}}
      {{range .Items}}<a href="{{.URL}}" class="sb-item" title="{{.Label}}"{{if .Current}} aria-current="page"{{end}}>{{icon .Icon}}<span class="sb-label">{{.Label}}</span>{{if .Badge}}{{template "pending_badge" (dict "count" $.PendingCount)}}{{end}}</a>{{end}}
    </section>
    {{end}}
    {{with .Threads}}
    <div class="sb-threads">
      {{if .Pinned}}{{template "sb_threads" (dict "label" "Pinned" "threads" .Pinned "path" $path)}}{{end}}
      {{range .Dated}}{{template "sb_threads" (dict "label" .Label "threads" .Threads "path" $path)}}{{end}}
      {{range .Projects}}
      <details class="sb-section"{{range .Threads}}{{if eq .URL $path}} open{{end}}{{end}}>
        <summary class="sb-title">{{icon "chevron-right"}}<span class="truncate">{{.Label}}</span></summary>
        {{range .Threads}}{{template "sb_thread" (dict "t" . "path" $path)}}{{end}}
        <a href="{{.URL}}" class="sb-item sb-thread text-ink-3">{{icon "settings"}}<span class="sb-label">Project settings</span></a>
      </details>
      {{end}}
      <a href="/projects/new" class="sb-item sb-thread text-ink-3">{{icon "folder"}}<span class="sb-label">New project</span></a>
    </div>
    {{end}}
  </nav>
  <div class="sb-foot">
    {{range .Footer}}<a href="{{.URL}}" class="sb-item" title="{{.Label}}"{{if .Current}} aria-current="page"{{end}}>{{icon .Icon}}<span class="sb-label">{{.Label}}</span></a>{{end}}
    {{if .Auth.Admin}}{{with .SettingsURL}}<a href="{{.}}" class="sb-item" title="Settings"{{if eq $.Page "settings"}} aria-current="page"{{end}}>{{icon "settings"}}<span class="sb-label">Settings</span></a>{{end}}{{end}}
    {{if .Auth.SignOut}}<form method="post" action="/logout">
      <input type="hidden" name="csrf_token" value="{{.CSRF}}">
      <button type="submit" class="sb-item w-full" title="Sign out" aria-label="Sign out">{{icon "log-out"}}<span class="sb-label text-start">Sign out</span></button>
    </form>{{end}}
    <div class="sb-theme" role="group" aria-label="Theme">
      <button type="button" data-action="set-theme" data-theme-value="system" aria-pressed="{{eq .Theme "system"}}" title="System theme" aria-label="System theme">{{icon "monitor"}}</button>
      <button type="button" data-action="set-theme" data-theme-value="light" aria-pressed="{{eq .Theme "light"}}" title="Light theme" aria-label="Light theme">{{icon "sun"}}</button>
      <button type="button" data-action="set-theme" data-theme-value="dark" aria-pressed="{{eq .Theme "dark"}}" title="Dark theme" aria-label="Dark theme">{{icon "moon"}}</button>
    </div>
  </div>
</aside>
{{- end}}
{{define "palette"}}
<dialog id="palette" class="palette" aria-labelledby="palette-title"{{if .Threads}} data-palette-threads="/chat/palette"{{end}}>
  <div class="palette-box">
    <h2 id="palette-title" class="sr-only">Command palette</h2>
    <div class="palette-search">
      {{icon "search"}}
      <input id="palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" aria-label="Search threads, pages and actions" placeholder="Search threads, pages, actions" autocomplete="off" spellcheck="false">
    </div>
    <div id="palette-list" role="listbox" aria-label="Results" class="palette-list">
      {{if .Threads}}
      <div role="group" aria-labelledby="palette-h-threads" data-palette-group="threads">
        <div id="palette-h-threads" role="presentation" class="palette-head">Threads</div>
        <div data-palette-thread-options></div>
      </div>
      {{end}}
      <div role="group" aria-labelledby="palette-h-actions">
        <div id="palette-h-actions" role="presentation" class="palette-head">Actions</div>
        {{if .Threads}}
        <div id="palette-action-new" role="option" aria-selected="false" class="palette-option" data-palette-href="/chat">{{icon "plus"}}<span class="truncate">New thread</span></div>
        <div id="palette-action-today" role="option" aria-selected="false" class="palette-option" data-palette-href="/today">{{icon "sun"}}<span class="truncate">Today</span></div>
        {{end}}
        <div id="palette-action-light" role="option" aria-selected="false" class="palette-option" data-palette-theme="light">{{icon "sun"}}<span class="truncate">Light theme</span></div>
        <div id="palette-action-dark" role="option" aria-selected="false" class="palette-option" data-palette-theme="dark">{{icon "moon"}}<span class="truncate">Dark theme</span></div>
        <div id="palette-action-system" role="option" aria-selected="false" class="palette-option" data-palette-theme="system">{{icon "monitor"}}<span class="truncate">System theme</span></div>
        <div id="palette-action-sidebar" role="option" aria-selected="false" class="palette-option" data-palette-sidebar>{{icon "panel-left"}}<span class="truncate">Toggle sidebar</span></div>
      </div>
      <div role="group" aria-labelledby="palette-h-pages">
        <div id="palette-h-pages" role="presentation" class="palette-head">Pages</div>
        {{range $i, $p := .Pages}}<div id="palette-page-{{$i}}" role="option" aria-selected="false" class="palette-option" data-palette-href="{{$p.URL}}">{{icon (or $p.Icon "arrow-right")}}<span class="truncate">{{$p.Label}}</span>{{with $p.Group}}<span class="palette-hint">{{.}}</span>{{end}}</div>
        {{end}}
        {{if .Auth.Admin}}{{range $i, $p := .Settings}}<div id="palette-settings-{{$i}}" role="option" aria-selected="false" class="palette-option" data-palette-href="{{$p.URL}}">{{icon "settings"}}<span class="truncate">{{$p.Label}}</span><span class="palette-hint">Settings</span></div>
        {{end}}{{end}}
      </div>
    </div>
    <p class="palette-empty" hidden data-palette-empty>No matches</p>
  </div>
</dialog>
{{- end}}
{{define "sb_threads"}}{{$path := .path}}
<section class="sb-section" aria-label="{{.label}}">
  <h2 class="sb-title">{{.label}}</h2>
  {{range .threads}}{{template "sb_thread" (dict "t" . "path" $path)}}{{end}}
</section>
{{- end}}
{{define "sb_thread"}}{{$t := .t}}<a href="{{$t.URL}}" class="sb-item sb-thread" title="{{$t.Title}}"{{if eq $t.URL .path}} aria-current="page"{{end}}><span class="sb-label">{{$t.Title}}</span>{{if $t.Running}}<span class="sb-dot" role="status" aria-label="Running"></span>{{end}}</a>{{end}}
{{define "document_head"}}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="{{if eq .Theme "light"}}light{{else if eq .Theme "dark"}}dark{{else}}light dark{{end}}">
  <title>{{block "title" .}}{{end}} · atrium</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cstyle%3Erect%7Bfill:%231e1a16%7Dtext%7Bfill:%23fbfaf7%7D@media (prefers-color-scheme:dark)%7Brect%7Bfill:%23edebe7%7Dtext%7Bfill:%2313110f%7D%7D%3C/style%3E%3Crect width='32' height='32' rx='7'/%3E%3Ctext x='16' y='22.5' font-family='ui-monospace,monospace' font-size='19' font-weight='600' text-anchor='middle'%3Ea%3C/text%3E%3C/svg%3E">
  <link rel="manifest" href="/static/manifest.json" crossorigin="use-credentials">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <link rel="preload" href="/static/fonts/inter-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/inter-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  {{block "preload" .}}{{end}}
  <link rel="stylesheet" href="{{asset "app.css"}}">
  <script src="{{asset "htmx.min.js"}}" defer></script>
  <script src="{{asset "basecoat/all.min.js"}}" defer></script>
  <script src="{{asset "app.js"}}" defer></script>
{{end}}
{{define "brand_mark"}}<span class="sb-mark" aria-hidden="true">a</span><span class="text-base font-semibold tracking-tight">atrium</span>{{end}}
