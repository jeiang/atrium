{{define "mode_badge"}}{{$paused := opt . "paused" false -}}
{{if and (eq .mode "live") $paused -}}
<span class="badge border-warning/30 bg-warning/10 text-warning" title="Routing is recorded; no mail is changed">{{icon "lock"}}Live, paused</span>
{{- else if eq .mode "live" -}}
<span class="badge" data-variant="destructive" title="atrium files, flags and trashes mail by your rules">{{icon "zap"}}Live</span>
{{- else -}}
<span class="badge border-warning/30 bg-warning/10 text-warning" title="Nothing changes automatically; approved proposals still run">{{icon "eye-off"}}Shadow</span>
{{- end}}{{end}}

{{define "action_badge"}}{{$badge := badge "action" .Status -}}
{{if not $badge}}{{fail "unknown action status %v" .Status}}{{end -}}
<span class="badge" data-variant="{{$badge.Variant}}"{{if .Error}} title="{{.Error}}"{{end}}>{{$badge.Label}}</span>
{{- end}}

{{define "stage_badge"}}<span class="badge" data-variant="outline"><span class="size-2 rounded-full {{lbl "stage_dot" . "bg-chart-6"}}" aria-hidden="true"></span>{{lbl "stage" .}}</span>{{end}}

{{define "reason"}}{{$d := .d}}{{$detail := or (opt $d "detail" nil) (dict) -}}
{{if eq $d.stage "correction" -}}Recorded by you as a correction.{{if ne .mode "live"}} Shadow mode leaves the message where it is.{{end}}
{{- else if eq $d.stage "operator" -}}Rule <code class="font-mono">{{$d.key}}</code> matched first.
{{- else if eq $d.stage "learned" -}}{{pct $d.confidence}} of {{opt $detail "n" ""}} filed messages with this {{lbl "level" $d.key}} went here.
{{- else if eq $d.stage "knn" -}}The most similar filed messages vote {{pct $d.confidence}} for this destination.
{{- else if eq $d.stage "llm" -}}The 9B chose this {{if opt $detail "confident" false}}and was confident{{else}}but was not confident{{end}}.
{{- else -}}No stage was sure, so the fallback applies.
{{- end}}{{end}}

{{define "agreement"}}{{if eq . "agree" -}}
<span class="inline-flex items-center gap-1 text-success">{{icon "check" "size-3.5"}}Matches</span>
{{- else if eq . "disagree" -}}
<span class="inline-flex items-center gap-1 text-warning">{{icon "equal-not" "size-3.5"}}Differs</span>
{{- else if eq . "pending" -}}
<span class="inline-flex items-center gap-1 text-muted-foreground">{{icon "inbox" "size-3.5"}}In inbox</span>
{{- else -}}
<span class="inline-flex items-center gap-1 text-muted-foreground">{{icon "x" "size-3.5"}}Gone</span>
{{- end}}{{end}}

{{define "open_attrs"}}href="/messages/{{.}}" hx-get="/messages/{{.}}" hx-target="#reader-body" hx-swap="innerHTML show:top"{{end}}

{{define "when"}}{{if .epoch}}<time datetime="{{ts .epoch "iso"}}">{{ts .epoch (opt . "style" "date")}}</time>{{end}}{{end}}

{{define "account_switch"}}{{$path := .path}}{{$current := .current -}}
<nav class="button-group" aria-label="{{opt . "label" "Account"}}">
  <a class="btn" data-size="sm" data-variant="{{if not $current}}secondary{{else}}outline{{end}}" href="{{safeurl $path}}"{{if not $current}} aria-current="page"{{end}}>All accounts</a>
  {{range global "accounts"}}
  <a class="btn" data-size="sm" data-variant="{{if eq $current .}}secondary{{else}}outline{{end}}" href="{{safeurl $path}}?account={{.}}"{{if eq $current .}} aria-current="page"{{end}}>{{.}}</a>
  {{end}}
</nav>
{{- end}}

{{define "folder_options"}}{{$selected := opt . "selected" nil -}}
{{range .folders}}
<option value="{{.Folder}}"{{if eq .Folder (str $selected)}} selected{{end}}>{{.Folder}}</option>
{{end}}
{{- end}}

{{define "empty_state"}}<div class="empty border">
  <header>
    <figure>{{icon .icon_name}}</figure>
    <h3>{{.title}}</h3>
    {{if haskey . "body"}}<p>{{.body}}</p>{{end}}
  </header>
</div>{{end}}

{{define "condition_text"}}{{$value := .Value -}}
<span class="font-medium">{{lbl "field" .Field}}</span>
<span class="text-muted-foreground">{{lbl "op" .Op}}</span>
{{- if present $value}}
<code class="rounded-sm bg-muted px-1 py-0.5 font-mono text-xs break-all">{{join ", " $value}}</code>
{{- end}}
{{- end}}

{{define "spinner"}}<span id="{{.id}}" class="htmx-indicator inline-flex text-muted-foreground" role="status" aria-label="{{opt . "label" "Loading"}}">{{icon "loader-circle" "size-4 animate-spin"}}</span>{{end}}

{{define "status_badge"}}{{if eq . "applied" -}}
<span class="badge border-success/30 bg-success/10 text-success">{{icon "check"}}{{lbl "status" .}}</span>
{{- else if eq . "failed" -}}
<span class="badge" data-variant="destructive">{{icon "circle-alert"}}{{lbl "status" .}}</span>
{{- else if eq . "approved" -}}
<span class="badge" data-variant="outline">{{icon "loader-circle" "animate-spin"}}{{lbl "status" .}}</span>
{{- else if eq . "pending" -}}
<span class="badge" data-variant="outline">{{lbl "status" .}}</span>
{{- else -}}
<span class="badge" data-variant="secondary">{{lbl "status" .}}</span>
{{- end}}{{end}}

{{define "pending_badge"}}<span id="pending-count" class="badge ms-auto empty:hidden" data-variant="secondary"{{if opt . "oob" false}} hx-swap-oob="true"{{end}}>{{if .count}}{{.count}}<span class="sr-only"> pending</span>{{end}}</span>{{end}}

{{define "external"}}href="{{safeurl .}}" target="_blank" rel="noopener noreferrer"{{end}}

{{define "page_link"}}<a class="rounded-sm font-medium underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{opt . "class" ""}}" href="/notion/{{urlencode (opt .ref "id" "")}}">{{or (opt .ref "title" "") "Untitled"}}</a>{{end}}

{{define "run_badge"}}{{$state := .}}{{with badge "run" .}}<span class="badge" data-variant="{{.Variant}}">{{if eq $state "running"}}{{icon "loader-circle" "animate-spin"}}{{end}}{{.Label}}</span>{{end}}{{end}}

{{define "preview_attrs"}}href="{{safeurl .}}" hx-get="{{safeurl .}}" hx-target="#preview-body" hx-swap="innerHTML show:top"{{end}}

{{define "reference_button"}}<button type="button" class="btn" data-size="icon-sm" data-variant="ghost" data-action="copy-value" data-copy="@thread/{{.thread.ID}}/m{{.seq}}" aria-label="Reference" title="Copy a reference to this message">{{icon "link" "size-3.5"}}</button>{{end}}

{{define "branch_button"}}<form method="post" action="/chat/{{.thread.ID}}/branch" class="inline">
  <input type="hidden" name="csrf_token" value="{{.csrf}}">
  <input type="hidden" name="seq" value="{{.seq}}">
  {{if opt . "compact" false}}<button type="submit" class="btn" data-size="icon-sm" data-variant="ghost" aria-label="Branch" title="Start a new thread with the conversation up to here">{{icon "git-branch" "size-3.5"}}</button>{{else}}<button type="submit" class="btn" data-size="sm" data-variant="ghost" title="Start a new thread with the conversation up to here">{{icon "git-branch" "size-3.5"}}Branch</button>{{end}}
</form>{{end}}

{{define "file_icon"}}{{$name := "file-text"}}{{if hasprefix .media_type "image/"}}{{$name = "image"}}{{end}}{{icon $name (opt . "class" "size-3.5 shrink-0 text-muted-foreground")}}{{end}}

{{define "file_chips"}}{{$thread_id := .thread_id -}}
{{if .files}}
<ul class="flex flex-wrap gap-1" aria-label="Attached files" data-attachments>
  {{range .files}}<li><a class="badge max-w-64" data-variant="outline" {{template "preview_attrs" (printf "/chat/%v/files/%v" $thread_id .ID)}}>{{template "file_icon" (dict "media_type" .MediaType "class" "size-3")}}<span class="truncate">{{.Name}}</span></a></li>{{end}}
</ul>
{{end}}
{{- end}}

{{define "ref_picker"}}<div id="ref-picker" class="ref-picker" role="listbox" aria-label="Reference a thread" hidden></div>{{end}}

{{define "attach_field"}}<input type="file" name="upload" multiple class="sr-only" tabindex="-1" data-upload>
<ul class="flex flex-wrap gap-1 empty:hidden" aria-label="Files to send" data-chips></ul>{{end}}

{{define "attach_button"}}<button type="button" class="btn" data-size="sm" data-variant="ghost" data-action="pick-files" title="Attach files: PDF, images, text, CSV, docx, xlsx">{{icon "paperclip" "size-3.5"}}Attach</button>{{end}}

{{define "activity_step"}}{{$state := .State}}
{{if eq .Kind "thinking"}}
<li data-step="thinking">
  <details class="trace" data-kind="thinking">
    <summary><span class="trace-icon">{{icon "brain"}}</span><span class="trace-label">Thinking</span></summary>
    <div class="trace-body whitespace-pre-wrap break-words">{{.Text}}</div>
  </details>
</li>
{{else if eq .Kind "note"}}
<li class="trace-note" data-step="note"><div class="markdown prose-assistant min-w-0">{{markdown .Text}}</div></li>
{{else if eq .Kind "tool"}}
<li data-step="tool" data-tool-id="{{.ID}}">
  <details class="trace">
    <summary>
      <span class="trace-icon">{{icon (ternary (eq .Name "research") "users" "wrench")}}</span><span class="trace-label">{{toolverb .Name}}</span>
      <span class="trace-args">{{.Args}}</span>
      {{if eq (str $state) "unknown"}}<span class="badge ms-auto" data-variant="destructive">unverified</span>
      {{else if .IsError}}<span class="badge ms-auto" data-variant="destructive">error</span>
      {{else if eq (str $state) "started"}}<span class="badge ms-auto" data-variant="outline">{{icon "loader-circle" "animate-spin"}}running</span>{{end}}
    </summary>
    <div class="trace-body trace-code">{{or (.Result) "(no result yet)"}}</div>
    {{with .ChildThreadID}}<a class="trace-link" href="/chat/{{.}}">Subagent transcript</a>{{end}}
  </details>
</li>
{{else if eq .Kind "web_search"}}
<li data-step="web_search">
  <details class="trace">
    <summary><span class="trace-icon">{{icon "globe"}}</span><span class="trace-label">Searched the web</span><span class="trace-args">{{len .Results}} results</span>{{with .Error}} <span class="badge ms-auto" data-variant="destructive">{{.}}</span>{{end}}</summary>
    <ul class="trace-body flex flex-col gap-1">
      {{range .Results}}<li><a class="underline underline-offset-4" {{template "external" .URL}}>{{truncate 80 .Title}}</a></li>{{end}}
    </ul>
  </details>
</li>
{{end}}
{{- end}}

{{define "activity_summary"}}{{$thought := false}}{{$tools := 0}}{{range .}}{{if eq .Kind "thinking"}}{{$thought = true}}{{else if or (eq .Kind "tool") (eq .Kind "web_search")}}{{$tools = inc $tools}}{{end}}{{end -}}
{{if $thought}}Thought{{end}}{{if and $thought $tools}} · {{end}}{{if $tools}}{{$tools}} tool{{if ne $tools 1}}s{{end}}{{end}}{{if not (or $thought $tools)}}Worked{{end}}
{{- end}}

{{define "chat_item"}}{{$item := .Item}}{{$thread := opt . "thread" nil}}{{$last_seq := opt . "last_seq" nil}}{{$busy := opt . "busy" false}}{{$csrf := opt . "csrf" ""}}
{{if eq $item.Kind "user"}}
<li class="msg group" data-role="user" data-seq="{{$item.Seq}}" id="m{{$item.Seq}}">
  <span class="msg-avatar" aria-hidden="true">{{icon "user"}}</span>
  <div class="msg-body">
    <div class="msg-user" data-text>{{reflinks $item.Text}}</div>
    {{if $thread}}{{template "file_chips" (dict "thread_id" $thread.ID "files" ($item.Files))}}{{end}}
    {{range $item.References}}
    <details class="rounded-lg border px-3 py-2 text-xs text-muted-foreground">
      <summary class="cursor-pointer">Referenced: {{.Title}} · {{.Tokens}} tokens</summary>
      <div class="mt-2 whitespace-pre-wrap break-words">{{.Text}}</div>
    </details>
    {{end}}
    {{if and $thread (eq $thread.Kind "chat")}}
    <div class="msg-actions">
      {{if and (eq $item.Seq (int $last_seq)) (not $busy)}}<button type="button" class="btn" data-size="icon-sm" data-variant="ghost" data-action="edit-message" aria-label="Edit" title="Edit message">{{icon "pencil" "size-3.5"}}</button>{{end}}
      {{template "reference_button" (dict "thread" $thread "seq" $item.Seq)}}
      {{template "branch_button" (dict "thread" $thread "seq" $item.Seq "csrf" $csrf "compact" true)}}
    </div>
    {{end}}
  </div>
</li>
{{else if eq $item.Kind "assistant"}}
<li class="msg group" data-role="assistant" data-seq="{{$item.Seq}}" id="m{{$item.Seq}}">
  <span class="msg-avatar" data-role="assistant" aria-hidden="true">a</span>
  <div class="msg-body">
    <div class="markdown prose-assistant">{{markdown $item.Text}}</div>
    {{with $item.Citations}}
    <ol class="flex flex-wrap gap-2 text-xs" aria-label="Sources">
      {{range $i, $c := .}}
      {{if opt $c "url" nil}}
      <li class="min-w-0 max-w-full"><a class="badge max-w-full" data-variant="secondary" {{template "external" $c.URL}} title="{{$c.Title}}"><span class="shrink-0">[{{inc $i}}]</span> {{icon "external-link" "size-3"}}<span class="truncate">{{truncate 60 $c.Title}}</span></a></li>
      {{else}}
      <li class="min-w-0 max-w-full"><span class="badge max-w-full" data-variant="secondary" title="{{$c.Cited}}"><span class="shrink-0">[{{inc $i}}]</span> {{icon "file-text" "size-3"}}<span class="truncate">{{truncate 40 $c.Title}}: “{{truncate 60 $c.Cited}}”</span></span></li>
      {{end}}
      {{end}}
    </ol>
    {{end}}
    {{if and $thread (eq $thread.Kind "chat")}}
    <div class="msg-actions">
      {{if and $last_seq (gt $item.Seq (int $last_seq)) (not $busy)}}
      <button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post="/chat/{{$thread.ID}}/regenerate" hx-target="#transcript" hx-swap="innerHTML" hx-disabled-elt="this">{{icon "refresh-cw" "size-3.5"}}Regenerate</button>
      {{end}}
      {{template "reference_button" (dict "thread" $thread "seq" $item.Seq)}}
      {{template "branch_button" (dict "thread" $thread "seq" $item.Seq "csrf" $csrf)}}
    </div>
    {{end}}
  </div>
</li>
{{else if eq $item.Kind "activity"}}
<li class="msg-indent" data-seq="{{$item.Seq}}" data-run="{{str $item.RunID}}">
  <details class="activity">
    <summary>{{icon "chevron-right" "activity-chevron"}}<span>{{template "activity_summary" $item.Steps}}</span><span class="text-ink-3">{{len $item.Steps}} step{{if ne (len $item.Steps) 1}}s{{end}}</span></summary>
    <ol class="activity-steps">
      {{range $item.Steps}}{{template "activity_step" .}}{{end}}
    </ol>
  </details>
</li>
{{else if eq $item.Kind "draft"}}
{{$d := $item.Draft}}
<li id="draft-{{get $d "id"}}" class="msg-indent" data-seq="{{$item.Seq}}" data-draft="{{get $d "id"}}" hx-get="/drafts/{{get $d "id"}}/card" hx-trigger="load" hx-swap="outerHTML">
  <a class="flex items-center gap-3 rounded-xl border bg-card px-3 py-2.5 text-sm hover:border-line-strong" {{template "preview_attrs" (printf "/drafts/%v" (get $d "id"))}}>
    {{icon "mail" "size-4 shrink-0 text-muted-foreground"}}
    <span class="flex min-w-0 flex-1 flex-col">
      <span class="truncate font-medium">{{or (get $d "subject") "(no subject)"}}</span>
      <span class="truncate text-xs text-muted-foreground">to {{get $d "to_addrs"}}</span>
    </span>
    <span class="badge" data-variant="{{if eq $d.status "sent"}}secondary{{else}}outline{{end}}">{{get $d "status"}}</span>
  </a>
</li>
{{else if eq $item.Kind "proposal"}}
<li id="proposal-{{$item.ProposalID}}" class="msg-indent" data-seq="{{$item.Seq}}" hx-get="/proposals/{{$item.ProposalID}}/card" hx-trigger="load" hx-swap="outerHTML">
  <a class="flex items-center gap-3 rounded-xl border bg-card px-3 py-2.5 text-sm hover:border-line-strong" href="/review#proposal-{{$item.ProposalID}}">
    {{icon "list-checks" "size-4 shrink-0 text-muted-foreground"}}<span class="truncate font-medium">Proposal #{{$item.ProposalID}}</span>
  </a>
</li>
{{else if eq $item.Kind "queued"}}
<li class="msg" data-queued="{{$item.ID}}">
  <span class="msg-avatar" aria-hidden="true">{{icon "user"}}</span>
  <div class="msg-body">
    <div class="msg-user border border-dashed border-line-strong bg-transparent">{{$item.Text}}</div>
    {{if $item.Files}}<span class="text-xs text-muted-foreground">{{icon "paperclip" "size-3"}} {{join ", " (mapattr "name" $item.Files)}}</span>{{end}}
    <span class="text-xs text-muted-foreground">{{icon "clock" "size-3"}} Queued: joins the conversation at the assistant's next step</span>
  </div>
</li>
{{else if eq $item.Kind "compaction"}}
<li class="flex items-center gap-3 text-xs text-muted-foreground" data-seq="{{$item.Seq}}" role="separator">
  <span class="h-px flex-1 bg-border"></span>Context compacted<span class="h-px flex-1 bg-border"></span>
</li>
{{end}}
{{- end}}
