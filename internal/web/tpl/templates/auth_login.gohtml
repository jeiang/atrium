{{define "bare"}}{{end}}
{{define "title"}}Sign in{{end}}
{{define "body_attrs"}}{{if .Data.Reason}} data-strip-params="reason"{{end}}{{end}}
{{define "content"}}
<h1 class="text-lg font-semibold tracking-tight">Sign in</h1>
{{if .Data.Message}}<div class="alert" data-variant="{{if eq .Data.Tone "destructive"}}destructive{{else}}default{{end}}" role="{{if eq .Data.Tone "destructive"}}alert{{else}}status{{end}}">{{if eq .Data.Tone "destructive"}}{{icon "circle-alert"}}{{end}}<p>{{.Data.Message}}</p></div>{{end}}
{{if .Data.Start}}
<form method="post" action="/login" class="flex flex-col gap-3">
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  <input type="hidden" name="next" value="{{.Data.Next}}">
  <button type="submit" class="btn w-full" autofocus>{{icon "log-in"}}{{.Data.Button}}</button>
</form>
{{end}}
{{end}}
