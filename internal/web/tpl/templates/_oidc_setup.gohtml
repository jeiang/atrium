{{$s := .Data.Setup}}
<ol class="flex list-decimal flex-col gap-2 py-3 ps-9 pe-4 text-sm text-ink-2">
  {{range $s.Steps}}<li>{{range .Parts}}{{if .Chip}}<span class="inline-flex items-center gap-1"><code id="{{.ID}}" class="rounded-sm bg-muted px-1 py-0.5 font-mono text-xs break-all">{{.Chip}}</code><button type="button" class="btn" data-variant="ghost" data-size="icon-sm" data-action="copy-value" data-target="{{.ID}}" aria-label="Copy">{{icon "copy" "size-3.5"}}</button></span>{{else if .Missing}}<span class="text-destructive">Public URL is not set</span>{{else}}{{.Text}}{{end}}{{end}}</li>{{end}}
</ol>
<form method="post" action="/settings/auth/test" target="oidc-test" class="set-rows border-t" data-test-signin>
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  <input type="hidden" name="preset" value="{{$s.Preset}}">
  {{range $s.Fields}}{{if eq .Group "primary"}}
  <div role="group" class="set-row border-t"><label for="{{.ID}}">{{.Label}}{{if .Pinned}} <span class="badge" data-variant="outline">Pinned</span>{{end}}</label><input id="{{.ID}}" name="{{.Key}}" type="{{.Type}}" class="input sm:w-80" value="{{.Value}}" autocomplete="off"{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Required}} required{{end}}{{if .Disabled}} disabled{{end}}></div>
  {{end}}{{end}}
  {{range $s.Fields}}{{if eq .Group "groups"}}
  <div role="group" class="set-row border-t"><label for="{{.ID}}">{{.Label}}{{if .Pinned}} <span class="badge" data-variant="outline">Pinned</span>{{end}}</label><input id="{{.ID}}" name="{{.Key}}" type="{{.Type}}" class="input sm:w-80" value="{{.Value}}" autocomplete="off"{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Required}} required{{end}}{{if .Disabled}} disabled{{end}}></div>
  {{end}}{{end}}
  {{range $s.Fields}}{{if eq .Group "lists"}}
  <div role="group" class="set-row border-t"><label for="{{.ID}}">{{.Label}}{{if .Pinned}} <span class="badge" data-variant="outline">Pinned</span>{{end}}</label><input id="{{.ID}}" name="{{.Key}}" type="{{.Type}}" class="input sm:w-80" value="{{.Value}}" autocomplete="off"{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Required}} required{{end}}{{if .Disabled}} disabled{{end}}></div>
  {{end}}{{end}}
  <details class="border-t"{{if $s.Open}} open{{end}}>
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between px-4 text-ink-2">Advanced{{icon "chevron-down" "size-4"}}</summary>
    <div class="flex flex-col">
      {{range $s.Fields}}{{if eq .Group "advanced"}}
      <div role="group" class="set-row border-t"><label for="{{.ID}}">{{.Label}}{{if .Pinned}} <span class="badge" data-variant="outline">Pinned</span>{{end}}</label><input id="{{.ID}}" name="{{.Key}}" type="{{.Type}}" class="input sm:w-80" value="{{.Value}}" autocomplete="off"{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Required}} required{{end}}{{if .Disabled}} disabled{{end}}></div>
      {{end}}{{end}}
    </div>
  </details>
  <footer><button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "log-in"}}Test sign-in</button></footer>
</form>
