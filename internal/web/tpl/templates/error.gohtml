{{define "title"}}{{if eq .Data.status 422}}Filter not understood{{else}}Not found{{end}}{{end}}
{{define "heading"}}{{if eq .Data.status 422}}Filter not understood{{else}}Not found{{end}}{{end}}
{{define "content"}}
{{if eq .Data.status 422}}
{{template "empty_state" (dict "icon_name" "circle-alert" "title" "atrium cannot show this" "body" (printf "%s Pick the filter again from the page." .Data.problem))}}
<a href="{{safeurl .Data.path}}" class="btn self-start" data-size="sm" data-variant="outline">{{icon "arrow-left"}}Clear filters</a>
{{else}}
{{template "empty_state" (dict "icon_name" "search" "title" "Nothing here" "body" "This page, message or rule does not exist, or it is no longer indexed.")}}
<a href="/chat" class="btn self-start" data-size="sm" data-variant="outline">{{icon "arrow-left"}}Chat</a>
{{end}}
{{end}}
