{{define "settings_tabs"}}{{$tab := .}}{{$on := global "module_enabled"}}
<nav aria-label="Settings sections" class="-mb-2 flex flex-wrap gap-x-1 border-b text-sm">
  {{range (list (list "assistant" "Assistant" "/settings/assistant" "assistant") (list "skills" "Skills" "/settings/skills" "assistant") (list "subagents" "Subagents" "/settings/subagents" "assistant") (list "prompts" "Prompts" "/settings/prompts" "assistant") (list "notifications" "Notifications" "/settings/notifications" "notifications") (list "usage" "Usage" "/settings/usage" "assistant") (list "auth" "Sign-in" "/settings/auth" "auth"))}}
  {{if call $on (index . 3)}}<a href="{{index . 2}}" class="-mb-px whitespace-nowrap border-b-2 px-3 py-2 font-medium {{if eq $tab (index . 0)}}border-primary text-foreground{{else}}border-transparent text-muted-foreground hover:text-foreground{{end}}"{{if eq $tab (index . 0)}} aria-current="page"{{end}}>{{index . 1}}</a>{{end}}
  {{end}}
</nav>
{{end}}
