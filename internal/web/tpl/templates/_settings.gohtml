{{define "settings_tabs"}}{{$tab := .Tab}}
<nav aria-label="Settings sections" class="-mb-2 flex flex-wrap gap-x-1 border-b text-sm">
  {{range .Settings}}<a href="{{.URL}}" class="-mb-px whitespace-nowrap border-b-2 px-3 py-2 font-medium {{if eq $tab .Page}}border-primary text-foreground{{else}}border-transparent text-muted-foreground hover:text-foreground{{end}}"{{if eq $tab .Page}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}
</nav>
{{end}}
