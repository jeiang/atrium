{{define "settings_connections"}}{{$csrf := .CSRF}}{{$back := .Path}}{{with .Connections}}{{$v := .}}{{range .Sections}}
<section class="set-group" data-section="{{.Name}}">
  {{template "integration_section" (dict "Section" . "CSRF" $csrf "Error" $v.Error "FieldError" $v.FieldError "Back" $back "Saved" $v.Saved)}}
</section>
{{end}}{{end}}{{end}}

{{define "integration_section"}}{{$s := .Section}}
{{if and .Error (not .FieldError)}}<p class="px-4 py-2 text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.Error}}</p>{{end}}
<h2><span>{{$s.Title}}</span>{{if eq (opt . "Saved" "") $s.Name}}<span class="text-xs font-normal text-ink-3" role="status" data-saved>Saved</span>{{end}}</h2>
{{if $s.Template}}{{partial $s.Template (dict "Section" $s "Fields" $s.Fields "Action" (printf "/settings/sections/%s" $s.Name) "CSRF" .CSRF "Error" .Error "FieldError" .FieldError "Back" (opt . "Back" ""))}}
{{else}}{{template "settings_fields" (dict "Fields" $s.Fields "Action" (printf "/settings/sections/%s" $s.Name) "CSRF" .CSRF "Back" (opt . "Back" ""))}}{{end}}
{{end}}
