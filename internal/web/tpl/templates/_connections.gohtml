{{define "integration_card"}}{{$v := .View}}{{$r := .Record}}{{$name := $r.Name}}{{$csrf := .CSRF}}{{$back := .Back}}{{with $r}}
  <div class="flex flex-col gap-3 rounded-lg border bg-card p-4 text-sm" data-integration="{{$r.Name}}" data-state="{{$r.State}}">
    {{if and (eq $v.Failed .Name) $v.Error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{$v.Error}}</p>{{end}}
    <form method="post" action="/settings/integrations/{{$r.Name}}/test" class="flex flex-col gap-3" autocomplete="off">
      <input type="hidden" name="csrf_token" value="{{$csrf}}">{{with $back}}<input type="hidden" name="back" value="{{.}}">{{end}}
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-medium"{{with .Help}} title="{{.}}"{{end}}>{{.Label}}</span>
        <span class="badge" data-variant="{{if eq .State "ok"}}secondary{{else if eq .State "untested"}}outline{{else}}destructive{{end}}">{{replace "_" " " .State}}</span>
        <span class="text-xs text-muted-foreground">{{.Module}}</span>
        {{with .CheckedAt}}<span class="text-xs text-muted-foreground">{{ts .}}</span>{{end}}
      </div>
      {{with .Reason}}<p class="text-xs text-muted-foreground">{{.}}</p>{{end}}
      {{if eq $v.HoldFor .Name}}{{template "module_hold" $v.Hold}}{{end}}
      {{if eq $v.Saved .Name}}<p class="text-xs text-ink-3" role="status" data-saved>Saved</p>{{end}}
      <div class="grid gap-3 sm:grid-cols-2">
        {{if .URLKey}}
        <div role="group" class="field">
          <label for="url-{{$r.Name}}">URL</label>
          {{if .URLPinned}}<code id="url-{{$r.Name}}" class="break-all font-mono text-xs" data-pinned>{{.URL}}</code>{{else}}<input id="url-{{$r.Name}}" name="url" type="url" value="{{.URL}}"{{with .Help}} title="{{.}}"{{end}}>{{end}}
        </div>
        {{end}}
        {{if .SecretKey}}
        <div role="group" class="field">
          <label for="secret-{{$r.Name}}">Credential</label>
          {{if .SecretPinned}}<span id="secret-{{$r.Name}}" class="text-xs text-muted-foreground" data-pinned>set by deployment</span>{{else}}<input id="secret-{{$r.Name}}" name="secret" type="password" autocomplete="new-password" placeholder="{{if .SecretSet}}set; type to replace{{end}}"{{with .Help}} title="{{.}}"{{end}}>{{end}}
        </div>
        {{end}}
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "check"}}Test</button>
        {{if and (not .URLPinned) (not .SecretPinned) (or .URL .SecretSet)}}<button type="submit" class="btn" data-size="sm" data-variant="destructive" formaction="/settings/integrations/{{$r.Name}}/disconnect" formnovalidate data-confirm-submit="Disconnect {{.Label}}? Its {{.Module}} module needs settings again; its data stays.">{{icon "x"}}Disconnect</button>{{end}}
      </div>
    </form>
    {{if .Fields}}
    {{template "settings_fields" (dict "Fields" .Fields "Action" (printf "/settings/integrations/%s/settings" .Name) "CSRF" $csrf "Back" $back)}}
    {{end}}
    {{range $v.Sections}}{{if eq .Integration $name}}
    <div class="flex flex-col gap-3 border-t pt-3" data-section="{{.Name}}">
      {{template "integration_section" (dict "Section" . "CSRF" $csrf "Failed" $v.Failed "Error" $v.Error "FieldError" $v.FieldError "Back" $back)}}
    </div>
    {{end}}{{end}}
  </div>
{{end}}{{end}}

{{define "settings_connections"}}{{$csrf := .CSRF}}{{$back := .Path}}{{with .Connections}}{{$v := .}}{{range .Records}}{{template "integration_card" (dict "View" $v "Record" . "CSRF" $csrf "Back" $back)}}{{end}}
{{range .Sections}}{{if not .Integration}}
<div class="flex flex-col gap-3 rounded-lg border bg-card p-4 text-sm" data-section="{{.Name}}">
  {{template "integration_section" (dict "Section" . "CSRF" $csrf "Failed" $v.Failed "Error" $v.Error "FieldError" $v.FieldError "Back" $back "Saved" $v.Saved)}}
</div>
{{end}}{{end}}{{end}}{{end}}

{{define "integration_section"}}{{$s := .Section}}
{{if and (eq .Failed $s.Name) .Error (not .FieldError)}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.Error}}</p>{{end}}
<span class="font-medium">{{$s.Title}}</span>{{if eq (opt . "Saved" "") $s.Name}} <span class="text-xs text-ink-3" role="status" data-saved>Saved</span>{{end}}
{{if $s.Template}}{{partial $s.Template (dict "Section" $s "Fields" $s.Fields "Action" (printf "/settings/integrations/sections/%s" $s.Name) "CSRF" .CSRF "Error" .Error "FieldError" .FieldError "Back" (opt . "Back" ""))}}
{{else}}{{template "settings_fields" (dict "Fields" $s.Fields "Action" (printf "/settings/integrations/sections/%s" $s.Name) "CSRF" .CSRF "Back" (opt . "Back" ""))}}{{end}}
{{end}}

{{define "module_hold"}}{{if eq .Result "enabled"}}<p class="text-xs text-muted-foreground" role="status" data-module-hold="enabled">{{.Module}} module turned on; restart the atrium units to start it.</p>{{else if eq .Result "pinned"}}<p class="text-xs text-warning" role="status" data-module-hold="pinned">{{.Module}} module stays off: pinned by {{.Detail}}.</p>{{else if eq .Result "needs-settings"}}<p class="text-xs text-warning" role="status" data-module-hold="needs-settings">{{.Module}} module stays off: {{.Detail}}.</p>{{end}}{{end}}
