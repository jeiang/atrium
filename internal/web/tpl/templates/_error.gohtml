{{if eq .Data.Status 422}}
<p class="text-sm text-muted-foreground" role="alert">{{.Data.Problem}} Pick the filter again.</p>
{{if .Toast}}{{template "_toast.gohtml" .}}{{end}}
{{else if .Data.AdminOnly}}
<p class="text-sm text-muted-foreground" role="alert">Admins only.</p>
{{if .Toast}}{{template "_toast.gohtml" .}}{{end}}
{{else}}
<p class="text-sm text-muted-foreground" role="alert">Nothing here: this message or rule does not exist, or it is no longer indexed.</p>
{{end}}
