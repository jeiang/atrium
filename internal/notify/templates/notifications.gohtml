{{define "title"}}Notifications · Settings{{end}}
{{define "heading"}}Settings · Notifications{{end}}
{{define "content"}}{{$d := .Data}}{{$csrf := .CSRF}}
{{template "settings_tabs" (dict "Tab" "notifications" "Auth" .Auth "Settings" .Settings)}}
{{with $d.Error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.}}</p>{{end}}
{{if $d.NtfySh}}<p class="flex items-start gap-2 rounded-lg border border-warning/30 bg-warning/10 p-3 text-sm text-warning" data-ntfy-sh>{{icon "circle-alert"}}<span>On ntfy.sh anyone who knows a topic name can read it unless the topic is reserved. Treat each topic as a secret.</span></p>{{end}}

<section class="flex flex-col gap-3" aria-labelledby="push-h" data-push data-push-key="{{$d.Push.Key}}">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 id="push-h" class="text-sm font-medium">Push</h2>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn" data-size="sm" data-action="push-enable" hidden>{{icon "bell"}}Enable push on this device</button>
      <button type="button" class="btn" data-size="sm" data-variant="outline" data-action="push-disable" hidden>{{icon "bell-off"}}Disable push on this device</button>
      {{if $d.Push.Devices}}<form method="post" action="/settings/notifications/push/test"><input type="hidden" name="csrf_token" value="{{$csrf}}"><button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "send"}}Send test</button></form>{{end}}
    </div>
  </div>
  {{if not $d.Push.Subject}}<p class="flex items-start gap-2 rounded-lg border border-warning/30 bg-warning/10 p-3 text-sm text-warning" data-push-subject>{{icon "circle-alert"}}<span><a class="underline underline-offset-4" href="/settings/config/notify">webpush_subject</a> is not set.</span></p>{{end}}
  {{with $d.Push.Problem}}<p class="text-sm text-destructive" role="alert">{{.}}</p>{{end}}
  <form method="post" action="/settings/notifications/push/subscriptions" data-push-form="subscribe" hidden>
    <input type="hidden" name="csrf_token" value="{{$csrf}}"><input type="hidden" name="endpoint"><input type="hidden" name="p256dh"><input type="hidden" name="auth">
  </form>
  <form method="post" action="/settings/notifications/push/unsubscribe" data-push-form="unsubscribe" hidden>
    <input type="hidden" name="csrf_token" value="{{$csrf}}"><input type="hidden" name="endpoint">
  </form>
  {{if $d.Push.Devices}}
  <ul class="flex flex-col divide-y rounded-lg border bg-card text-sm">
    {{range $d.Push.Devices}}
    <li class="flex flex-wrap items-center gap-2 px-4 py-2" data-push-device="{{.Endpoint}}">
      <span class="font-medium">{{.Label}}</span>
      <span class="text-xs text-muted-foreground">{{ts .CreatedTS}}</span>
      {{if ge .Failures 3}}<span class="badge" data-variant="destructive">failing</span>{{else if .LastOKTS}}<span class="badge" data-variant="secondary">ok</span>{{end}}
      {{with .LastError}}<span class="text-xs text-muted-foreground">{{str .}}</span>{{end}}
      <form method="post" action="/settings/notifications/push/{{.ID}}/remove" class="ms-auto"><input type="hidden" name="csrf_token" value="{{$csrf}}"><button type="submit" class="btn" data-size="icon-sm" data-variant="ghost" aria-label="Remove {{.Label}}">{{icon "trash-2"}}</button></form>
    </li>
    {{end}}
  </ul>
  {{end}}
</section>

<section class="flex flex-col gap-3" aria-labelledby="channels-h">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 id="channels-h" class="text-sm font-medium">Channels</h2>
    {{if $d.URL}}<form method="post" action="/settings/notifications/probe"><input type="hidden" name="csrf_token" value="{{$csrf}}"><button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "lock"}}Check privacy</button></form>{{end}}
  </div>
  <div class="grid gap-3 md:grid-cols-3">
    {{range $d.Channels}}
    <div class="flex flex-col gap-2 rounded-lg border bg-card p-4 text-sm" data-channel="{{.Name}}">
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-medium capitalize">{{.Name}}</span>
        <span class="badge" data-variant="{{if eq .Privacy "private"}}secondary{{else}}outline{{end}}">{{.Privacy}}</span>
        {{if ge .Failures 3}}<span class="badge" data-variant="destructive">failing</span>{{else if .LastOKAt}}<span class="badge" data-variant="secondary">ok</span>{{end}}
        {{if .Token}}<span class="badge" data-variant="outline">token</span>{{end}}
      </div>
      <code class="break-all font-mono text-xs">{{if .Subscribe}}{{.Subscribe}}{{else}}{{.Topic}}{{end}}</code>
      <p class="text-xs text-muted-foreground">{{if .ShowsText}}Full text{{else}}Titles hidden{{end}}{{with .LastError}} · {{str .}}{{end}}</p>
      <form method="post" action="/settings/notifications/channels/{{.Name}}/content" class="flex items-end gap-2">
        <input type="hidden" name="csrf_token" value="{{$csrf}}">
        <label class="sr-only" for="content-{{.Name}}">Content</label>
        <select id="content-{{.Name}}" name="content" class="text-xs">
          {{$c := .Content}}{{range (list "auto" "full" "title")}}<option value="{{.}}"{{if eq . $c}} selected{{end}}>{{.}}</option>{{end}}
        </select>
        <button type="submit" class="btn" data-size="sm" data-variant="outline">Save</button>
      </form>
      <div class="flex flex-wrap gap-2">
        <form method="post" action="/settings/notifications/channels/{{.Name}}/test"><input type="hidden" name="csrf_token" value="{{$csrf}}"><button type="submit" class="btn" data-size="sm">{{icon "send"}}Test</button></form>
        <form method="post" action="/settings/notifications/channels/{{.Name}}/reset"><input type="hidden" name="csrf_token" value="{{$csrf}}"><button type="submit" class="btn" data-size="sm" data-variant="destructive" data-confirm-submit="Reset the {{.Name}} channel? Its token is revoked and it gets a new topic; subscribers must resubscribe.">{{icon "trash-2"}}Reset</button></form>
      </div>
    </div>
    {{end}}
  </div>
</section>

{{if $d.URL}}
<form method="post" action="/settings/notifications/account" class="flex max-w-xl flex-col gap-3 rounded-lg border p-4" autocomplete="off">
  <input type="hidden" name="csrf_token" value="{{$csrf}}">
  <h2 class="text-sm font-medium">ntfy account</h2>
  <div class="grid gap-3 sm:grid-cols-2">
    <div role="group" class="field"><label for="ntfy-user">Username</label><input id="ntfy-user" name="username" type="text" required></div>
    <div role="group" class="field"><label for="ntfy-password">Password</label><input id="ntfy-password" name="password" type="password" autocomplete="new-password" required></div>
  </div>
  <button type="submit" class="btn self-start" data-size="sm"{{if not $d.Encrypted}} disabled title="Encrypt the database first"{{end}}>{{icon "link"}}Connect</button>
</form>
{{end}}

{{if $d.Notifications}}
<div class="table-container rounded-lg border bg-card">
  <table class="table">
    <caption class="sr-only">Notifications, newest first</caption>
    <thead><tr><th scope="col">When</th><th scope="col">Notification</th><th scope="col">Channel</th><th scope="col">Thread</th><th scope="col">Push</th></tr></thead>
    <tbody>
      {{range $d.Notifications}}
      <tr>
        <td class="whitespace-nowrap text-muted-foreground">{{ts .TS}}</td>
        <td><span class="font-medium">{{.Title}}</span><br><span class="whitespace-pre-line text-muted-foreground">{{.Body}}</span></td>
        <td class="capitalize">{{or .Channel "assistant"}}</td>
        <td>{{if .ThreadLink}}<a class="underline underline-offset-4" href="{{str .ThreadLink}}">open</a>{{end}}</td>
        <td>{{if .Delivered}}<span class="badge" data-variant="secondary">Sent</span>{{else}}<form method="post" action="/settings/notifications/{{.ID}}/resend" class="flex items-center gap-2"><input type="hidden" name="csrf_token" value="{{$csrf}}"><span class="badge" data-variant="outline" title="{{or (str .Error) ""}}">Local only</span><button type="submit" class="btn" data-size="sm" data-variant="ghost">Resend</button></form>{{end}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
</div>
{{else}}
{{template "empty_state" (dict "icon_name" "inbox" "title" "No notifications" "body" "Notifications the assistant sends appear here, even when push is not configured.")}}
{{end}}
{{end}}
