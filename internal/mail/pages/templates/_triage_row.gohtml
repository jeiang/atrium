{{define "mail_triage_row"}}{{$r := .r}}{{$mode := .mode}}{{$correct := opt . "correct" nil}}{{$focus := opt . "focus_row" false -}}
<li id="decision-{{$r.MessageID}}" class="group/row grid gap-x-4 gap-y-2 px-4 py-3 lg:grid-cols-[minmax(0,1fr)_--spacing(64)_--spacing(48)_auto] lg:items-center">
  <div class="flex min-w-0 flex-col gap-0.5">
    <a class="truncate text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm" {{template "open_attrs" $r.MessageID}}{{if $focus}} autofocus{{end}}>{{or $r.Subject "(no subject)"}}</a>
    <p class="truncate text-xs text-muted-foreground">{{sender $r}} · {{template "when" (dict "epoch" $r.DateTS)}} · {{$r.Account}}{{if $r.More}} · <a class="underline underline-offset-4" href="/triage?q={{$r.FromAddr}}" data-more>{{$r.More}} more from this sender</a>{{end}}</p>
  </div>
  <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm">
    <span class="sr-only">Now in</span>
    <span class="max-w-full truncate text-muted-foreground">{{place $r.Current}}</span>
    {{icon "arrow-right" "size-3.5 shrink-0 text-muted-foreground"}}
    <span class="sr-only">proposed</span>
    <span class="max-w-full truncate font-medium">{{proposal $r.Action $r.Dest}}</span>
    {{if $r.Applied}}{{template "action_badge" $r.Applied}}{{else if ne $r.Stage "correction"}}<span class="text-xs">{{template "agreement" $r.Agreement}}</span>{{end}}
    {{if and $r.CorrectedTo (ne $r.Stage "correction")}}
    <span class="badge" data-variant="secondary">Corrected to {{str $r.CorrectedTo}}</span>
    {{end}}
  </div>
  <div class="flex min-w-0 flex-wrap items-center gap-2">
    {{template "stage_badge" $r.Stage}}
    {{if and (not (isnil $r.Key)) $r.Key (ne $r.Stage "knn") (ne $r.Stage "llm") (ne $r.Stage "correction")}}<code class="truncate font-mono text-xs text-muted-foreground">{{str $r.Key}}</code>{{end}}
    {{if and (not (isnil $r.Confidence)) (ne $r.Stage "correction")}}<span class="text-xs text-muted-foreground tabular-nums"><span class="sr-only">confidence </span>{{pct $r.Confidence}}</span>{{end}}
  </div>
  <div class="flex gap-1 group-has-[form]/row:invisible max-lg:group-has-[form]/row:hidden lg:w-18 lg:justify-end">
    {{if and $r.Applied $r.Applied.Undoable}}
    <button type="button" class="btn transition-colors" data-size="sm" data-variant="ghost" title="Undo"
            hx-post="/live/actions/{{$r.Applied.ID}}/undo" hx-target="#decision-{{$r.MessageID}}" hx-swap="outerHTML" hx-disabled-elt="this"
            hx-confirm="Undo this and put the message back?">
      {{icon "undo-2"}}<span class="lg:sr-only">Undo</span>
    </button>
    {{end}}
    <button type="button" class="btn transition-colors" data-size="sm" data-variant="ghost" title="Correct"
            hx-get="/messages/{{$r.MessageID}}/correct?context=row" hx-target="#correct-slot-row-{{$r.MessageID}}" hx-swap="innerHTML">
      {{icon "folder-input"}}<span class="lg:sr-only">Correct</span>
    </button>
    <a class="btn transition-colors" data-size="sm" data-variant="ghost" title="Make rule" href="/rules/new?message={{$r.MessageID}}">
      {{icon "list-plus"}}<span class="lg:sr-only">Make rule</span>
    </a>
  </div>
  <div id="correct-slot-row-{{$r.MessageID}}" class="empty:hidden lg:col-span-4">{{if $correct}}{{template "mail_correct" (dict "c" $correct "mode" $mode)}}{{end}}</div>
</li>
{{end}}
{{template "mail_triage_row" (dict "r" .Data.Row "mode" .Mode "focus_row" false "correct" (.Data.Correct))}}
{{if .Toast}}{{template "_toast.gohtml" .}}{{end}}
