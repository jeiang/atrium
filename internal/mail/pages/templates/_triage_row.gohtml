{{define "mail_triage_row"}}{{$r := .r}}{{$mode := .mode}}{{$correct := opt . "correct" nil}}{{$focus := opt . "focus_row" false -}}
<li id="decision-{{$r.message_id}}" class="group/row grid gap-x-4 gap-y-2 px-4 py-3 lg:grid-cols-[minmax(0,1fr)_--spacing(64)_--spacing(48)_auto] lg:items-center">
  <div class="flex min-w-0 flex-col gap-0.5">
    <a class="truncate text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm" {{template "open_attrs" $r.message_id}}{{if $focus}} autofocus{{end}}>{{or $r.subject "(no subject)"}}</a>
    <p class="truncate text-xs text-muted-foreground">{{sender $r}} · {{template "when" (dict "epoch" $r.date_ts)}} · {{$r.account}}</p>
  </div>
  <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm">
    <span class="sr-only">Now in</span>
    <span class="max-w-full truncate text-muted-foreground">{{place $r.current}}</span>
    {{icon "arrow-right" "size-3.5 shrink-0 text-muted-foreground"}}
    <span class="sr-only">proposed</span>
    <span class="max-w-full truncate font-medium">{{proposal $r.action $r.dest}}</span>
    {{if $r.applied}}{{template "action_badge" $r.applied}}{{else if ne $r.stage "correction"}}<span class="text-xs">{{template "agreement" $r.agreement}}</span>{{end}}
    {{if and $r.corrected_to (ne $r.stage "correction")}}
    <span class="badge" data-variant="secondary">Corrected to {{$r.corrected_to}}</span>
    {{end}}
  </div>
  <div class="flex min-w-0 flex-wrap items-center gap-2">
    {{template "stage_badge" $r.stage}}
    {{if and (not (isnil $r.key)) $r.key (ne $r.stage "knn") (ne $r.stage "llm") (ne $r.stage "correction")}}<code class="truncate font-mono text-xs text-muted-foreground">{{$r.key}}</code>{{end}}
    {{if and (not (isnil $r.confidence)) (ne $r.stage "correction")}}<span class="text-xs text-muted-foreground tabular-nums"><span class="sr-only">confidence </span>{{pct $r.confidence}}</span>{{end}}
  </div>
  <div class="flex gap-1 group-has-[form]/row:invisible max-lg:group-has-[form]/row:hidden lg:w-18 lg:justify-end">
    {{if and $r.applied $r.applied.undoable}}
    <button type="button" class="btn transition-colors" data-size="sm" data-variant="ghost" title="Undo"
            hx-post="/live/actions/{{$r.applied.id}}/undo" hx-target="#decision-{{$r.message_id}}" hx-swap="outerHTML" hx-disabled-elt="this"
            hx-confirm="Undo this and put the message back?">
      {{icon "undo-2"}}<span class="lg:sr-only">Undo</span>
    </button>
    {{end}}
    <button type="button" class="btn transition-colors" data-size="sm" data-variant="ghost" title="Correct"
            hx-get="/messages/{{$r.message_id}}/correct?context=row" hx-target="#correct-slot-row-{{$r.message_id}}" hx-swap="innerHTML">
      {{icon "folder-input"}}<span class="lg:sr-only">Correct</span>
    </button>
    <a class="btn transition-colors" data-size="sm" data-variant="ghost" title="Make rule" href="/rules/new?message={{$r.message_id}}">
      {{icon "list-plus"}}<span class="lg:sr-only">Make rule</span>
    </a>
  </div>
  <div id="correct-slot-row-{{$r.message_id}}" class="empty:hidden lg:col-span-4">{{if $correct}}{{template "mail_correct" (dict "c" $correct "mode" $mode)}}{{end}}</div>
</li>
{{end}}
{{template "mail_triage_row" (dict "r" .Data.row "mode" .Mode "focus_row" (opt .Data "focus_row" false) "correct" (opt .Data "correct" nil))}}
{{if .Toast}}{{template "_toast.gohtml" .}}{{end}}
