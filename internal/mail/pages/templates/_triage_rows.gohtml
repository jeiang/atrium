{{define "mail_triage_rows"}}{{$rows := .rows}}{{$offset := .offset}}{{$mode := .mode -}}
{{range $i, $row := $rows}}
{{template "mail_triage_row" (dict "r" $row "mode" $mode "focus_row" (and $offset (eq $i 0)))}}
{{else}}
{{if not $offset}}
<li class="flex flex-col items-center gap-2 px-4 py-10 text-center">
  <span class="grid size-8 place-items-center rounded-lg bg-muted">{{icon "route"}}</span>
  <p class="text-sm font-medium">No decisions match</p>
  <p class="max-w-sm text-sm text-muted-foreground">{{if or .stage .agreement .q}}Clear a filter to see the rest.{{else}}atrium decides on mail that has been read and is still in the inbox. Check back after the next sync.{{end}}</p>
</li>
{{end}}
{{end}}
{{if .next_offset}}
<li id="load-more" class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
  <span class="text-xs text-muted-foreground tabular-nums">Showing {{.next_offset}} of {{.total}}</span>
  <button type="button" class="btn" data-size="sm" data-variant="outline"
          hx-get="/triage?{{urlencode (odict "account" .account "stage" .stage "agreement" .agreement "q" .q "offset" .next_offset)}}"
          hx-target="closest li" hx-swap="outerHTML" hx-push-url="false">
    Show older decisions
  </button>
</li>
{{end}}
{{end}}
{{template "mail_triage_rows" (dict "rows" .Data.rows "offset" .Data.offset "mode" .Mode "stage" .Data.stage "agreement" .Data.agreement "q" .Data.q "next_offset" .Data.next_offset "total" .Data.total "account" .Data.account)}}
