{{define "title"}}{{if .Data.IsNew}}New rule{{else}}Edit {{.Data.Rule.ID}}{{end}}{{end}}
{{define "heading"}}{{if .Data.IsNew}}New rule{{else}}Edit rule{{end}}{{end}}
{{define "content"}}
<a href="/rules{{if str .Data.Rule.Account}}?account={{queryval (str .Data.Rule.Account)}}{{end}}" class="btn self-start" data-size="sm" data-variant="ghost">{{icon "arrow-left"}}Rules</a>
{{if .Data.SourceMessage}}
<p class="text-sm text-muted-foreground">
  Prefilled from <a class="font-medium text-foreground underline underline-offset-4" {{template "open_attrs" .Data.SourceMessage.ID}}>{{or .Data.SourceMessage.Subject "(no subject)"}}</a>
  · {{.Data.SourceMessage.FromAddr}}
</p>
{{end}}
<div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_--spacing(96)]">
  {{template "mail_rule_form" (dict "rule" .Data.Rule "is_new" .Data.IsNew "folders" .Data.Folders "suggestions" (.Data.Suggestions) "errors" (.Data.Errors) "csrf" .CSRF)}}
  <section class="flex flex-col gap-3 lg:sticky lg:top-20" aria-labelledby="preview-title">
    <header class="flex items-center gap-2">
      <h2 id="preview-title" class="text-sm font-medium">Preview</h2>
      {{template "spinner" (dict "id" "preview-spinner" "label" "Updating preview")}}
      <button type="button" class="btn ml-auto" data-size="sm" data-variant="ghost"
              hx-post="/rules/preview" hx-include="#rule-form" hx-target="#preview" hx-indicator="#preview-spinner">Refresh</button>
    </header>
    <div id="preview" class="flex flex-col gap-3" aria-live="polite"
      hx-post="/rules/preview" hx-include="#rule-form" hx-sync="this:replace" hx-indicator="#preview-spinner"
      hx-trigger="load, change from:#rule-form delay:300ms, input from:#rule-form delay:600ms">
      <p class="text-sm text-muted-foreground">Counting matching messages…</p>
    </div>
  </section>
</div>
{{end}}
