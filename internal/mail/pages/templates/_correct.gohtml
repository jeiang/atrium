{{define "mail_correct"}}{{$c := .c}}{{$mode := .mode}}{{$uid := printf "%v-%v" $c.Context $c.MessageID -}}
<form class="flex flex-col gap-3 rounded-md border border-dashed bg-background p-3"
      hx-post="/messages/{{$c.MessageID}}/correct"
      hx-target="#{{if eq $c.Context "row"}}decision-{{else}}decision-card-{{end}}{{$c.MessageID}}"
      hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]">
  <input type="hidden" name="context" value="{{$c.Context}}">
  <div role="group" class="field"{{if $c.Error}} data-invalid{{end}}>
    <label for="dest-{{$uid}}">Where should this go?</label>
    <select id="dest-{{$uid}}" name="dest" class="w-full sm:max-w-xs" required autofocus{{if $c.Error}} aria-invalid="true" aria-describedby="dest-error-{{$uid}}"{{end}}>
      <option value=""{{if not $c.Selected}} selected{{end}} disabled>Choose a {{noun $c.Account}}</option>
      {{template "folder_options" (dict "folders" $c.Folders "selected" $c.Selected)}}
    </select>
    {{if $c.Error}}<p id="dest-error-{{$uid}}" role="alert">{{$c.Error}}</p>{{end}}
  </div>
  <p class="flex gap-2 text-xs text-muted-foreground">
    {{icon (ternary (ne $mode "live") "eye-off" "zap") "mt-0.5 size-3.5 shrink-0"}}
    {{if eq $mode "live" -}}
    Records the correction and moves the message to this {{noun $c.Account}}.
    {{- else -}}
    Shadow mode: records the correction for the router, learned rules and kNN. The message stays where it is.
    {{- end}}
  </p>
  <div class="flex flex-wrap gap-2">
    <button type="submit" class="btn" data-size="sm">{{icon "check"}}Record correction</button>
    <button type="button" class="btn" data-size="sm" data-variant="ghost"
            data-action="cancel-correct">Cancel</button>
  </div>
</form>
{{end}}
{{template "mail_correct" (dict "c" .Data.Correct "mode" .Mode)}}
