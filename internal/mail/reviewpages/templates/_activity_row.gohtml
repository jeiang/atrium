{{define "activity_row"}}{{$e := .e}}{{with .toast}}{{template "_toast.gohtml" (dict "Toast" .)}}{{end}}
<li id="activity-{{$e.source}}-{{$e.id}}" class="flex flex-col gap-2 px-4 py-3">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <div class="flex items-center gap-2 whitespace-nowrap text-xs text-muted-foreground sm:w-48 sm:shrink-0">
      <span class="badge" data-variant="secondary">{{$e.category}}</span>
      <span class="tabular-nums">{{template "when" (dict "epoch" $e.ts "style" "datetime")}}</span>
    </div>
    {{if eq $e.source "mail"}}
    <div class="flex min-w-0 flex-1 basis-64 flex-col gap-0.5">
      <a class="truncate rounded-sm text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" {{template "open_attrs" $e.message_id}}>{{or $e.subject "(no subject)"}}</a>
      <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
        <span class="badge" data-variant="outline">{{$e.kind}}</span>
        <span class="truncate">{{or $e.from_name $e.from_addr}} · {{$e.account}}</span>
        {{if ne $e.kind "flag"}}
        <span class="max-w-full truncate">{{place $e.src}}</span>
        {{icon "arrow-right" "size-3.5 shrink-0"}}
        <span class="max-w-full truncate font-medium text-foreground">{{place $e.dest}}</span>
        {{end}}
        {{template "action_badge" $e}}
        {{if $e.error}}<span class="truncate" title="{{$e.error}}">{{$e.error}}</span>{{end}}
      </div>
    </div>
    {{else}}
    <div class="flex min-w-0 flex-1 basis-64 flex-col gap-0.5">
      <div class="flex min-w-0 flex-wrap items-center gap-2">
        <span class="badge" data-variant="outline">{{$e.tool}}</span>
        <span class="truncate font-mono text-xs">{{$e.target}}</span>
      </div>
      <p class="text-xs text-muted-foreground">
        {{if $e.thread_id}}by <a class="underline underline-offset-4" href="/chat/{{$e.thread_id}}">{{or $e.thread_kind "thread"}} thread</a>{{else}}by atrium{{end}}
      </p>
    </div>
    {{end}}
    <div class="flex sm:ms-auto">
      {{if and (eq $e.source "write") $e.undone_at}}
      <span class="badge" data-variant="outline">Undone {{template "when" (dict "epoch" $e.undone_at "style" "datetime")}}</span>
      {{else if $e.undoable}}
      <button type="button" class="btn" data-size="sm" data-variant="outline" title="Undo"
              hx-post="/activity/{{$e.source}}/{{$e.id}}/undo" hx-target="#activity-{{$e.source}}-{{$e.id}}" hx-swap="outerHTML" hx-disabled-elt="this"
              hx-confirm="{{if eq $e.source "mail"}}Undo this and put the message back?{{else}}Undo this change?{{end}}">{{icon "undo-2"}}Undo</button>
      {{end}}
    </div>
  </div>
  {{if and (eq $e.source "write") (or $e.before $e.after)}}
  <details class="text-xs">
    <summary class="cursor-pointer text-muted-foreground">Before and after</summary>
    <div class="mt-2 grid gap-2 md:grid-cols-2">
      <pre class="overflow-auto whitespace-pre-wrap rounded-md bg-muted p-2" aria-label="Before">{{or $e.before "(nothing)"}}</pre>
      <pre class="overflow-auto whitespace-pre-wrap rounded-md bg-muted p-2" aria-label="After">{{or $e.after "(nothing)"}}</pre>
    </div>
  </details>
  {{end}}
</li>{{end}}

{{template "activity_row" (dict "e" .Data.e "toast" .Toast)}}
