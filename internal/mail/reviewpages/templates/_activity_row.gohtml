{{define "activity_row"}}{{$e := .e}}{{with .toast}}{{template "_toast.gohtml" (dict "Toast" .)}}{{end}}
<li id="activity-{{$e.source}}-{{$e.id}}" class="flex flex-col gap-2 px-4 py-3">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <div class="flex items-center gap-2 whitespace-nowrap text-xs text-muted-foreground sm:w-48 sm:shrink-0">
      <span class="badge" data-variant="secondary">{{$e.category}}</span>
      <span class="tabular-nums">{{template "when" (dict "epoch" $e.ts "style" "datetime")}}</span>
    </div>
    {{with $e.mail}}
    <div class="flex min-w-0 flex-1 basis-64 flex-col gap-0.5">
      <a class="truncate rounded-sm text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" {{template "open_attrs" .message_id}}>{{or .subject "(no subject)"}}</a>
      <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
        <span class="badge" data-variant="outline">{{.kind}}</span>
        <span class="truncate">{{or .from_name .from_addr}} · {{.account}}</span>
        {{if ne .kind "flag"}}
        <span class="max-w-full truncate">{{place .src}}</span>
        {{icon "arrow-right" "size-3.5 shrink-0"}}
        <span class="max-w-full truncate font-medium text-foreground">{{place .dest}}</span>
        {{end}}
        {{template "action_badge" .}}
        {{if .error}}<span class="truncate" title="{{.error}}">{{.error}}</span>{{end}}
      </div>
    </div>
    {{end}}
    {{with $e.settings}}
    <div class="flex min-w-0 flex-1 basis-64 flex-col gap-0.5">
      <div class="flex min-w-0 flex-wrap items-center gap-2">
        <span class="badge" data-variant="outline">{{.tool}}</span>
        {{if .thread_id}}<span class="text-xs text-muted-foreground">thread {{.thread_id}}</span>{{end}}
      </div>
      <p class="text-xs text-muted-foreground">by {{.actor}} via {{.origin}}</p>
    </div>
    {{end}}
    {{with $e.write}}
    <div class="flex min-w-0 flex-1 basis-64 flex-col gap-0.5">
      <div class="flex min-w-0 flex-wrap items-center gap-2">
        <span class="badge" data-variant="outline">{{.tool}}</span>
        <span class="truncate font-mono text-xs">{{.target}}</span>
      </div>
      <p class="text-xs text-muted-foreground">
        {{if .thread_id}}by <a class="underline underline-offset-4" href="/chat/{{.thread_id}}">{{or .thread_kind "thread"}} thread</a>{{else}}by atrium{{end}}
      </p>
      {{if .error}}<p class="max-w-full truncate text-xs text-muted-foreground" title="{{.error}}">{{.error}}</p>{{end}}
    </div>
    {{end}}
    <div class="flex sm:ms-auto">
      {{with $e.write}}
      {{if .undone_at}}
      <span class="badge" data-variant="outline">Undone {{template "when" (dict "epoch" .undone_at "style" "datetime")}}</span>
      {{else if eq .state "unknown"}}
      <div class="flex flex-col gap-1">
        <p class="max-w-xs text-xs text-muted-foreground">The write has an unknown outcome. Check the calendar, then resolve it. atrium does not touch the calendar.</p>
        <button type="button" class="btn" data-size="sm" data-variant="outline"
                hx-post="/activity/write/{{$e.id}}/resolve" hx-target="#activity-{{$e.source}}-{{$e.id}}" hx-swap="outerHTML" hx-disabled-elt="this"
                hx-confirm="Mark this write resolved?">Resolve</button>
      </div>
      {{else if eq .state "resolved"}}
      <span class="badge" data-variant="outline">Resolved</span>
      {{else if .undoable}}
      <button type="button" class="btn" data-size="sm" data-variant="outline" title="Undo"
              hx-post="/activity/write/{{$e.id}}/undo" hx-target="#activity-{{$e.source}}-{{$e.id}}" hx-swap="outerHTML" hx-disabled-elt="this"
              hx-confirm="Undo this change?">{{icon "undo-2"}}Undo</button>
      {{end}}
      {{end}}
      {{with $e.mail}}
      {{if .blocked}}
      <div class="flex flex-col gap-1">
        <p class="max-w-xs text-xs text-muted-foreground">{{if .undo_blocked}}The undo has an unknown or partial outcome.{{else}}The write has an unknown or interrupted outcome.{{end}} Check the mailbox, then record what you found. atrium does not touch the mailbox.</p>
        {{template "resolve_controls" (dict "path" (printf "/activity/mail/%v/resolve" $e.id) "target" (printf "#activity-%v-%v" $e.source $e.id) "undo" .undo_blocked "forward" (and .blocked (not .undo_blocked)))}}
      </div>
      {{else if .undoable}}
      <button type="button" class="btn" data-size="sm" data-variant="outline" title="Undo"
              hx-post="/activity/mail/{{$e.id}}/undo" hx-target="#activity-{{$e.source}}-{{$e.id}}" hx-swap="outerHTML" hx-disabled-elt="this"
              hx-confirm="Undo this and put the message back?">{{icon "undo-2"}}Undo</button>
      {{end}}
      {{end}}
    </div>
  </div>
  {{with $e.write}}{{if or .before .after}}
  <details class="text-xs">
    <summary class="cursor-pointer text-muted-foreground">Before and after</summary>
    <div class="mt-2 grid gap-2 md:grid-cols-2">
      <pre class="overflow-auto whitespace-pre-wrap rounded-md bg-muted p-2" aria-label="Before">{{or .before "(nothing)"}}</pre>
      <pre class="overflow-auto whitespace-pre-wrap rounded-md bg-muted p-2" aria-label="After">{{or .after "(nothing)"}}</pre>
    </div>
  </details>
  {{end}}{{end}}
  {{with $e.settings}}{{if or .before .after}}
  <details class="text-xs">
    <summary class="cursor-pointer text-muted-foreground">Before and after</summary>
    <div class="mt-2 grid gap-2 md:grid-cols-2">
      <pre class="overflow-auto whitespace-pre-wrap rounded-md bg-muted p-2" aria-label="Before">{{or .before "(nothing)"}}</pre>
      <pre class="overflow-auto whitespace-pre-wrap rounded-md bg-muted p-2" aria-label="After">{{or .after "(nothing)"}}</pre>
    </div>
  </details>
  {{end}}{{end}}
</li>{{end}}

{{template "activity_row" (dict "e" .Data.e "toast" .Toast)}}
