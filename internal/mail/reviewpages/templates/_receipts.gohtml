{{with .Data.Entries}}
<section class="flex flex-col gap-3" aria-labelledby="receipts-h" data-receipts>
  <div class="flex items-center gap-2">
    <h2 id="receipts-h" class="eyebrow">Done for you</h2>
    <a href="/activity" class="ms-auto text-xs text-ink-3 underline-offset-4 hover:text-ink hover:underline">View all</a>
  </div>
  <ul class="receipts" role="list">
    {{range .}}{{template "receipt" (dict "e" . "toast" nil)}}{{end}}
  </ul>
</section>
{{end}}

{{define "receipt"}}{{$e := .e}}{{with .toast}}{{template "_toast.gohtml" (dict "Toast" .)}}{{end}}
<li id="receipt-{{$e.Source}}-{{$e.ID}}" class="receipt"{{with $e.Write}}{{if .UndoneAt}} data-state="undone"{{end}}{{end}}{{with $e.Mail}}{{if eq .State "undone"}} data-state="undone"{{end}}{{end}}>
  {{icon "check"}}
  {{with $e.Write}}
  <span class="receipt-body"><span class="receipt-text" title="{{.Tool}} {{.Target}}">{{$e.Summary}}</span>{{template "when" (dict "epoch" $e.TS "style" "datetime")}}</span>
  {{if and .Undoable (not .UndoneAt) (ne .State "unknown") (ne .State "resolved")}}
  <button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post="/activity/{{$e.Source}}/{{$e.ID}}/undo" hx-vals='{"view":"receipt"}' hx-target="#receipt-{{$e.Source}}-{{$e.ID}}" hx-swap="outerHTML" hx-disabled-elt="this" hx-confirm="Undo this change?">{{icon "undo-2"}}Undo</button>
  {{end}}
  {{end}}
  {{with $e.Mail}}
  <span class="receipt-body"><span class="receipt-text">{{$e.Summary}}</span>{{template "when" (dict "epoch" $e.TS "style" "datetime")}}</span>
  {{if and .Undoable (not .Blocked)}}
  <button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post="/activity/mail/{{$e.ID}}/undo" hx-vals='{"view":"receipt"}' hx-target="#receipt-{{$e.Source}}-{{$e.ID}}" hx-swap="outerHTML" hx-disabled-elt="this" hx-confirm="Undo this and put the message back?">{{icon "undo-2"}}Undo</button>
  {{end}}
  {{end}}
</li>
{{- end}}
