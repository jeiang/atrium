{{define "title"}}Packages{{end}}
{{define "heading"}}Packages{{end}}
{{define "content"}}{{$d := .Data}}{{$csrf := .CSRF}}
<p class="text-sm text-muted-foreground">Read from your mail by a local model. Dates and statuses can be wrong or stale; open the source mail to check. Nothing here pays, cancels or contacts anyone.</p>

<section class="flex flex-col gap-3" aria-labelledby="packages-h">
  <h2 id="packages-h" class="text-sm font-medium">Packages in transit ({{len $d.Packages}})</h2>
  {{if $d.Packages}}
  <ul class="flex flex-col gap-3" role="list" aria-label="Packages">
    {{range $d.Packages}}
    <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-card p-4">
      <div class="flex min-w-0 flex-col gap-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm font-medium">{{or .Merchant .Carrier "Package"}}</span>
          <span class="badge" data-variant="secondary">{{replace "_" " " .Status}}</span>
          {{if .Carrier}}<span class="badge" data-variant="outline">{{.Carrier}}</span>{{end}}
          {{if .TrackerID}}<span class="badge" data-variant="outline">Ship24</span>{{end}}
        </div>
        <p class="text-xs text-muted-foreground">
          {{if .TrackingNumber}}<span class="font-mono">{{.TrackingNumber}}</span> · {{end}}
          {{if .OrderRef}}order {{.OrderRef}} · {{end}}
          {{.StatusText}} · <span class="tabular-nums">{{.Updated}}</span> ·
          <a class="underline" href="/messages/{{.LastMessageID}}">latest mail</a>
        </p>
        {{if .LastEvent}}<p class="text-xs text-muted-foreground">{{.LastEvent}}{{if .LastEventDescription}} · {{.LastEventDescription}}{{end}}{{if .LastSync}} · {{.LastSync}}{{end}}</p>{{end}}
      </div>
      <form method="post" action="/watches/packages/{{.ID}}/dismiss">
        <input type="hidden" name="csrf_token" value="{{$csrf}}">
        <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "x"}}Dismiss</button>
      </form>
    </li>
    {{end}}
  </ul>
  {{else}}
  {{template "empty_state" (dict "icon_name" "package" "title" "No packages in transit" "body" "Status only changes when a later shipping email arrives.")}}
  {{end}}
</section>
{{end}}
