{{$d := .Data}}{{$csrf := .CSRF}}{{$mode := .Mode}}{{if or $d.Proposals $d.Blocked $d.Drafts}}
<section class="flex flex-col gap-3" aria-labelledby="needs-strip-h" data-needs-strip>
  <div class="flex items-center gap-2">
    <h2 id="needs-strip-h" class="eyebrow">Needs you</h2>
    <span class="count">{{$d.Count}}</span>
    {{if $d.More}}<a href="/review" class="ms-auto text-xs text-ink-3 underline-offset-4 hover:text-ink hover:underline" data-needs-all>View all</a>{{end}}
  </div>
  <ul class="flex flex-col gap-3" role="list">
    {{range $d.Proposals}}{{template "proposal_card" (dict "p" . "mode" $mode "toast" nil "pending_oob" false "pending_count" 0)}}{{end}}
    {{range $d.Blocked}}{{template "proposal_card" (dict "p" . "mode" $mode "toast" nil "pending_oob" false "pending_count" 0)}}{{end}}
    {{range $d.Drafts}}{{template "draft_card" (dict "d" . "configured" $d.Configured "csrf" $csrf "partial" false "toast" nil)}}{{end}}
  </ul>
</section>
{{end}}
