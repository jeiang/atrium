{{define "phone_actions"}}{{$d := .Phone}}{{$csrf := .CSRF}}
<section id="phone-actions" class="flex flex-col gap-3" aria-labelledby="phone-actions-h" data-phone-actions>
  <h2 id="phone-actions-h" class="text-sm font-medium">Phone actions</h2>
  <form method="post" action="/settings/phone-actions" class="flex flex-col gap-4 rounded-lg border bg-card p-4">
    <input type="hidden" name="csrf_token" value="{{$csrf}}">
    <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="enabled" value="1"{{if $d.Enabled}} checked{{end}}> Allow proposal actions from phone notifications</label>
    <fieldset class="flex flex-col gap-2">
      <legend class="text-sm font-medium">Allowed proposal kinds</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        {{range $d.Kinds}}
        <label class="flex items-center gap-2 rounded-lg border p-2 text-sm">
          <input type="checkbox" name="kind" value="{{.Name}}"{{if .On}} checked{{end}}{{if .WebOnly}} disabled{{end}}>
          <span>{{.Name}}</span>
          {{if .WebOnly}}<span class="badge" data-variant="secondary">{{icon "lock"}}web only</span>{{end}}
        </label>
        {{end}}
      </div>
    </fieldset>
    <div><button type="submit" class="btn" data-size="sm">Save</button></div>
  </form>
  <div class="flex flex-wrap items-center gap-3 text-sm">
    <span data-phone-outstanding>{{$d.Outstanding}} outstanding link{{if ne $d.Outstanding 1}}s{{end}}</span>
    <form method="post" action="/settings/phone-actions/revoke" data-confirm-submit="Revoke every outstanding phone action link?">
      <input type="hidden" name="csrf_token" value="{{$csrf}}">
      <button type="submit" class="btn" data-size="sm" data-variant="destructive" title="Rotates the signing key">{{icon "trash-2"}}Revoke all</button>
    </form>
  </div>
</section>
{{end}}
