{{define "phone_actions"}}{{$d := .Phone}}{{$csrf := .CSRF}}
<section id="phone-actions" class="set-group" aria-labelledby="phone-actions-h" data-phone-actions>
  <h2 id="phone-actions-h"><span>Phone actions</span><span class="ms-auto text-xs font-normal text-ink-3" data-phone-outstanding>{{$d.Outstanding}} outstanding link{{if ne $d.Outstanding 1}}s{{end}}</span></h2>
  <form method="post" action="/settings/phone-actions">
    <input type="hidden" name="csrf_token" value="{{$csrf}}">
    <div role="group" class="set-row"><label for="phone-enabled">Allow proposal actions from phone notifications</label><input id="phone-enabled" type="checkbox" role="switch" class="input" name="enabled" value="1"{{if $d.Enabled}} checked{{end}}></div>
    <fieldset class="flex flex-col gap-2 border-t px-4 py-3">
      <legend class="sr-only">Allowed proposal kinds</legend>
      <div class="grid gap-x-6 gap-y-2 sm:grid-cols-2">
        {{range $d.Kinds}}
        <label class="flex items-center gap-2 text-sm{{if .WebOnly}} text-ink-3{{end}}">
          <input type="checkbox" class="input" name="kind" value="{{.Name}}"{{if .On}} checked{{end}}{{if .WebOnly}} disabled{{end}}>
          <span class="font-mono text-xs">{{.Name}}</span>
          {{if .WebOnly}}<span class="inline-flex items-center gap-1 text-xs">{{icon "lock" "size-3"}}web only</span>{{end}}
        </label>
        {{end}}
      </div>
    </fieldset>
    <footer>
      <button type="submit" form="phone-revoke" class="btn text-danger" data-size="sm" data-variant="ghost" title="Rotates the signing key">Revoke all links</button>
      <button type="submit" class="btn" data-size="sm" data-variant="outline">Save</button>
    </footer>
  </form>
  <form id="phone-revoke" method="post" action="/settings/phone-actions/revoke" data-confirm-submit="Revoke every outstanding phone action link?">
    <input type="hidden" name="csrf_token" value="{{$csrf}}">
  </form>
</section>
{{end}}
