{{if .Data.error}}
<p class="text-sm text-muted-foreground" role="status">{{.Data.error}}</p>
{{else if not (isnil .Data.releases)}}
<div class="flex flex-col gap-2" role="status" aria-live="polite">
  <p class="text-xs text-muted-foreground">{{.Data.matched}} of {{len .Data.releases}} current EZTV releases match.</p>
  {{if .Data.releases}}
  <ul class="flex max-h-80 flex-col divide-y overflow-y-auto rounded-lg border text-xs" role="list" aria-label="EZTV releases">
    {{range .Data.releases}}
    <li class="flex items-center gap-2 px-3 py-1.5 {{if .match}}bg-success/10{{else}}text-muted-foreground{{end}}" data-match="{{if .match}}yes{{else}}no{{end}}">
      {{if .match}}{{icon "check" "size-3.5 shrink-0"}}{{else}}{{icon "x" "size-3.5 shrink-0"}}{{end}}
      <span class="min-w-0 flex-1 break-all font-mono">{{.title}}</span>
      {{if .size_bytes}}<span class="tabular-nums">{{printf "%.1f" (fdiv .size_bytes 1e9)}} GB</span>{{end}}
    </li>
    {{end}}
  </ul>
  {{else}}
  <p class="text-xs text-muted-foreground">EZTV lists nothing for this show.</p>
  {{end}}
</div>
{{end}}
