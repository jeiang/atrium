{{define "title"}}{{.Data.Show.Title}}{{end}}
{{define "heading"}}Media · {{.Data.Show.Title}}{{if .Data.Show.Year}} ({{.Data.Show.Year}}){{end}}{{end}}
{{define "content"}}{{$ttl := .Data.TTL}}{{$dir := .Data.Show.Dir}}
<p class="text-xs"><a class="underline underline-offset-4" href="/apps/media/library">{{icon "arrow-left" "inline size-3.5"}} Library</a></p>
<div class="flex items-start gap-4">
  <img class="aspect-[2/3] w-32 shrink-0 rounded-lg border bg-muted object-cover" src="/apps/media/art/show/{{urlencode $dir}}" alt="">
  <p class="text-sm text-muted-foreground">{{len .Data.Show.Seasons}} season{{if ne (len .Data.Show.Seasons) 1}}s{{end}}</p>
</div>
{{range $i, $s := .Data.Show.Seasons}}{{$n := inc $i}}
<section class="flex flex-col gap-3" aria-labelledby="season-{{$n}}">
  <div class="flex items-center gap-3">
    {{if not (isnil $s.Number)}}<img class="aspect-[2/3] w-12 rounded-md border bg-muted object-cover" src="/apps/media/art/season/{{urlencode $dir}}/{{$s.Number}}" alt="">{{end}}
    <h2 id="season-{{$n}}" class="text-sm font-medium">{{$s.Dir}} <span class="text-muted-foreground">({{len $s.Episodes}})</span></h2>
  </div>
  <ul class="flex flex-col gap-3" role="list" aria-label="{{$s.Dir}} episodes">
    {{range $s.Episodes}}
    <li class="flex flex-col gap-3 rounded-lg border bg-card p-3 sm:flex-row sm:items-center">
      <img class="aspect-video w-full rounded-md bg-muted object-cover sm:w-40" src="/apps/media/thumb/{{urlencode .Rel}}" alt="" loading="lazy">
      <div class="flex min-w-0 flex-1 flex-col gap-2">
        <span class="text-sm font-medium">{{if not (isnil .Episode)}}Episode {{.Episode}}{{else}}{{.Name}}{{end}}</span>
        <span class="break-all font-mono text-xs text-muted-foreground">{{.Name}} · {{printf "%.1f" (fdiv .Size 1e9)}} GB</span>
        {{template "media_file_links" (dict "f" . "ttl" $ttl)}}
      </div>
    </li>
    {{else}}
    <li class="text-sm text-muted-foreground">No episodes in this folder.</li>
    {{end}}
  </ul>
</section>
{{template "tmdb_attribution"}}
{{end}}
{{end}}
