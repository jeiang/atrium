{{define "media_torrents"}}<div id="torrents" class="flex flex-col gap-3"{{if .Active}} hx-get="/apps/media/torrents" hx-trigger="load delay:{{.Poll}}s" hx-swap="outerHTML"{{end}}>
  {{if .Error}}
  <p class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive" role="alert">{{.Error}}</p>
  {{end}}
  {{if .Torrents}}
  <ul class="flex flex-col gap-3" role="list" aria-label="Torrents">
    {{range .Torrents}}
    <li class="flex flex-col gap-2 rounded-lg border bg-card p-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="min-w-0 flex-1 truncate text-sm font-medium" title="{{.Name}}">{{.Name}}</span>
        <span class="badge" data-variant="{{if eq .Kind "media"}}secondary{{else}}outline{{end}}">{{.Kind}}</span>
        {{if .Filed}}<span class="badge border-success/30 bg-success/10 text-success">filed</span>{{end}}
        {{if .Ignored}}<span class="badge" data-variant="ghost">ignored</span>{{end}}
        <span class="badge" data-variant="outline">{{.Label}}</span>
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted" role="progressbar" aria-valuenow="{{.Percent}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{.Percent}}%">
        <div class="h-full bg-primary" style="width: {{.Percent}}%"></div>
      </div>
      <p class="flex flex-wrap gap-x-3 text-xs text-muted-foreground tabular-nums">
        <span>{{.Percent}}%</span><span>{{.Size}}</span>
        {{if .Down}}<span>↓ {{.Down}}</span>{{end}}
        {{if .Up}}<span>↑ {{.Up}}</span>{{end}}
        {{if .ETA}}<span>ETA {{.ETA}}</span>{{end}}
      </p>
      <div>
        <button type="button" class="btn" data-size="sm" data-variant="outline" hx-get="/apps/media/torrents/{{.Hash}}/files" hx-target="#torrent-files" hx-swap="innerHTML show:top">{{icon "list-checks"}}Files</button>
      </div>
    </li>
    {{end}}
  </ul>
  {{else if not .Error}}
  {{template "empty_state" (dict "icon_name" "download" "title" "No torrents")}}
  {{end}}
</div>
{{end}}
{{template "media_torrents" .Data}}
