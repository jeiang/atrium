{{define "title"}}Add torrent{{end}}
{{define "heading"}}Media · Add torrent{{end}}
{{define "content"}}
<p class="text-sm text-muted-foreground">Paste a magnet link or choose a .torrent file. The zakkart shim opens this page prefilled. Media torrents get their video and subtitle files selected automatically and are filed into the library once complete.</p>
<form id="add-torrent" method="post" action="/media/add" class="flex flex-col gap-4 rounded-lg border bg-card p-4" data-torrent-form>
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  <input type="hidden" name="torrent" value="">
  <input type="hidden" name="name" value="{{.Data.torrent_name}}">
  <div role="group" class="field">
    <label for="magnet">Magnet link</label>
    <input id="magnet" name="magnet" type="text" value="{{.Data.magnet}}" class="font-mono" placeholder="magnet:?xt=urn:btih:…" spellcheck="false" autocomplete="off">
  </div>
  <div role="group" class="field">
    <label for="torrent-file">or .torrent file</label>
    <input id="torrent-file" type="file" accept=".torrent,application/x-bittorrent" data-torrent-file>
    <p id="torrent-chosen" class="text-xs text-muted-foreground" data-torrent-chosen>{{if .Data.torrent_name}}{{.Data.torrent_name}} (from the shim){{end}}</p>
  </div>
  <fieldset class="flex flex-col gap-2">
    <legend class="text-sm font-medium">What is it?</legend>
    <label class="flex items-start gap-2 text-sm"><input type="radio" name="mode" value="media"{{if eq .Data.add_mode "media"}} checked{{end}}><span><strong>Media</strong> (file into library): tagged <code class="font-mono">media</code>, selected and filed from Downloads.</span></label>
    <label class="flex items-start gap-2 text-sm"><input type="radio" name="mode" value="plain"{{if eq .Data.add_mode "plain"}} checked{{end}}><span><strong>Plain torrent</strong>: normal flow, served from downloads/ on the VPN.</span></label>
  </fieldset>
  {{if .Data.error}}<p class="text-sm text-destructive" role="alert">{{.Data.error}}</p>{{end}}
  <div><button type="submit" class="btn">{{icon "plus"}}Add</button></div>
</form>
{{end}}
