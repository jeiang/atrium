{{define "title"}}Add torrent{{end}}
{{define "heading"}}Media · Add torrent{{end}}
{{define "content"}}
<form id="add-torrent" method="post" action="/apps/media/add" class="flex flex-col gap-4 rounded-lg border bg-card p-4" data-torrent-form>
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  <input type="hidden" name="torrent" value="">
  <input type="hidden" name="name" value="{{.Data.TorrentName}}">
  <div role="group" class="field">
    <label for="magnet">Magnet link</label>
    <input id="magnet" name="magnet" type="text" value="{{.Data.Magnet}}" class="font-mono" placeholder="magnet:?xt=urn:btih:…" spellcheck="false" autocomplete="off">
  </div>
  <div role="group" class="field">
    <label for="torrent-file">or .torrent file</label>
    <input id="torrent-file" type="file" accept=".torrent,application/x-bittorrent" data-torrent-file>
    <p id="torrent-chosen" class="text-xs text-muted-foreground" data-torrent-chosen>{{if .Data.TorrentName}}{{.Data.TorrentName}} (from the shim){{end}}</p>
  </div>
  <fieldset class="flex flex-col gap-2">
    <legend class="text-sm font-medium">What is it?</legend>
    <label class="flex items-start gap-2 text-sm" title="Tagged media; video and subtitle files are selected and filed into the library when complete"><input type="radio" name="mode" value="media"{{if eq .Data.AddMode "media"}} checked{{end}}><span>Media</span></label>
    <label class="flex items-start gap-2 text-sm" title="Stays in downloads/, served on the VPN"><input type="radio" name="mode" value="plain"{{if eq .Data.AddMode "plain"}} checked{{end}}><span>Plain torrent</span></label>
  </fieldset>
  {{if .Data.Error}}<p class="text-sm text-destructive" role="alert">{{.Data.Error}}</p>{{end}}
  <div><button type="submit" class="btn">{{icon "plus"}}Add</button></div>
</form>
{{end}}
