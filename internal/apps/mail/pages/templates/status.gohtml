{{define "title"}}Mail status{{end}}
{{define "heading"}}Mail status{{end}}
{{define "content"}}{{$v := .Data}}{{$s := $v.Status}}{{$csrf := .CSRF}}
<div class="flex flex-col gap-4">
  {{with $v.Confirm}}
  <section class="card" data-variant="destructive" aria-labelledby="confirm-title" id="confirm">
    <header><h2 id="confirm-title">{{if eq .Action "go_live"}}Go live?{{else}}Retake the baseline?{{end}}</h2></header>
    <section class="flex flex-col gap-2 text-sm">
      <p data-testid="confirm-statement">{{.Statement}}</p>
      <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1">
        <dt class="text-muted-foreground">Accounts</dt><dd>{{range $i, $a := .Accounts}}{{if $i}}, {{end}}{{$a}}{{end}}</dd>
        <dt class="text-muted-foreground">Write cap</dt><dd class="tabular-nums">{{.WriteCap}} per account per pass</dd>
        <dt class="text-muted-foreground">Baseline</dt><dd class="tabular-nums">about {{.Baseline}} messages</dd>
      </dl>
      <p>{{.Pause}} <a href="#pause-control">Pause</a></p>
    </section>
    <footer class="flex gap-2">
      <a class="btn" data-variant="outline" href="/live" autofocus>Cancel</a>
      <form method="post" action="/live/{{if eq .Action "go_live"}}go-live{{else}}rebaseline{{end}}">
        <input type="hidden" name="csrf_token" value="{{$csrf}}">
        <input type="hidden" name="confirm_token" value="{{.Token}}">
        <button type="submit" class="btn" data-variant="destructive">{{if eq .Action "go_live"}}Go live{{else}}Retake baseline{{end}}</button>
      </form>
    </footer>
  </section>
  {{end}}
  <section class="card" aria-labelledby="mode-title">
    <header><h2 id="mode-title">Mode</h2></header>
    <section class="flex flex-col gap-2 text-sm">
      <p>Mail mode is <strong data-testid="mail-mode">{{$s.Mode}}</strong>{{if $s.Paused}}, and automatic writes are paused{{end}}. <a href="#pause-control">Pause</a></p>
      {{if $s.WatchClosely.Active}}<p data-testid="watch-closely">Watch closely: the mode changed to {{with $s.WatchClosely.Mode}}{{.}}{{end}} on {{ts $v.WatchSince}}; this lasts until {{ts $v.WatchUntil}}.</p>{{end}}
      {{if $s.Eligible}}
      <form method="post" action="/live/confirm">
        <input type="hidden" name="csrf_token" value="{{$csrf}}">
        <input type="hidden" name="action" value="go_live">
        <button type="submit" class="btn" data-variant="outline">Go live…</button>
      </form>
      {{else}}
      <p>Go-live is not available:</p>
      <ul class="list-disc pl-5" data-testid="unmet">{{range $v.UnmetLabels}}<li>{{.}}</li>{{end}}</ul>
      {{end}}
    </section>
  </section>
  <section class="card" aria-labelledby="baseline-title">
    <header><h2 id="baseline-title">Baseline</h2></header>
    <section class="flex flex-col gap-2 text-sm">
      <p><span class="tabular-nums" data-testid="baseline-count">{{$s.Baseline.Messages}}</span> messages{{if $v.BaselineAt}}, taken {{ts $v.BaselineAt}}{{else}}; not taken yet{{end}}.</p>
      <form method="post" action="/live/confirm">
        <input type="hidden" name="csrf_token" value="{{$csrf}}">
        <input type="hidden" name="action" value="rebaseline">
        <button type="submit" class="btn" data-variant="outline">Retake baseline…</button>
      </form>
    </section>
  </section>
  <section class="card" aria-labelledby="shadow-title">
    <header><h2 id="shadow-title">Automatic actions</h2></header>
    <section class="flex flex-col gap-2 text-sm">
      {{if $s.Shadow.Actions}}
      <ul class="flex flex-col gap-1">{{range $kind, $states := $s.Shadow.Actions}}<li>{{$kind}}: {{range $state, $n := $states}}<span class="tabular-nums">{{$n}}</span> {{$state}} {{end}}</li>{{end}}</ul>
      {{else}}<p class="text-muted-foreground">No automatic actions recorded.</p>{{end}}
      <p><a href="/api/v1/mail/shadow-report">Full shadow report</a></p>
    </section>
  </section>
  <section class="card" aria-labelledby="replay-title">
    <header><h2 id="replay-title">Replay</h2></header>
    <section class="flex flex-col gap-2 text-sm">
      {{with $s.Replay}}<p data-testid="replay-summary">Run {{.RunID}} on {{ts $v.ReplayAt}}: <span class="tabular-nums">{{.Messages}}</span> messages, <span class="tabular-nums">{{.Differ}}</span> differ.</p>{{else}}<p class="text-muted-foreground">No replay run yet.</p>{{end}}
      <form method="post" action="/live/replay">
        <input type="hidden" name="csrf_token" value="{{$csrf}}">
        <button type="submit" class="btn" data-variant="outline">Run replay</button>
      </form>
    </section>
  </section>
  <section class="card" aria-labelledby="deletions-title">
    <header><h2 id="deletions-title">Deletions</h2></header>
    <section class="flex flex-col gap-2 text-sm">
      <p><span class="tabular-nums" data-testid="deletions-pending">{{$s.Deletions.PendingProposals}}</span> deletion rule proposals wait for review. <a href="/review">Review</a></p>
    </section>
  </section>
</div>
{{end}}
