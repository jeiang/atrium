{{template "notion_action" .Data}}

{{define "notion_action"}}
{{if opt . "error" ""}}
<div class="alert" data-variant="destructive" role="alert">
  {{icon "circle-alert"}}
  <h3>Nothing changed</h3>
  <section><p>{{.Error}}</p></section>
</div>
{{else}}
<div class="alert" role="status">
  {{icon "check"}}
  <h3>{{.Done}}</h3>
  <section>
    {{with .Detail}}<p>{{.}}</p>{{end}}
    <p><a class="font-medium text-foreground underline underline-offset-4" href="/activity?category=wiki">Undo in Done</a></p>
  </section>
</div>
{{end}}
{{- end}}
