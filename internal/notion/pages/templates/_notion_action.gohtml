{{template "notion_action" .Data}}

{{define "notion_action"}}
{{if opt . "error" ""}}
<div class="alert" data-variant="destructive" role="alert">
  {{icon "circle-alert"}}
  <h3>No proposal</h3>
  <section><p>{{.Error}}</p></section>
</div>
{{else}}
<div class="alert" role="status">
  {{icon "check"}}
  <h3>{{lbl "kind" .Created.Kind}} proposed</h3>
  <section>
    <p>{{.Created.Title}}</p>
    <p><a class="font-medium text-foreground underline underline-offset-4" href="/proposals?kind={{.Created.Kind}}#proposal-{{.Created.ID}}">Review proposal #{{.Created.ID}}</a>. Nothing changes in Notion until you approve it.</p>
  </section>
</div>
{{end}}
{{- end}}
