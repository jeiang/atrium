{{template "library_wiki_rows" (dict "pages" .Data.Pages "q" .Data.Q)}}

{{define "library_wiki_rows"}}
{{if .pages}}
<ul class="rows" role="list" aria-label="Wiki pages">
  {{range .pages}}
  <li class="row">
    <span class="row-main">
      <a class="row-title" href="/notion/{{urlencode .ID}}">{{or .Title "Untitled"}}</a>
      {{if or .Path .Private}}<span class="row-meta">{{if .Path}}{{page_path .Path}}{{end}}{{if and .Path .Private}} · {{end}}{{if .Private}}private{{end}}</span>{{end}}
    </span>
    <span class="row-when">{{template "when" (dict "epoch" .EditedTS "style" "date")}}</span>
  </li>
  {{end}}
</ul>
{{else if .q}}
{{template "empty_state" (dict "icon_name" "search" "title" "No matching pages")}}
{{else}}
{{template "empty_state" (dict "icon_name" "book-open" "title" "No wiki pages yet")}}
{{end}}
{{- end}}
