{{define "title"}}Skills · Settings{{end}}
{{define "heading"}}Settings · Skills{{end}}
{{define "body_attrs"}}{{if .Data.strip_params}} data-strip-params="saved,deleted,created,updated,unchanged"{{end}}{{end}}

{{define "skills_refs"}}{{range $i, $r := .}}{{if $i}}, {{end}}<code class="font-mono">{{$r}}</code>{{end}}{{end}}

{{define "content"}}{{$d := .Data}}{{$csrf := .CSRF}}
{{template "settings_tabs" "skills"}}
<p class="text-sm text-muted-foreground">Markdown playbooks the assistant can load by name. Only the name and one-line description are in every conversation; the body is read on demand. A skill may reference another as <code class="font-mono">/skill:name</code> or <code class="font-mono">[[skill:name]]</code>; the same tokens in a chat message or schedule prompt expand the skill into the message before the run. The assistant cannot edit skills.</p>

<div class="flex flex-wrap items-end justify-between gap-2 text-sm">
<form method="get" action="/settings/skills" class="flex items-end gap-2 text-sm">
  <label class="flex min-w-0 flex-1 flex-col gap-1 text-xs sm:max-w-sm">Search<input class="input w-full" type="search" name="q" value="{{$d.q}}" placeholder="name, description or body"></label>
  <button type="submit" class="btn" data-size="sm">{{icon "search"}}Find</button>
</form>
  <div class="flex flex-wrap items-end gap-2">
    <a class="btn" data-variant="outline" data-size="sm" href="/settings/skills/export" download>{{icon "download"}}Export</a>
    <form method="post" action="/settings/skills/import" enctype="multipart/form-data" hx-post="/settings/skills/import" hx-encoding="multipart/form-data" hx-swap="none" hx-disabled-elt="find button[type=submit]" class="flex items-end gap-2">
      <label class="sr-only" for="import-file">SKILL.md or zip</label>
      <input id="import-file" class="input" type="file" name="upload" accept=".md,.zip" required>
      <button type="submit" class="btn" data-variant="outline" data-size="sm">{{icon "upload"}}Import</button>
    </form>
  </div>
</div>

{{if $d.skills}}
<div class="flex flex-col gap-4">
  {{range $d.skills}}
  <details class="rounded-lg border bg-card p-4" data-skill="{{.name}}"{{if or (eq $d.editing .name) (eq $d.focus .name)}} open{{end}}>
    <summary class="flex cursor-pointer flex-col items-start gap-1 text-sm"{{if eq $d.focus .name}} autofocus{{end}}>
      <span class="flex flex-wrap items-center gap-2">
        <span class="font-mono font-medium">{{.name}}</span>
        {{if .cut}}<span class="badge border-warning/30 bg-warning/10 text-warning">{{icon "eye-off"}}Not indexed</span>{{end}}
        {{if .references.unknown}}<span class="badge" data-variant="destructive" title="References skills that do not exist: {{join ", " .references.unknown}}">{{icon "circle-alert"}}unknown reference</span>{{end}}
      </span>
      <span class="line-clamp-2 max-w-full break-words text-muted-foreground">{{.description}}</span>
    </summary>
    <dl class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-xs text-muted-foreground">
      <div class="flex gap-2"><dt>References</dt><dd>{{if .references.known}}{{template "skills_refs" .references.known}}{{else}}none{{end}}</dd></div>
      {{if .references.unknown}}<div class="flex gap-2 text-destructive"><dt>Unknown</dt><dd>{{template "skills_refs" .references.unknown}}</dd></div>{{end}}
      <div class="flex gap-2"><dt>Referenced by</dt><dd>{{if .referenced_by}}{{template "skills_refs" .referenced_by}}{{else}}none{{end}}</dd></div>
    </dl>
    <form method="post" action="/settings/skills" class="mt-3 flex flex-col gap-3">
      <input type="hidden" name="csrf_token" value="{{$csrf}}">
      <input type="hidden" name="name" value="{{.name}}">
      <input type="hidden" name="from" value="edit">
      {{if and (eq $d.editing .name) $d.error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{$d.error}}</p>{{end}}
      <div role="group" class="field"><label for="d-{{.name}}">Description</label><input id="d-{{.name}}" name="description" type="text" value="{{if eq $d.editing .name}}{{$d.draft.description}}{{else}}{{.description}}{{end}}" maxlength="160"></div>
      <div role="group" class="field"><label for="b-{{.name}}">Body</label><textarea id="b-{{.name}}" name="body" rows="10" class="w-full font-mono text-xs">{{if eq $d.editing .name}}{{$d.draft.body}}{{else}}{{.body}}{{end}}</textarea></div>
      <div class="flex gap-2">
        <button type="submit" class="btn" data-size="sm">{{icon "check"}}Save</button>
        <button type="submit" class="btn" data-size="sm" data-variant="destructive" formaction="/settings/skills/{{.name}}/delete" data-confirm-submit="Delete the skill “{{.name}}”?{{if .referenced_by}} {{join ", " .referenced_by}} reference{{if eq (len .referenced_by) 1}}s{{end}} it and will show an unknown reference.{{end}} This cannot be undone.">{{icon "trash-2"}}Delete</button>
      </div>
    </form>
  </details>
  {{end}}
</div>
{{else}}
{{if $d.q}}{{template "empty_state" (dict "icon_name" "search" "title" "No skills match" "body" (printf "Nothing matches \"%s\"." $d.q))}}{{else}}{{template "empty_state" (dict "icon_name" "scroll-text" "title" "No skills yet" "body" "Add a playbook below.")}}{{end}}
{{end}}

<form method="post" action="/settings/skills" class="flex flex-col gap-3 rounded-lg border p-4">
  <input type="hidden" name="csrf_token" value="{{$csrf}}">
  <h2 class="text-sm font-medium">New skill</h2>
  {{if and (not $d.editing) $d.error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{$d.error}}</p>{{end}}
  <div class="grid gap-3 sm:grid-cols-2">
    <div role="group" class="field"><label for="new-name">Name</label><input id="new-name" name="name" type="text" value="{{if not $d.editing}}{{$d.draft.name}}{{end}}" class="font-mono" placeholder="weekly-review" required></div>
    <div role="group" class="field"><label for="new-description">One-line description</label><input id="new-description" name="description" type="text" value="{{if not $d.editing}}{{$d.draft.description}}{{end}}" maxlength="160" required></div>
  </div>
  <div role="group" class="field"><label for="new-body">Body (Markdown)</label><textarea id="new-body" name="body" rows="8" class="w-full font-mono text-xs" required>{{if not $d.editing}}{{$d.draft.body}}{{end}}</textarea></div>
  <button type="submit" class="btn self-start" data-size="sm">{{icon "plus"}}Save skill</button>
</form>
{{end}}
