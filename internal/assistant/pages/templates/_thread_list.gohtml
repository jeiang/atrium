{{$d := .Data}}{{template "chat_thread_list" (dict "threads" $d.threads "q" $d.q "view" $d.view "project_id" $d.project_id)}}

{{define "chat_thread_list"}}{{$project_id := .project_id}}
{{if .threads}}
{{$pinned := selattr "pinned" .threads}}{{$rest := rejattr "pinned" .threads}}
{{if eq .view "archived"}}
{{template "chat_thread_group" (dict "title" "Archived" "items" .threads "project_id" $project_id)}}
{{else}}
{{if $pinned}}{{template "chat_thread_group" (dict "title" "Pinned" "items" $pinned "project_id" $project_id)}}{{end}}
{{if $rest}}{{template "chat_thread_group" (dict "title" (ternary $pinned "Threads" "Recent") "items" $rest "project_id" $project_id)}}{{end}}
{{end}}
{{else if .q}}
{{template "empty_state" (dict "icon_name" "search" "title" "Nothing matches" "body" (partial "chat_search_empty_body" .q))}}
{{else if eq .view "archived"}}
{{template "empty_state" (dict "icon_name" "archive" "title" "Nothing archived" "body" "Archive a thread from the list or its header to tuck it away.")}}
{{else}}
{{template "empty_state" (dict "icon_name" "messages-square" "title" "No threads yet" "body" (ternary $project_id "Start one below." "Start one below. Scheduled runs live under Scheduled."))}}
{{end}}
{{- end}}

{{define "chat_search_empty_body"}}No thread mentions “{{.}}”.{{end}}

{{define "chat_thread_group"}}{{$project_id := .project_id}}
<section class="flex flex-col gap-2" aria-label="{{.title}}">
  <h2 class="px-1 text-xs font-medium uppercase tracking-wide text-muted-foreground" tabindex="-1" data-focus-fallback>{{.title}}</h2>
  <ul class="flex flex-col divide-y overflow-hidden rounded-lg border bg-card" role="list">
    {{range .items}}{{template "chat_thread_row" (dict "t" . "project_id" $project_id)}}{{end}}
  </ul>
</section>
{{- end}}

{{define "chat_thread_row"}}{{$t := .t}}{{$project_id := .project_id}}
<li class="flex items-center gap-1 pe-2 hover:bg-accent">
  <a href="/chat/{{$t.id}}" class="flex min-w-0 flex-1 flex-col gap-1 px-4 py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
    <span class="flex items-center gap-2">
      <span class="truncate text-sm font-medium">{{or $t.title "Untitled thread"}}</span>
      {{template "run_badge" $t.run_state}}
      {{if and $t.project_name (not $project_id)}}<span class="badge truncate" data-variant="outline">{{icon "folder" "size-3"}}{{$t.project_name}}</span>{{end}}
    </span>
    <span class="flex gap-3 text-xs text-muted-foreground tabular-nums">
      <span>{{template "when" (dict "epoch" $t.updated_at "style" "datetime")}}</span>
      <span>${{printf "%.3f" $t.cost}}</span>
    </span>
  </a>
  {{if not $t.archived}}
  <button id="thread-{{$t.id}}-pin" type="button" class="btn" data-variant="ghost" data-size="icon-sm" title="{{if $t.pinned}}Unpin{{else}}Pin{{end}}" aria-label="{{if $t.pinned}}Unpin{{else}}Pin{{end}} {{or $t.title "thread"}}"
          hx-post="/chat/{{$t.id}}/pin" hx-vals='{"pinned": {{if $t.pinned}}0{{else}}1{{end}}, "project_id": {{or $project_id 0}}}' hx-include="#thread-search" hx-target="#threads" hx-swap="innerHTML">{{icon (ternary $t.pinned "pin-off" "pin")}}</button>
  {{end}}
  <button id="thread-{{$t.id}}-archive" type="button" class="btn" data-variant="ghost" data-size="icon-sm" title="{{if $t.archived}}Unarchive{{else}}Archive{{end}}" aria-label="{{if $t.archived}}Unarchive{{else}}Archive{{end}} {{or $t.title "thread"}}"
          hx-post="/chat/{{$t.id}}/archive" hx-vals='{"archived": {{if $t.archived}}0{{else}}1{{end}}, "project_id": {{or $project_id 0}}}' hx-include="#thread-search" hx-target="#threads" hx-swap="innerHTML">{{icon (ternary $t.archived "archive-restore" "archive")}}</button>
</li>
{{- end}}
