{{define "title"}}Permissions · Settings{{end}}
{{define "heading"}}Settings · Permissions{{end}}
{{define "body_attrs"}}{{if .Data.Saved}} data-strip-params="saved"{{end}}{{end}}
{{define "content"}}{{$d := .Data}}
{{template "settings_nav" (dict "Tab" "permissions" "Settings" .Settings)}}
<form method="post" action="/settings/permissions" class="flex max-w-3xl flex-col gap-4">
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  {{with $d.Error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.}}</p>{{end}}
  <table class="table">
    <thead><tr><th scope="col">Situation</th>{{range $d.Channels}}<th scope="col">{{.}}</th>{{end}}</tr></thead>
    <tbody>
      {{range $d.Rows}}<tr><th scope="row">{{.Label}}</th>
        {{range .Cells}}{{$cell := .}}<td><select name="{{$cell.Key}}" aria-label="{{$cell.Label}}"{{if $cell.Pinned}} disabled{{end}}>
          {{range $cell.Choices}}<option value="{{.}}"{{if eq . $cell.Value}} selected{{end}}>{{.}}</option>{{end}}
        </select></td>{{end}}
      </tr>{{end}}
    </tbody>
  </table>
  <div><button type="submit" class="btn">{{icon "check"}}Save</button></div>
</form>
{{end}}
