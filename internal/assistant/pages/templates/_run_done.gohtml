{{$d := .Data}}{{$csrf := .CSRF}}{{$v := $d.View}}{{$run := $d.Run}}
{{range $d.Items}}{{template "chat_item" (dict "Item" . "thread" $v.Thread "last_seq" $v.LastOperatorSeq "busy" false "csrf" $csrf)}}{{end}}
{{if eq $run.State "failed"}}
<li data-run="{{$run.ID}}"><div class="alert" data-variant="destructive" role="alert">{{icon "circle-alert"}}<p>Run {{$run.ID}} stopped: {{$run.Error}}</p></div></li>
{{else if eq $run.State "interrupted"}}
{{template "chat_interrupted" (dict "thread_id" $d.ThreadID "run_id" $run.ID)}}
{{end}}
{{range $v.Queued}}{{template "chat_item" (dict "Item" (dict "Kind" "queued" "ID" .ID "Text" .Text "Files" .Files))}}{{end}}
{{template "chat_meter" (dict "view" $v "oob" true)}}
<div id="panel-work" hx-swap-oob="innerHTML">{{template "chat_work" $d.Work}}</div>
{{template "pending_badge" (dict "count" .PendingCount "oob" true)}}
