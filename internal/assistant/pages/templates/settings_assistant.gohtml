{{define "title"}}Assistant · Settings{{end}}
{{define "heading"}}Settings · Assistant{{end}}
{{define "body_attrs"}}{{if .Data.saved}} data-strip-params="saved"{{end}}{{end}}
{{define "content"}}{{$d := .Data}}
{{template "settings_tabs" "assistant"}}
<form method="post" action="/settings/assistant" class="flex max-w-xl flex-col gap-4">
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  {{with $d.error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.}}</p>{{end}}
  <div role="group" class="field">
    <label for="default-model">Default model</label>
    <select id="default-model" name="model">
      {{range $d.models}}<option value="{{.id}}"{{if eq .id $d.defaults.model}} selected{{end}}>{{.name}}</option>{{end}}
    </select>
  </div>
  <div role="group" class="field">
    <label for="default-effort">Default effort</label>
    <select id="default-effort" name="effort">
      {{range $d.efforts}}<option value="{{.}}"{{if eq . $d.defaults.effort}} selected{{end}}>{{.}}</option>{{end}}
    </select>
  </div>
  <div role="group" class="field">
    <label for="default-context">Default context</label>
    <select id="default-context" name="context_limit">
      {{range $d.context_limits}}<option value="{{.}}"{{if eq . $d.defaults.context_limit}} selected{{end}}>{{if ge . 1000000}}{{int (fdiv . 1000000)}}M{{else}}{{int (fdiv . 1000)}}K{{end}}</option>{{end}}
    </select>
  </div>
  <div><button type="submit" class="btn">{{icon "check"}}Save</button></div>
</form>
{{end}}
