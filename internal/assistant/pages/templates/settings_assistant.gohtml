{{define "title"}}Assistant · Settings{{end}}
{{define "heading"}}Settings · Assistant{{end}}
{{define "body_attrs"}}{{if .Data.Saved}} data-strip-params="saved"{{end}}{{end}}
{{define "content"}}{{$d := .Data}}
{{template "settings_nav" (dict "Tab" "assistant" "Settings" .Settings)}}
{{template "settings_module_head" .}}
<form method="post" action="/settings/assistant" class="set-group">
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  <h2>New threads</h2>
  {{with $d.Error}}<p class="px-4 py-2 text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.}}</p>{{end}}
  <div role="group" class="set-row">
    <label for="default-model">Default model</label>
    <select id="default-model" name="model" class="select">
      {{range $d.Models}}<option value="{{.ID}}"{{if eq .ID $d.Defaults.Model}} selected{{end}}>{{.Name}}</option>{{end}}
    </select>
  </div>
  <div role="group" class="set-row">
    <label for="default-effort">Default effort</label>
    <select id="default-effort" name="effort" class="select">
      {{range $d.Efforts}}<option value="{{.}}"{{if eq . $d.Defaults.Effort}} selected{{end}}>{{.}}</option>{{end}}
    </select>
  </div>
  <div role="group" class="set-row">
    <label for="default-context">Default context</label>
    <select id="default-context" name="context_limit" class="select">
      {{range $d.ContextLimits}}<option value="{{.}}"{{if eq . $d.Defaults.ContextLimit}} selected{{end}}>{{ctxlabel .}}</option>{{end}}
    </select>
  </div>
  <footer>{{if eq $d.Saved "1"}}<span class="text-xs text-ink-3" role="status" data-saved>Saved</span>{{end}}<button type="submit" class="btn" data-size="sm" data-variant="outline">Save</button></footer>
</form>
<form method="post" action="/settings/permissions" class="set-group" data-group="permissions">
  <input type="hidden" name="csrf_token" value="{{.CSRF}}">
  <h2>Permissions</h2>
  {{with $d.Refused}}<p class="px-4 py-2 text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.}}</p>{{end}}
  <div class="overflow-x-auto"><table class="set-matrix">
    <thead><tr><th scope="col">Situation</th>{{range $d.Channels}}<th scope="col">{{.}}</th>{{end}}</tr></thead>
    <tbody>
      {{range $d.Rows}}<tr><th scope="row">{{.Label}}</th>
        {{range .Cells}}{{$cell := .}}<td><select class="select" name="{{$cell.Key}}" aria-label="{{$cell.Label}}"{{if $cell.Pinned}} disabled{{end}}>
          {{range $cell.Choices}}<option value="{{.}}"{{if eq . $cell.Value}} selected{{end}}>{{.}}</option>{{end}}
        </select></td>{{end}}
      </tr>{{end}}
    </tbody>
  </table></div>
  <footer>{{if eq $d.Saved "permissions"}}<span class="text-xs text-ink-3" role="status" data-saved>Saved</span>{{end}}<button type="submit" class="btn" data-size="sm" data-variant="outline">Save</button></footer>
</form>
{{template "settings_connections" .}}
{{template "settings_groups" .}}
{{end}}
