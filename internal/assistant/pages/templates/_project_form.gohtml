{{template "project_form" (dict "project" .Data.project "values" .Data.values "efforts" .Data.efforts "context_limits" .Data.context_limits "error" .Data.error "csrf" .CSRF)}}

{{define "project_form"}}{{$v := .values}}{{$action := "/projects"}}{{if .project}}{{$action = printf "/projects/%v" .project.id}}{{end}}
<form method="post" action="{{$action}}" class="w-full sm:max-w-2xl" hx-post="{{$action}}" hx-target="#project-dialog" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
  <input type="hidden" name="csrf_token" value="{{.csrf}}">
  <header class="flex-row items-center gap-2">
    <h2 class="min-w-0 flex-1 truncate">{{if .project}}Edit {{.project.name}}{{else}}New project{{end}}</h2>
    <button type="button" class="btn" data-variant="ghost" data-size="icon-sm" aria-label="Close" data-action="close-dialog">{{icon "x"}}</button>
  </header>
  <section class="flex max-h-[70vh] flex-col gap-4 overflow-y-auto">
    {{if .error}}<p class="text-sm text-destructive" role="alert">{{.error}}</p>{{end}}
    <div role="group" class="field">
      <label for="project-name">Name</label>
      <input id="project-name" name="name" type="text" value="{{$v.name}}" required>
    </div>
    <div role="group" class="field">
      <label for="project-instructions">Instructions</label>
      <textarea id="project-instructions" name="instructions" rows="6" class="w-full" placeholder="Markdown. Added to the assistant's system prompt in every chat of this project.">{{$v.instructions}}</textarea>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div role="group" class="field">
        <label for="project-effort">Default effort</label>
        <select id="project-effort" name="effort" class="select">
          {{range .efforts}}<option value="{{.}}"{{if eq . $v.effort}} selected{{end}}>{{.}}</option>{{end}}
        </select>
      </div>
      <div role="group" class="field">
        <label for="project-context">Default context limit</label>
        <select id="project-context" name="context_limit" class="select">
          {{range .context_limits}}<option value="{{.}}"{{if and $v.context_limit (eq . $v.context_limit)}} selected{{end}}>{{int (fdiv . 1000)}}K{{if gt . 100000}} (5× price over 100K){{end}}</option>{{end}}
        </select>
      </div>
    </div>
    {{template "project_hub" (dict "project" .project "hub_id" (or $v.wiki_hub_id "") "notice" nil "error" nil)}}
  </section>
  <footer class="flex-wrap">
    {{if and .project (not .project.archived)}}
    <button type="button" class="btn me-auto" data-size="sm" data-variant="destructive" hx-post="/projects/{{.project.id}}/archive" hx-confirm="Archive this project? Its threads stay in the chat list.">{{icon "archive"}}Archive</button>
    {{end}}
    <button type="button" class="btn" data-variant="outline" data-action="close-dialog">Cancel</button>
    <button type="submit" class="btn">{{icon "check"}}{{if .project}}Save{{else}}Create{{end}}</button>
  </footer>
</form>
{{- end}}
