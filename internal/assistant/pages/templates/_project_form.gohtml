{{template "project_form" (dict "form" .Data "csrf" .CSRF)}}

{{define "project_form"}}{{$f := .form}}{{$v := $f.Values}}{{$action := "/projects"}}{{if $f.Project}}{{$action = printf "/projects/%v/edit" $f.Project.ID}}{{end}}
<form method="post" action="{{$action}}" class="flex flex-col gap-4" hx-post="{{$action}}" hx-target="#project-form" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]">
  <input type="hidden" name="csrf_token" value="{{.csrf}}">
  {{if $f.Error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{$f.Error}}</p>{{end}}
  <div role="group" class="field">
    <label for="project-name">Name</label>
    <input id="project-name" name="name" type="text" value="{{$v.Name}}" required>
  </div>
  <div role="group" class="field">
    <label for="project-instructions">Instructions</label>
    <textarea id="project-instructions" name="instructions" rows="6" class="w-full" placeholder="Markdown">{{$v.Instructions}}</textarea>
  </div>
  <div class="grid gap-3 sm:grid-cols-2">
    <div role="group" class="field">
      <label for="project-effort">Default effort</label>
      <select id="project-effort" name="effort" class="select">
        {{range $f.Efforts}}<option value="{{.}}"{{if eq . $v.Effort}} selected{{end}}>{{.}}</option>{{end}}
      </select>
    </div>
    <div role="group" class="field">
      <label for="project-context">Default context</label>
      <select id="project-context" name="context_limit" class="select">
        {{range $f.ContextLimits}}<option value="{{.}}"{{if and $v.ContextLimit (eq . (int $v.ContextLimit))}} selected{{end}}>{{ctxlabel .}}</option>{{end}}
      </select>
    </div>
  </div>
  <label class="flex items-center gap-2 text-sm"><input type="hidden" name="private" value="0"><input type="checkbox" name="private" value="1"{{if $v.Private}} checked{{end}}> Private</label>
  <div class="flex justify-end">
    <button type="submit" class="btn">{{icon "check"}}{{if $f.Project}}Save{{else}}Create{{end}}</button>
  </div>
</form>
{{- end}}
