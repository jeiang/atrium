{{define "title"}}Prompts · Settings{{end}}
{{define "heading"}}Settings · Prompts{{end}}
{{define "body_attrs"}}{{if .Data.Strip}} data-strip-params="saved,reset"{{end}}{{end}}
{{define "content"}}{{$d := .Data}}{{$csrf := .CSRF}}
{{template "settings_tabs" (dict "Tab" "prompts" "Auth" .Auth "Settings" .Settings)}}
<div class="flex flex-col gap-4">
  <section class="rounded-lg border bg-card p-4" aria-labelledby="prompt-preamble">
    <h2 id="prompt-preamble" class="flex items-center gap-2 text-sm font-medium">Preamble<span class="badge" data-variant="outline">fixed</span></h2>
    <p class="mt-2 whitespace-pre-wrap text-sm text-muted-foreground" data-preamble>{{$d.Preamble}}</p>
  </section>
  {{range $d.Prompts}}
  <form method="post" action="/settings/prompts/{{.Key}}" class="flex flex-col gap-3 rounded-lg border bg-card p-4" data-prompt="{{.Key}}">
    <input type="hidden" name="csrf_token" value="{{$csrf}}">
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <label for="prompt-{{.Key}}" class="font-medium">{{.Label}}</label>
      {{if .Custom}}<span class="badge" data-variant="secondary">custom</span>{{end}}
      {{if .Pinned}}<span class="badge" data-variant="outline">pinned</span>{{end}}
    </div>
    {{with .Error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.}}</p>{{end}}
    <textarea id="prompt-{{.Key}}" name="text" rows="12" class="w-full font-mono text-xs" maxlength="50000" required{{if .Pinned}} readonly{{end}}>{{.Text}}</textarea>
    {{if not .Pinned}}
    <div class="flex flex-wrap gap-2">
      <button type="submit" class="btn" data-size="sm">{{icon "check"}}Save</button>
      {{if .Custom}}<button type="submit" class="btn" data-size="sm" data-variant="outline" formaction="/settings/prompts/{{.Key}}/reset" formnovalidate data-confirm-submit="Reset the {{.Label}} prompt to the built-in text?">{{icon "undo-2"}}Reset to default</button>{{end}}
    </div>
    {{end}}
  </form>
  {{end}}
</div>
{{end}}
