{{template "schedule_runs" (dict "runs" .Data.Runs)}}

{{define "schedule_runs"}}
{{if .runs}}
<ul class="flex flex-col divide-y overflow-hidden rounded-lg border bg-card text-sm" role="list" aria-label="Run history">
  {{range .runs}}
  <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5">
    <span class="font-medium">{{.JobName}}</span>
    {{$title := lbl "job_run_hint" .Hint ""}}{{if .Error}}{{$title = (str .Error)}}{{end}}{{template "scheduled_status" (dict "status" .Status "title" $title)}}
    <span class="text-xs text-muted-foreground tabular-nums">{{str .StartedText}}</span>
    {{if .Cost}}<span class="text-xs text-muted-foreground tabular-nums">${{printf "%.3f" .Cost}}</span>{{end}}
    {{if .Error}}<span class="min-w-0 max-w-full truncate text-xs text-muted-foreground" title="{{str .Error}}">{{str .Error}}</span>{{end}}
    <span class="ms-auto flex items-center gap-1">
      {{if .ThreadID}}<a class="btn" data-size="sm" data-variant="ghost" href="/chat/{{str .ThreadID}}">{{icon "messages-square"}}Thread</a>{{end}}
    </span>
  </li>
  {{end}}
</ul>
{{else}}
<p class="rounded-lg border px-4 py-6 text-center text-sm text-muted-foreground">No runs yet.</p>
{{end}}
{{- end}}
