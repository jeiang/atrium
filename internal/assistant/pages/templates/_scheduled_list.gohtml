{{template "scheduled_list" (dict "jobs" .Data.Jobs "runs" .Data.Runs "toast" .Toast)}}

{{define "scheduled_status"}}{{$status := .status}}{{$title := .title}}{{with badge "job_run" $status}}<span class="badge" data-variant="{{.Variant}}"{{if $title}} title="{{$title}}"{{end}}>{{.Label}}</span>{{else}}<span class="badge" data-variant="outline"{{if $title}} title="{{$title}}"{{end}}>{{$status}}</span>{{end}}{{end}}




{{define "scheduled_list"}}
{{with opt . "toast" nil}}{{template "_toast.gohtml" (dict "Toast" .)}}{{end}}
<div id="scheduled-list" class="flex flex-col gap-8">
  <section class="flex flex-col gap-3" aria-labelledby="schedules-h">
    <h2 id="schedules-h" class="text-sm font-medium" tabindex="-1" data-focus-fallback>Schedules</h2>
    {{if .jobs}}
    <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" role="list">
      {{range .jobs}}
      <li class="flex flex-col gap-3 rounded-lg border bg-card p-4" data-job="{{.ID}}">
        <header class="flex items-start gap-2">
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <h3 class="truncate text-sm font-medium" title="{{.Name}}">{{.Name}}</h3>
            <p class="text-xs text-muted-foreground">{{.Cadence}}</p>
          </div>
          <label class="flex items-center gap-2 text-xs text-muted-foreground">
            <span class="sr-only">{{.Name}} enabled</span>
            <input id="job-toggle-{{.ID}}" type="checkbox" role="switch" class="input"{{if .Enabled}} checked{{end}}
                    hx-post="/scheduled/{{.ID}}/toggle" hx-trigger="change" hx-target="#scheduled-list" hx-swap="outerHTML">
          </label>
        </header>
        <p class="line-clamp-2 text-xs text-muted-foreground">{{.Prompt}}</p>
        <dl class="flex flex-col gap-1 text-xs">
          <div class="flex gap-2"><dt class="w-16 shrink-0 text-muted-foreground">Next run</dt><dd>{{if .NextDueText}}{{str .NextDueText}}{{else}}{{if .Enabled}}Not scheduled{{else}}Paused{{end}}{{end}}</dd></div>
          <div class="flex flex-wrap items-center gap-2">
            <dt class="w-16 shrink-0 text-muted-foreground">Last run</dt>
            <dd class="flex items-center gap-2">
              {{if .LastStatus}}{{$status := (str .LastStatus)}}{{$title := lbl "job_run_hint" $status ""}}{{if .LastError}}{{$title = (str .LastError)}}{{end}}{{template "scheduled_status" (dict "status" $status "title" $title)}}{{str .LastStartedText}}{{else}}Never{{end}}
            </dd>
          </div>
        </dl>
        <footer class="mt-auto flex items-center gap-2">
          <span class="badge" data-variant="outline">{{if has (list "nightly" "builtin") .Kind}}{{lbl "job_source" .Kind}}{{else}}{{lbl "job_source" .CreatedBy}}{{end}}</span>
          <button id="job-edit-{{.ID}}" type="button" class="btn ms-auto" data-size="sm" data-variant="outline" hx-get="/scheduled/{{.ID}}/edit" hx-target="#schedule-dialog" hx-swap="innerHTML">{{icon "pencil"}}Edit</button>
        </footer>
      </li>
      {{end}}
    </ul>
    {{else}}
    {{template "empty_state" (dict "icon_name" "clock" "title" "No schedules" "body" "Ask the assistant in chat to schedule something, or create one here.")}}
    {{end}}
  </section>

  <section class="flex flex-col gap-3" aria-labelledby="history-h">
    <h2 id="history-h" class="text-sm font-medium">Run history</h2>
    {{template "schedule_runs" (dict "runs" .runs)}}
  </section>
</div>
{{- end}}
