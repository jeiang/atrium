{{template "scheduled_list" (dict "jobs" .Data.Jobs "runs" .Data.Runs "tz" .Data.TZ "toast" .Toast)}}

{{define "scheduled_status"}}{{$status := .status}}{{$title := .title}}{{with badge "job_run" $status}}<span class="badge" data-variant="{{.Variant}}"{{if $title}} title="{{$title}}"{{end}}>{{.Label}}</span>{{else}}<span class="badge" data-variant="outline"{{if $title}} title="{{$title}}"{{end}}>{{$status}}</span>{{end}}{{end}}

{{define "scheduled_list"}}
{{with opt . "toast" nil}}{{template "_toast.gohtml" (dict "Toast" .)}}{{end}}
<div id="scheduled-list" class="flex flex-col gap-8">
  <section class="flex flex-col gap-3" aria-labelledby="schedules-h">
    <div class="flex items-baseline gap-2">
      <h2 id="schedules-h" class="text-sm font-medium" tabindex="-1" data-focus-fallback>Schedules</h2>
      <span class="text-xs text-muted-foreground">{{.tz}}</span>
    </div>
    {{if .jobs}}
    <ul class="rows" role="list">
      {{range .jobs}}
      <li class="row" data-job="{{.ID}}">
        <span class="row-main">
          <span class="row-title" title="{{.Prompt}}">{{.Name}}</span>
          <span class="row-meta">{{.Cadence}} · {{if has (list "nightly" "builtin") .Kind}}{{lbl "job_source" .Kind}}{{else}}{{lbl "job_source" .CreatedBy}}{{end}} · {{if .NextDueText}}next {{str .NextDueText}}{{else if .Enabled}}Not scheduled{{else}}Paused{{end}}</span>
        </span>
        {{if .LastStatus}}{{$status := (str .LastStatus)}}{{$title := lbl "job_run_hint" $status ""}}{{if .LastError}}{{$title = (str .LastError)}}{{end}}{{if ne $status "ok"}}{{template "scheduled_status" (dict "status" $status "title" $title)}}{{end}}<span class="row-when max-sm:hidden" title="Last run">{{str .LastStartedText}}</span>{{end}}
        {{if not (has (list "nightly" "builtin") .Kind)}}
        <button id="job-delete-{{.ID}}" type="button" class="btn" data-size="icon-sm" data-variant="ghost" aria-label="Delete {{.Name}}" hx-post="/scheduled/{{.ID}}/cancel" hx-target="#scheduled-list" hx-swap="outerHTML" hx-confirm="Delete {{.Name}}?">{{icon "trash-2" "size-3.5"}}</button>
        {{end}}
        <label class="flex items-center">
          <span class="sr-only">{{.Name}} enabled</span>
          <input id="job-toggle-{{.ID}}" type="checkbox" role="switch" class="input"{{if .Enabled}} checked{{end}}
                  hx-post="/scheduled/{{.ID}}/toggle" hx-trigger="change" hx-target="#scheduled-list" hx-swap="outerHTML">
        </label>
      </li>
      {{end}}
    </ul>
    {{else}}
    {{template "empty_state" (dict "icon_name" "clock" "title" "No schedules")}}
    {{end}}
  </section>

  <section class="flex flex-col gap-3" aria-labelledby="history-h">
    <h2 id="history-h" class="text-sm font-medium">Run history</h2>
    {{template "schedule_runs" (dict "runs" .runs)}}
  </section>
</div>
{{- end}}
