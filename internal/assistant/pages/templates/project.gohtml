{{define "title"}}{{.Data.project.name}}{{end}}
{{define "heading"}}{{.Data.project.name}}{{end}}
{{define "content"}}{{$d := .Data}}{{$p := $d.project}}
<div class="flex min-h-[calc(100dvh-6.5rem)] flex-col gap-4 md:min-h-[calc(100dvh-7.5rem)]">
  <header class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
    <a href="/projects" class="btn" data-size="sm" data-variant="ghost">{{icon "arrow-left"}}Projects</a>
    {{if $p.archived}}<span class="badge" data-variant="secondary">archived</span>{{end}}
    <span>effort {{$p.effort}} · context {{int (fdiv $p.context_limit 1000)}}K</span>
    {{if $p.wiki_hub_id}}<a class="btn" data-size="sm" data-variant="ghost" href="https://www.notion.so/{{replace "-" "" $p.wiki_hub_id}}" target="_blank" rel="noopener">{{icon "book-open"}}Wiki hub</a>{{end}}
    <span class="ms-auto flex items-center gap-1">
      <button id="edit-project" type="button" class="btn" data-size="sm" data-variant="outline" hx-get="/projects/{{$p.id}}/edit" hx-target="#project-dialog" hx-swap="innerHTML">{{icon "pencil"}}Edit</button>
      <form method="post" action="/projects/{{$p.id}}/archive">
        <input type="hidden" name="csrf_token" value="{{.CSRF}}">
        <input type="hidden" name="archived" value="{{if $p.archived}}0{{else}}1{{end}}">
        <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon (ternary $p.archived "archive-restore" "archive")}}{{if $p.archived}}Restore{{else}}Archive{{end}}</button>
      </form>
    </span>
  </header>
  {{if $p.instructions}}<p class="line-clamp-3 max-w-prose text-sm text-muted-foreground">{{$p.instructions}}</p>{{end}}
  <section id="project-files" class="flex flex-col gap-2" aria-labelledby="project-files-title">
    {{template "project_files" (dict "project" $p "files" $d.files "error" nil "csrf" .CSRF)}}
  </section>
  <form id="thread-search" action="/projects/{{$p.id}}" method="get" class="flex items-center">
    <input type="hidden" name="view" value="{{$d.view}}">
    <nav class="button-group" aria-label="Thread view">
      <a class="btn" data-size="sm" data-variant="{{if $d.view}}outline{{else}}secondary{{end}}" href="/projects/{{$p.id}}">Active</a>
      <a class="btn" data-size="sm" data-variant="{{if $d.view}}secondary{{else}}outline{{end}}" href="/projects/{{$p.id}}?view=archived">Archived</a>
    </nav>
  </form>
  <div id="threads" class="flex flex-col gap-3">
    {{template "chat_thread_list" (dict "threads" $d.threads "view" $d.view "q" "" "project_id" $p.id)}}
  </div>
  {{if not $p.archived}}
  <form method="post" action="/chat" enctype="multipart/form-data" hx-post="/chat" hx-encoding="multipart/form-data" hx-swap="none" hx-disabled-elt="find button[type=submit]"
        class="sticky bottom-0 z-10 mt-auto flex flex-col gap-2 rounded-lg border bg-card p-3 shadow-sm" data-reset data-attach>
    <input type="hidden" name="csrf_token" value="{{.CSRF}}">
    <input type="hidden" name="project_id" value="{{$p.id}}">
    <label for="new-text" class="sr-only">New thread in {{$p.name}}</label>
    <textarea id="new-text" name="text" rows="2" class="textarea w-full" placeholder="Start a chat in {{$p.name}}" data-submit-on-enter autofocus></textarea>
    {{template "attach_field"}}
    <div class="flex flex-wrap items-center gap-2 text-xs">
      {{template "attach_button"}}
      {{template "composer_options" (dict "c" $d.composer)}}
      <button type="submit" class="btn ms-auto" data-size="sm">{{icon "send"}}Start</button>
    </div>
  </form>
  {{end}}
</div>
<dialog id="project-dialog" class="dialog" aria-labelledby="project-dialog-title"></dialog>
{{end}}
