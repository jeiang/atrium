{{template "knowledge_profile" .}}

{{define "knowledge_profile"}}{{$d := .Data}}
<div id="kb-profile" class="flex flex-col gap-4">
<a href="/library/knowledge" class="btn self-start" data-size="sm" data-variant="ghost">{{icon "arrow-left"}}Knowledge</a>
<div class="flex max-w-3xl flex-col gap-6">
  <section class="flex flex-col gap-3" aria-labelledby="kb-profile-h">
    <header class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 id="kb-profile-h" class="text-xl font-semibold">Profile</h1>
      <p class="text-xs text-muted-foreground tabular-nums">{{$d.Tokens}} of {{$d.Budget}} tokens</p>
    </header>
    <span class="h-1.5 w-full overflow-hidden rounded-full bg-muted" aria-hidden="true"><span class="block h-full rounded-full bg-chart-3" style="width: {{$d.Percent}}%"></span></span>
    {{if $d.Block}}<pre class="whitespace-pre-wrap rounded-lg border bg-card p-4 text-sm leading-relaxed">{{$d.Block}}</pre>
    {{else}}<p class="rounded-lg border border-dashed px-4 py-6 text-center text-sm text-muted-foreground">The profile is empty.</p>{{end}}
  </section>

  <section class="flex flex-col gap-2" aria-labelledby="kb-pinned-h">
    <h2 id="kb-pinned-h" class="text-sm font-medium">Pinned records</h2>
    {{if $d.Entries}}
    <ul class="flex flex-col divide-y overflow-hidden rounded-lg border bg-card text-sm" role="list">
      {{range $d.Entries}}
      <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5">
        <a class="min-w-0 truncate underline-offset-4 hover:underline" href="/library/knowledge/{{.ID}}">{{or .Title "Untitled"}}</a>
        {{if .InPrompt}}<span class="badge" data-variant="secondary">In prompt</span>
        {{else}}<span class="badge" data-variant="outline">{{.Reason}}</span>{{end}}
        <span class="ms-auto text-xs text-muted-foreground tabular-nums">{{.Tokens}} tokens</span>
      </li>
      {{end}}
    </ul>
    {{else}}<p class="rounded-lg border border-dashed px-4 py-6 text-center text-sm text-muted-foreground">No pinned records.</p>{{end}}
  </section>

  <section class="flex flex-col gap-3 border-t pt-6" aria-labelledby="kb-add-h">
    <h2 id="kb-add-h" class="text-sm font-medium">Add a fact</h2>
    {{if $d.Error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{$d.Error}}</p>{{end}}
    <form method="post" action="/library/knowledge/profile" class="flex flex-col gap-3" hx-post="/library/knowledge/profile" hx-target="#kb-profile" hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]">
      <input type="hidden" name="csrf_token" value="{{.CSRF}}">
      <div role="group" class="field">
        <label for="kb-fact-title">Title</label>
        <input id="kb-fact-title" name="title" type="text" maxlength="200" required>
      </div>
      <div role="group" class="field">
        <label for="kb-fact-body">Body</label>
        <textarea id="kb-fact-body" name="body" rows="3" class="w-full" required></textarea>
      </div>
      <div class="flex justify-end"><button type="submit" class="btn" data-size="sm">{{icon "plus"}}Add fact</button></div>
    </form>
  </section>
</div>
</div>
{{- end}}
