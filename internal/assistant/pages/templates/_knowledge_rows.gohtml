{{template "knowledge_rows" (dict "rows" .Data.Rows "unconfirmed" .Data.Unconfirmed "bulk" .Data.Bulk "q" .Data.Q "scope" .Data.Scope "state" .Data.State "csrf" .CSRF)}}

{{define "knowledge_rows"}}
{{if .rows}}
<form id="kb-confirm" method="post" action="/library/knowledge/confirm" hx-post="/library/knowledge/confirm" hx-target="body" class="flex flex-col gap-2">
<input type="hidden" name="csrf_token" value="{{.csrf}}">
<input type="hidden" name="q" value="{{.q}}">
<input type="hidden" name="scope" value="{{.scope}}">
<input type="hidden" name="state" value="{{.state}}">
{{if .unconfirmed}}
<div class="flex items-center gap-3 px-3 text-sm text-ink-2">
  <label class="flex items-center gap-2"><input type="checkbox" class="input" data-select-all> Select all</label>
  <button type="submit" class="btn ms-auto" data-size="sm" data-variant="outline">{{icon "check"}}Confirm selected</button>
</div>
{{end}}
<ul class="rows" role="list" aria-label="Knowledge records">
  {{range .rows}}
  <li class="row">
    {{if not (or .Confirmed .Retracted)}}<input type="checkbox" class="input" name="id" value="{{.ID}}" aria-label="Select {{or .Title "Untitled"}}">{{end}}
    <span class="row-main">
      <a class="row-title" href="/library/knowledge/{{.ID}}">{{or .Title "Untitled"}}</a>
      <span class="row-meta">{{.Scope}} · {{.Writer}}{{if .Pinned}} · pinned{{end}}{{if .Retracted}} · retracted{{end}}{{if not (or .Confirmed .Retracted)}} · unconfirmed{{end}}</span>
    </span>
    <span class="row-when">{{template "when" (dict "epoch" .Updated "style" "date")}}</span>
  </li>
  {{end}}
</ul>
</form>
{{else if .q}}
{{template "empty_state" (dict "icon_name" "search" "title" "No matching records")}}
{{else}}
{{template "empty_state" (dict "icon_name" "book-open" "title" "No knowledge records yet")}}
{{end}}
{{if .bulk}}
<form class="flex justify-end pt-2" method="post" action="/library/knowledge/confirm-all" hx-post="/library/knowledge/confirm-all" hx-target="body">
  <input type="hidden" name="csrf_token" value="{{.csrf}}">
  <input type="hidden" name="q" value="{{.q}}">
  <input type="hidden" name="scope" value="{{.scope}}">
  <input type="hidden" name="state" value="{{.state}}">
  <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "check"}}Confirm all shown</button>
</form>
{{end}}
{{- end}}
