{{template "agenda" .Data}}
{{with .Data.Next}}<span id="brief-next" hx-swap-oob="true"> before {{.Title}} at {{.Time}}</span>{{end}}

{{define "agenda"}}{{with .Events}}
<section class="flex flex-col gap-3" aria-labelledby="agenda-h" data-agenda>
  <h2 id="agenda-h" class="eyebrow">Today</h2>
  <ol class="agenda">
    {{range .}}<li class="agenda-event"{{with .State}} data-state="{{.}}"{{end}}><time>{{.Time}}</time><span class="agenda-rail"></span><div class="agenda-body"><span class="agenda-title">{{.Title}}{{with .Ask}} <a class="agenda-ask" href="/chat?about={{.}}" aria-label="Ask about this event" title="Ask about this">{{icon "messages-square"}}</a>{{end}}</span>{{with .Meta}}<span class="agenda-meta">{{.}}</span>{{end}}</div></li>
    {{end}}
  </ol>
</section>
{{end}}
{{end}}
