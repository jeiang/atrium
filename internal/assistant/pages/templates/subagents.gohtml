{{define "title"}}Subagents · Settings{{end}}
{{define "heading"}}Settings · Subagents{{end}}
{{define "body_attrs"}}{{if .Data.StripParams}} data-strip-params="saved,deleted,toggled"{{end}}{{end}}

{{define "subagent_fields"}}{{$a := .a}}{{$prefix := .prefix}}
<div class="grid gap-3 sm:grid-cols-2">
  <div role="group" class="field"><label for="{{$prefix}}-description">One-line description</label><input id="{{$prefix}}-description" name="description" type="text" value="{{(opt $a "description" "")}}" maxlength="160" required></div>
  <div role="group" class="field">
    <label for="{{$prefix}}-effort">Effort</label>
    <select id="{{$prefix}}-effort" name="effort">
      {{range .efforts}}<option value="{{.}}"{{if eq (or (opt $a "effort" "") "medium") .}} selected{{end}}>{{.}}</option>{{end}}
    </select>
  </div>
</div>
<div role="group" class="field"><label for="{{$prefix}}-prompt">System prompt addendum</label><textarea id="{{$prefix}}-prompt" name="prompt" rows="4" class="w-full" required>{{(opt $a "prompt" "")}}</textarea></div>
<fieldset class="flex flex-col gap-2">
  <legend class="text-sm font-medium">Tools (read-only)</legend>
  <div class="grid gap-x-4 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
    {{range .pool}}
    <label class="flex items-start gap-2 text-xs"><input type="checkbox" name="tools" value="{{.Name}}" class="input"{{if has (opt $a "tools" nil) .Name}} checked{{end}}><span><code class="font-mono">{{.Name}}</code> <span class="text-muted-foreground">{{truncate 90 .Description}}</span></span></label>
    {{end}}
  </div>
</fieldset>
{{end}}

{{define "content"}}{{$d := .Data}}{{$csrf := .CSRF}}
{{template "settings_tabs" (dict "Tab" "subagents" "Auth" .Auth "Settings" .Settings)}}
<p class="text-sm text-muted-foreground">Research subagents the assistant can delegate to with <code class="font-mono">research(role=…)</code>. Each runs in its own thread with only the tools listed here (read-only; never write, notify, schedule or spawn), at its own effort level. Built-in agents can be edited and disabled but not deleted.</p>

<div class="flex flex-col gap-4">
  {{range $d.Agents}}
  <details class="rounded-lg border bg-card p-4" data-agent="{{.Name}}" data-enabled="{{if .Enabled}}true{{else}}false{{end}}"{{if or (eq $d.Editing .Name) (eq $d.Focus .Name)}} open{{end}}>
    <summary class="flex cursor-pointer flex-wrap items-center gap-2 text-sm"{{if eq $d.Focus .Name}} autofocus{{end}}>
      <span class="font-mono font-medium">{{.Name}}</span>
      <span class="badge" data-variant="outline">effort {{.Effort}}</span>
      {{if .Builtin}}<span class="badge" data-variant="outline">built-in</span>{{end}}
      <span class="badge" data-variant="{{if .Enabled}}secondary{{else}}outline{{end}}">{{if .Enabled}}Enabled{{else}}Disabled{{end}}</span>
      <span class="line-clamp-2 basis-full break-words text-muted-foreground">{{.Description}}</span>
    </summary>
    <p class="mt-2 text-xs text-muted-foreground">Tools: {{range $i, $t := .Tools}}{{if $i}}, {{end}}<code class="font-mono">{{$t}}</code>{{end}}</p>
    <form method="post" action="/settings/subagents" class="mt-3 flex flex-col gap-3">
      <input type="hidden" name="csrf_token" value="{{$csrf}}">
      <input type="hidden" name="name" value="{{.Name}}">
      <input type="hidden" name="from" value="edit">
      {{if and (eq $d.Editing .Name) $d.Error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{$d.Error}}</p>{{end}}
      {{$a := .}}{{if eq $d.Editing .Name}}{{$a = $d.Draft}}{{end}}
      {{template "subagent_fields" (dict "prefix" (printf "a-%s" .Name) "a" $a "pool" $d.Pool "efforts" $d.Efforts)}}
      <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn" data-size="sm">{{icon "check"}}Save</button>
        <button type="submit" class="btn" data-size="sm" data-variant="outline" formaction="/settings/subagents/{{.Name}}/toggle">{{if .Enabled}}Disable{{else}}Enable{{end}}</button>
        {{if not .Builtin}}
        <button type="submit" class="btn" data-size="sm" data-variant="destructive" formaction="/settings/subagents/{{.Name}}/delete" data-confirm-submit="Delete the subagent “{{.Name}}”? The assistant can no longer delegate to it. This cannot be undone.">{{icon "trash-2"}}Delete</button>
        {{end}}
      </div>
    </form>
  </details>
  {{end}}
</div>

<form method="post" action="/settings/subagents" class="flex flex-col gap-3 rounded-lg border p-4">
  <input type="hidden" name="csrf_token" value="{{$csrf}}">
  <h2 class="text-sm font-medium">New subagent</h2>
  {{if and (not $d.Editing) $d.Error}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{$d.Error}}</p>{{end}}
  <div role="group" class="field"><label for="new-name">Name</label><input id="new-name" name="name" type="text" value="{{if not $d.Editing}}{{$d.Draft.Name}}{{end}}" class="font-mono" placeholder="finance" required></div>
  {{$draft := $d.Draft}}{{if $d.Editing}}{{$draft = (dict "effort" "" "description" "" "prompt" "" "tools" (list))}}{{end}}
  {{template "subagent_fields" (dict "prefix" "new" "a" $draft "pool" $d.Pool "efforts" $d.Efforts)}}
  <button type="submit" class="btn self-start" data-size="sm">{{icon "plus"}}Save subagent</button>
</form>
{{end}}
