{{template "chat_work" .Data.Work}}

{{define "chat_work"}}{{$w := .}}
{{if $w.Needs}}
<section class="flex flex-col gap-2" aria-labelledby="work-needs">
  <h2 id="work-needs" class="eyebrow flex items-center gap-1.5">{{icon "bell" "size-3.5"}}Needs you</h2>
  <ul class="flex flex-col gap-2" data-needs>
    {{range $w.Needs}}
    <li id="needs-{{.ID}}" class="rounded-md border px-3 py-2 text-sm" hx-get="/proposals/{{.ID}}/card?view=row" hx-trigger="load" hx-swap="outerHTML">
      <a class="flex min-w-0 items-center gap-2 underline-offset-4 hover:underline" href="#proposal-{{.ID}}">{{icon "list-checks" "size-3.5 shrink-0 text-muted-foreground"}}<span class="truncate">{{.Title}}</span></a>
    </li>
    {{end}}
  </ul>
</section>
{{end}}

{{if $w.Plan}}
<section class="flex flex-col gap-2" aria-labelledby="work-plan">
  <h2 id="work-plan" class="eyebrow flex items-center gap-1.5">{{icon "list-checks" "size-3.5"}}Plan</h2>
  <ol class="flex flex-col gap-1 text-sm" data-plan>
    {{range $w.Plan.items}}
    <li class="flex items-start gap-2">{{if .Done}}{{icon "check" "mt-0.5 size-3.5 shrink-0 text-success"}}{{else}}{{icon "circle-dot" "mt-0.5 size-3.5 shrink-0 text-muted-foreground"}}{{end}}<span class="{{if .Done}}text-muted-foreground line-through{{end}}">{{.Text}}</span></li>
    {{end}}
  </ol>
</section>
{{end}}

{{if $w.Sources}}
<section class="flex flex-col gap-2" aria-labelledby="work-sources">
  <h2 id="work-sources" class="eyebrow flex items-center gap-1.5">{{icon "globe" "size-3.5"}}Sources</h2>
  <ul class="flex flex-col gap-1 text-sm" data-sources>
    {{range $w.Sources}}
    <li class="flex min-w-0 items-center gap-2">
      {{if eq .Kind "mail"}}{{icon "mail" "size-3.5 shrink-0 text-muted-foreground"}}{{else if eq .Kind "knowledge"}}{{icon "book-open" "size-3.5 shrink-0 text-muted-foreground"}}{{else}}{{icon "globe" "size-3.5 shrink-0 text-muted-foreground"}}{{end}}
      {{if eq .Kind "web"}}<a class="truncate underline-offset-4 hover:underline" {{template "external" .URL}}>{{.Title}}</a>
      {{else}}<a class="truncate underline-offset-4 hover:underline" {{template "preview_attrs" .URL}}>{{.Title}}</a>{{end}}
      {{if .Via}}<span class="badge shrink-0" data-variant="outline">{{.Via}}</span>{{end}}
    </li>
    {{end}}
  </ul>
</section>
{{end}}

{{if $w.Subagents}}
<section class="flex flex-col gap-2" aria-labelledby="work-subagents">
  <h2 id="work-subagents" class="eyebrow flex items-center gap-1.5">{{icon "users" "size-3.5"}}Subagents</h2>
  <ul class="flex flex-col gap-2" data-subagents>
    {{range $w.Subagents}}
    <li class="flex flex-col gap-1 rounded-md border px-3 py-2 text-xs" data-child="{{.ThreadID}}" data-status="{{.Status}}">
      <span class="flex flex-wrap items-center gap-1.5">
        <span class="badge" data-variant="secondary">{{or (str .Role) .Kind}}</span>
        <span class="badge" data-variant="outline">effort {{.Effort}}</span>
        {{$st := .Status}}{{with badge "subagent_status" $st}}<span class="badge" data-variant="{{.Variant}}">{{if eq $st "running"}}{{icon "loader-circle" "animate-spin"}}{{end}}{{.Label}}</span>{{else}}<span class="badge" data-variant="outline">{{$st}}</span>{{end}}
        {{if .Current}}<code class="font-mono">{{str .Current}}</code>{{end}}
      </span>
      <a class="truncate underline-offset-4 hover:underline" href="/chat/{{.ThreadID}}">{{or (str .Title) "Untitled"}}</a>
      <span class="flex gap-2 text-muted-foreground tabular-nums"><span>${{printf "%.4f" .Cost}}</span>{{if not (isnil .Elapsed)}}<span>{{printf "%.0f" (float .Elapsed)}}s</span>{{end}}{{if .Error}}<span class="truncate text-destructive" title="{{str .Error}}">{{truncate 80 (str .Error)}}</span>{{end}}</span>
    </li>
    {{end}}
  </ul>
</section>
{{end}}

{{if or $w.Files $w.Drafts}}
<section class="flex flex-col gap-2" aria-labelledby="work-files">
  <h2 id="work-files" class="eyebrow flex items-center gap-1.5">{{icon "file-text" "size-3.5"}}Files</h2>
  <ul class="flex flex-col gap-1 text-sm" data-files>
    {{range $w.Files}}
    <li class="flex items-center gap-1 rounded-md border px-3 py-2 hover:bg-accent" data-file="{{.ID}}">
      <a class="flex min-w-0 flex-1 items-center gap-2" {{template "preview_attrs" (printf "/chat/%v/files/%v" .ThreadID .ID)}}>{{template "file_icon" (dict "media_type" .MediaType)}}<span class="truncate">{{.Name}}</span><span class="badge shrink-0" data-variant="{{if eq .Origin "generated"}}secondary{{else}}outline{{end}}">{{lbl "file_origin" .Origin}}</span><span class="ms-auto shrink-0 text-xs text-muted-foreground tabular-nums">{{filesizeformat .Bytes}}</span></a>
      <a class="btn shrink-0" data-size="icon-sm" data-variant="ghost" href="/chat/{{.ThreadID}}/files/{{.ID}}/download" download aria-label="Download {{.Name}}">{{icon "download" "size-3.5"}}</a>
    </li>
    {{end}}
    {{range $w.Drafts}}
    <li><a class="flex items-center gap-2 rounded-md border px-3 py-2 hover:bg-accent" {{template "preview_attrs" (printf "/drafts/%v" (get . "id"))}}>{{icon "mail" "size-3.5 shrink-0 text-muted-foreground"}}<span class="truncate">{{or (get . "subject") "(no subject)"}}</span>{{$ds := get . "status"}}{{with badge "draft_status" $ds}}<span class="badge ms-auto shrink-0" data-variant="{{.Variant}}">{{.Label}}</span>{{else}}<span class="badge ms-auto shrink-0" data-variant="outline">{{$ds}}</span>{{end}}</a></li>
    {{end}}
  </ul>
</section>
{{end}}
{{- end}}
