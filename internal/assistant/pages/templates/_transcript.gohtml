{{template "chat_transcript" (dict "view" .Data.View "csrf" .CSRF)}}

{{define "chat_transcript"}}{{$v := .view}}{{$csrf := .csrf}}{{$t := $v.Thread}}{{$active := $v.Active}}{{$busy := and $active (eq $active.State "running")}}
{{range $v.Items}}{{template "chat_item" (dict "Item" . "thread" $t "last_seq" $v.LastOperatorSeq "busy" $busy "csrf" $csrf)}}{{end}}
{{range $v.Runs}}{{if and (eq .State "failed") (not .Superseded)}}
<li data-run="{{.ID}}">
  <div class="alert" data-variant="destructive" role="alert">
    {{icon "circle-alert"}}
    <p>Run {{.ID}} stopped: {{.Error}}</p>
    {{if and (eq $t.Kind "chat") (eq .ID (last $v.Runs).ID) $v.LastOperatorSeq (not $busy)}}
    <button type="button" class="btn" data-size="sm" data-variant="outline" hx-post="/chat/{{$t.ID}}/regenerate" hx-target="#transcript" hx-swap="innerHTML" hx-disabled-elt="this">{{icon "refresh-cw" "size-3.5"}}Try again</button>
    {{end}}
  </div>
</li>
{{end}}{{end}}
{{if not $v.Items}}
<li>{{template "empty_state" (dict "icon_name" "messages-square" "title" "Say something")}}</li>
{{end}}
{{if $busy}}
{{template "chat_run_live" (dict "thread_id" $t.ID "run_id" $active.ID "after" (ternary $v.Items (opt (last $v.Items) "seq" 0) 0))}}
{{else if and $active (eq $active.State "interrupted")}}
{{template "chat_interrupted" (dict "thread_id" $t.ID "run_id" $active.ID)}}
{{else if and $active (eq $active.State "parked")}}
{{if $v.Question}}{{template "chat_parked" (dict "thread_id" $t.ID "run_id" $active.ID "question" $v.Question "csrf" $csrf)}}{{end}}
{{end}}
{{range $v.Queued}}{{template "chat_item" (dict "Item" (dict "Kind" "queued" "ID" .ID "Text" .Text "Files" .Files))}}{{end}}
{{- end}}

{{define "chat_parked"}}
<li id="run-{{.run_id}}">
  <div class="flex flex-col gap-3 rounded-lg border border-clay/40 bg-card p-4" data-card="question">
    <p class="eyebrow flex items-center gap-1.5 text-clay">{{icon "messages-square" "size-3.5"}}Question</p>
    <p class="text-pretty">{{.question.Text}}</p>
    <form method="post" action="/chat/{{.thread_id}}/answer" hx-post="/chat/{{.thread_id}}/answer" hx-target="#transcript" hx-swap="innerHTML" hx-disabled-elt="find button[type=submit]" class="flex gap-2">
      <input type="hidden" name="csrf_token" value="{{.csrf}}">
      <input name="text" class="input" placeholder="Your answer" aria-label="Your answer" required autofocus>
      <button type="submit" class="btn" data-size="sm">Answer</button>
    </form>
  </div>
</li>
{{- end}}

{{define "chat_interrupted"}}
<li id="run-{{.run_id}}">
  <div class="alert" role="alert">
    {{icon "circle-alert"}}
    <p>This run was interrupted while a write was in flight. Resume to let the assistant check what happened and continue.</p>
    <button type="button" class="btn" data-size="sm" hx-post="/chat/{{.thread_id}}/runs/{{.run_id}}/resume" hx-target="#run-{{.run_id}}" hx-swap="outerHTML" hx-disabled-elt="this">{{icon "play"}}Resume</button>
  </div>
</li>
{{- end}}
