{{template "knowledge_record" .}}

{{define "knowledge_record"}}{{$d := .Data}}{{$r := $d.Record}}
<div id="kb-record">
<div class="flex flex-wrap items-center justify-between gap-2">
  <a href="/library/knowledge" class="btn" data-size="sm" data-variant="ghost">{{icon "arrow-left"}}Knowledge</a>
  <a href="/chat?about=knowledge:{{$r.ID}}" class="btn" data-size="sm" data-variant="outline">{{icon "messages-square"}}Ask about this</a>
</div>
<div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_--spacing(80)]">
  <article class="flex min-w-0 flex-col gap-4">
    <header class="flex flex-col gap-2">
      <h1 class="text-xl font-semibold">{{or $r.Title "Untitled"}}</h1>
      <div class="flex flex-wrap items-center gap-1.5 text-xs">
        <span class="badge" data-variant="outline">{{$r.Scope}}</span>
        <span class="badge" data-variant="outline">{{$r.Writer}}</span>
        {{if $r.Confirmed}}<span class="badge" data-variant="secondary">confirmed</span>{{end}}
        {{if $r.Pinned}}<span class="badge" data-variant="secondary">pinned</span>{{end}}
        {{if $r.Retracted}}<span class="badge" data-variant="outline">retracted</span>{{end}}
        {{if $r.Private}}<span class="badge" data-variant="outline">private</span>{{end}}
        {{range $d.Marks}}{{if .On}}<span class="badge" data-variant="outline">{{.Label}}</span>{{end}}{{end}}
        <span class="text-muted-foreground tabular-nums">{{template "when" (dict "epoch" $r.UpdatedAt "style" "datetime")}}</span>
      </div>
      {{if $d.Source}}
      <p class="text-xs text-muted-foreground">
        Source:
        {{if $d.Source.NotionID}}<a class="underline-offset-4 hover:underline" href="/notion/{{urlencode $d.Source.NotionID}}">{{$d.Source.Origin}}</a>
        {{else if $d.Source.ThreadID}}<a class="underline-offset-4 hover:underline" href="/chat/{{$d.Source.ThreadID}}{{if $d.Source.Seq}}#m{{$d.Source.Seq}}{{end}}">thread {{$d.Source.ThreadID}}{{if $d.Source.Seq}} message {{$d.Source.Seq}}{{end}}</a>
        {{else}}{{$d.Source.Origin}}{{end}}
      </p>
      {{end}}
      {{if $r.Aliases}}<p class="text-xs text-muted-foreground">Aliases: {{range $i, $a := $r.Aliases}}{{if $i}}, {{end}}{{$a}}{{end}}</p>{{end}}
    </header>
    <div class="whitespace-pre-wrap rounded-lg border bg-card p-4 text-sm leading-relaxed">{{$r.Body}}</div>
  </article>

  <aside class="flex flex-col gap-6 max-lg:border-t max-lg:pt-6" aria-label="Record actions">
    <section class="flex flex-wrap gap-2">
      {{if and (not $r.Confirmed) (not $r.Retracted)}}
      <form method="post" action="/library/knowledge/{{$r.ID}}/confirm" hx-post="/library/knowledge/{{$r.ID}}/confirm" hx-target="#kb-record" hx-swap="outerHTML">
        <input type="hidden" name="csrf_token" value="{{.CSRF}}">
        <button type="submit" class="btn" data-size="sm">{{icon "check"}}Confirm</button>
      </form>
      {{end}}
      {{if not $r.Retracted}}
      <form method="post" action="/library/knowledge/{{$r.ID}}/retract" hx-post="/library/knowledge/{{$r.ID}}/retract" hx-target="#kb-record" hx-swap="outerHTML">
        <input type="hidden" name="csrf_token" value="{{.CSRF}}">
        <input type="hidden" name="view" value="record">
        <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "x"}}Retract</button>
      </form>
      {{else}}
      <form method="post" action="/library/knowledge/{{$r.ID}}/restore" hx-post="/library/knowledge/{{$r.ID}}/restore" hx-target="#kb-record" hx-swap="outerHTML">
        <input type="hidden" name="csrf_token" value="{{.CSRF}}">
        <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "undo-2"}}Restore</button>
      </form>
      {{end}}
      <button type="button" class="btn" data-size="sm" data-variant="destructive"
              hx-get="/library/knowledge/{{$r.ID}}/purge" hx-target="#kb-purge" hx-swap="innerHTML">{{icon "trash-2"}}Purge</button>
    </section>
    <div id="kb-retract-result" aria-live="polite" class="empty:hidden"></div>

    <section class="flex flex-col gap-3 border-t pt-6" aria-labelledby="kb-edit-h">
      <h2 id="kb-edit-h" class="text-sm font-medium">Edit</h2>
      {{template "knowledge_form" (dict "form" $d.Form "csrf" .CSRF "target" "#kb-record" "swap" "outerHTML")}}
    </section>

    {{if $d.SameRun}}
    <section class="flex flex-col gap-2 border-t pt-6" aria-labelledby="kb-run-h">
      <h2 id="kb-run-h" class="text-sm font-medium">Same run</h2>
      <ul class="flex flex-col divide-y overflow-hidden rounded-lg border bg-card text-sm" role="list">
        {{range $d.SameRun}}
        <li class="flex items-center gap-2 px-3 py-2">
          <a class="min-w-0 flex-1 truncate underline-offset-4 hover:underline" href="/library/knowledge/{{.ID}}">{{or .Title "Untitled"}}</a>
          <form method="post" action="/library/knowledge/{{.ID}}/retract" hx-post="/library/knowledge/{{.ID}}/retract" hx-target="#kb-retract-result">
            <input type="hidden" name="csrf_token" value="{{$.CSRF}}">
            <button type="submit" class="btn" data-size="sm" data-variant="ghost">Retract</button>
          </form>
        </li>
        {{end}}
      </ul>
    </section>
    {{end}}

    <section class="flex flex-col gap-2 border-t pt-6" aria-labelledby="kb-history-h">
      <h2 id="kb-history-h" class="text-sm font-medium">History</h2>
      <ul class="flex flex-col gap-1 text-xs text-muted-foreground" role="list">
        {{range $d.History}}
        <li class="flex items-center gap-2">
          <span class="tabular-nums">{{template "when" (dict "epoch" .TS "style" "datetime")}}</span>
          <span>{{.Tool}}</span>
          {{if .UndoneAt}}<span class="badge" data-variant="outline">undone</span>{{end}}
        </li>
        {{end}}
      </ul>
    </section>
  </aside>
</div>

<dialog class="dialog" aria-label="Purge record">
  <div id="kb-purge" class="w-full sm:max-w-md"></div>
</dialog>
</div>
{{- end}}
