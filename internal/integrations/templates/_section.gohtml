{{define "integration_section"}}{{$s := .Section}}
{{if and (eq .Failed $s.Name) .Error (not .FieldError)}}<p class="text-sm text-destructive" role="alert" tabindex="-1" autofocus>{{.Error}}</p>{{end}}
<span class="font-medium">{{$s.Title}}</span>
{{if $s.Template}}{{partial $s.Template (dict "Section" $s "Fields" $s.Fields "Action" (printf "/settings/integrations/sections/%s" $s.Name) "CSRF" .CSRF "Error" .Error "FieldError" .FieldError)}}
{{else}}{{template "settings_fields" (dict "Fields" $s.Fields "Action" (printf "/settings/integrations/sections/%s" $s.Name) "CSRF" .CSRF)}}{{end}}
{{end}}
