{{define "title"}}Money{{end}}
{{define "heading"}}Money{{end}}
{{define "content"}}{{$d := .Data}}{{$csrf := .CSRF}}
{{template "money_nav" "/money"}}
<p class="text-sm text-muted-foreground">Bank alerts, receipts and statements read from your mail by a local model. TTD and BBD are shown side by side and never added together. Every automatic posting is on <a class="underline" href="/activity?category=money">Activity</a> with Undo.{{if $d.rates}} CBTT USD selling {{pystr (index $d.rates 0).selling}} (as of {{or (index $d.rates 0).as_of (index $d.rates 0).date}}).{{else}} No CBTT rate stored yet; foreign charges on the Republic card wait for the weekly fetch.{{end}}</p>

{{if not $d.accounts}}
{{template "empty_state" (dict "icon_name" "wallet" "title" "No accounts yet" "body" (partial "money_no_accounts_body" nil))}}
{{end}}

<section class="flex flex-col gap-3" aria-labelledby="spend-h">
  <h2 id="spend-h" class="text-sm font-medium">{{$d.month}} by category</h2>
  {{if $d.spending}}
  <div class="grid gap-4 md:grid-cols-2">
    {{range $s := items $d.spending}}{{$currency := $s.Key}}{{$bucket := $s.Value}}
    <div class="rounded-lg border bg-card p-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-medium">{{$currency}}</h3>
        <span class="text-sm font-medium">{{template "money_value" (dict "value" $bucket.total "currency" $currency)}}</span>
      </div>
      <table class="mt-2 w-full text-sm">
        <tbody>
          {{range $g := $bucket.groups}}
          <tr><td class="py-1">{{$g.name}} <span class="text-xs text-muted-foreground">({{$g.count}})</span></td><td class="py-1 text-right">{{template "money_value" (dict "value" $g.total "currency" $currency)}}</td></tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{end}}
  </div>
  {{else}}
  {{template "empty_state" (dict "icon_name" "receipt" "title" "Nothing posted this month" "body" (partial "money_nothing_posted_body" nil))}}
  {{end}}
</section>

<section class="flex flex-col gap-3" aria-labelledby="unassigned-h">
  <h2 id="unassigned-h" class="text-sm font-medium">Needs an account or a look ({{len $d.unassigned}})</h2>
  {{if $d.unassigned}}
  <ul class="flex flex-col gap-3" role="list" aria-label="Unassigned transactions">
    {{range $t := $d.unassigned}}
    <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border bg-card p-4">
      <div class="flex min-w-0 flex-col gap-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm font-medium">{{$t.display_payee}}</span>
          {{template "money_kind_badge" $t.kind}}
          {{if $t.review}}<span class="badge border-warning/30 bg-warning/10 text-warning">{{$t.review}}</span>{{end}}
        </div>
        <p class="text-xs text-muted-foreground"><span class="tabular-nums">{{$t.date}}</span> · {{template "money_amount" $t}}{{if $t.account}} · {{$t.account}}{{end}}{{if $t.description}} · {{$t.description}}{{end}}{{if $t.message_id}} · <a class="underline" href="/messages/{{$t.message_id}}">source mail</a>{{end}}</p>
      </div>
      {{if $d.accounts}}{{template "money_assign_form" (dict "tx" $t "accounts" $d.accounts "back" "overview" "csrf" $csrf)}}{{end}}
    </li>
    {{end}}
  </ul>
  {{else}}
  {{template "empty_state" (dict "icon_name" "check" "title" "Everything is assigned" "body" "Alerts whose bank sender and last four digits match no account land here.")}}
  {{end}}
</section>

<section class="flex flex-col gap-3" aria-labelledby="bills-h">
  <h2 id="bills-h" class="text-sm font-medium">Bills expected in the next 14 days ({{len $d.bills}})</h2>
  {{if $d.bills}}
  <ul class="flex flex-col gap-2" role="list" aria-label="Upcoming bills">
    {{range $b := $d.bills}}
    <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border bg-card px-4 py-2 text-sm">
      <span>{{$b.payee}} <span class="badge" data-variant="outline">{{$b.cadence}}</span></span>
      <span class="text-xs text-muted-foreground tabular-nums">{{$b.next_expected}} (in {{$b.days_until}} days) · {{range $i, $c := items $b.typical}}{{if $i}}, {{end}}{{printf "%.2f" (mul $c.Value 1)}} {{$c.Key}}{{end}}</span>
    </li>
    {{end}}
  </ul>
  {{else}}
  <p class="text-sm text-muted-foreground">None expected. See <a class="underline" href="/money/bills">Bills</a> for the full list.</p>
  {{end}}
</section>
{{end}}
