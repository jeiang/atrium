{{define "title"}}Transactions{{end}}
{{define "heading"}}Money · Transactions{{end}}
{{define "content"}}{{$d := .Data}}{{$csrf := .CSRF}}{{$f := $d.filters}}
{{template "money_nav" "/money/transactions"}}
<form method="get" action="/money/transactions" class="flex flex-wrap items-end gap-2 rounded-lg border bg-card p-4 text-sm">
  <label class="flex flex-col gap-1 text-xs">From<input class="input" type="date" name="start" value="{{$f.start}}"></label>
  <label class="flex flex-col gap-1 text-xs">To<input class="input" type="date" name="end" value="{{$f.end}}"></label>
  <label class="flex flex-col gap-1 text-xs">Account
    <select class="select" name="account_id"><option value="">Any</option>{{range $a := $d.accounts}}<option value="{{$a.id}}"{{if eq $a.id $f.account_id}} selected{{end}}>{{$a.name}}</option>{{end}}</select>
  </label>
  <label class="flex flex-col gap-1 text-xs">Payee<input class="input" type="text" name="payee" value="{{$f.payee}}" placeholder="contains"></label>
  <label class="flex flex-col gap-1 text-xs">Category
    <select class="select" name="category"><option value="">Any</option>{{range $c := $d.categories}}<option value="{{$c.name}}"{{if eq $c.name $f.category}} selected{{end}}>{{$c.name}}</option>{{end}}</select>
  </label>
  <label class="flex flex-col gap-1 text-xs">Kind
    <select class="select" name="kind"><option value="">Any</option>{{range $k := $d.kinds}}<option value="{{$k}}"{{if eq $k $f.kind}} selected{{end}}>{{replace "_" " " $k}}</option>{{end}}</select>
  </label>
  <label class="flex flex-col gap-1 text-xs">Currency
    <select class="select" name="currency"><option value="">Any</option>{{range $c := list "TTD" "BBD"}}<option value="{{$c}}"{{if eq $c $f.currency}} selected{{end}}>{{$c}}</option>{{end}}</select>
  </label>
  <label class="flex h-8 items-center gap-2 text-xs"><input class="input" type="checkbox" name="unassigned" value="true"{{if $f.unassigned}} checked{{end}}>Unassigned or flagged</label>
  <label class="flex h-8 items-center gap-2 text-xs"><input class="input" type="checkbox" name="dismissed" value="true"{{if $f.dismissed}} checked{{end}}>Dismissed only</label>
  <button type="submit" class="btn" data-size="sm">{{icon "search"}}Filter</button>
</form>

{{if $d.transactions}}
<form method="post" action="/money/transactions/merge" class="flex flex-col gap-3">
  <input type="hidden" name="csrf_token" value="{{$csrf}}">
  <div class="flex items-center justify-between gap-2">
    <p class="text-sm text-muted-foreground">{{len $d.transactions}} transactions. Tick two or more that describe one purchase and merge them.</p>
    <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "merge"}}Merge selected</button>
  </div>
  <ul class="flex flex-col gap-2" role="list" aria-label="Transactions">
    {{range $t := $d.transactions}}
    <li class="flex flex-wrap items-start gap-3 rounded-lg border bg-card p-3{{if $t.is_transfer}} opacity-80{{end}}">
      <input type="checkbox" name="transaction_ids" value="{{$t.id}}" class="input mt-1" aria-label="Select transaction {{$t.id}}">
      <div class="flex min-w-0 flex-1 flex-col gap-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs text-muted-foreground tabular-nums">{{$t.date}}</span>
          <span class="text-sm font-medium">{{$t.display_payee}}</span>
          {{template "money_kind_badge" $t.kind}}
          {{if $t.category}}<span class="badge" data-variant="outline">{{$t.category}}</span>{{end}}
          {{if gt $t.source_count 1}}<span class="badge" data-variant="secondary">{{$t.source_count}} sources</span>{{end}}
          {{if $t.transfer_id}}<span class="badge" data-variant="outline">linked #{{$t.transfer_id}}</span>{{end}}
          {{if $t.review}}<span class="badge max-w-full border-warning/30 bg-warning/10 text-warning" title="{{$t.review}}"><span class="truncate">{{$t.review}}</span></span>{{end}}
          {{if $t.dismissed}}<span class="badge max-w-full" data-variant="secondary" title="Dismissed: {{$t.dismissed}}"><span class="truncate">dismissed: {{$t.dismissed}}</span></span>{{end}}
        </div>
        <p class="text-xs text-muted-foreground">{{template "money_amount" $t}} · {{or $t.account "no account"}}{{if $t.description}} · {{$t.description}}{{end}}{{if $t.message_id}} · <a class="underline" href="/messages/{{$t.message_id}}">source mail</a>{{end}} · #{{$t.id}}</p>
        <details class="group/edit text-xs">
          <summary class="inline-flex gap-1 rounded-sm text-muted-foreground hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
            {{icon "chevron-down" "size-3.5 transition-transform group-open/edit:rotate-180"}}Edit
          </summary>
          <div class="mt-2 flex flex-wrap items-end gap-x-4 gap-y-2">
            {{if ne $t.kind "fx_adjustment"}}
            <div class="flex items-end gap-2">
              <label class="flex flex-col gap-1">Charged in
                <select name="currency" form="tx-{{$t.id}}-currency" class="select" aria-label="Charged in, transaction {{$t.id}}">
                  {{range $c := $d.currencies}}<option value="{{$c}}"{{if eq $c $t.original_currency}} selected{{end}}>{{$c}}</option>{{end}}
                </select>
              </label>
              <button type="submit" form="tx-{{$t.id}}-currency" class="btn" data-size="sm" data-variant="outline">Set currency</button>
            </div>
            {{end}}
            {{if $t.dismissed}}
            <button type="submit" form="tx-{{$t.id}}-restore" class="btn" data-size="sm" data-variant="outline">{{icon "undo-2"}}Restore</button>
            {{else}}
            <div class="flex min-w-0 items-end gap-2">
              <label class="flex min-w-0 flex-col gap-1">Dismiss reason
                <input name="reason" form="tx-{{$t.id}}-dismiss" class="input w-64 max-w-full" type="text" maxlength="80" placeholder="not mine, duplicate" aria-label="Dismiss reason, transaction {{$t.id}}">
              </label>
              <button type="submit" form="tx-{{$t.id}}-dismiss" class="btn" data-size="sm" data-variant="outline">{{icon "x"}}Dismiss</button>
            </div>
            {{end}}
          </div>
        </details>
      </div>
    </li>
    {{end}}
  </ul>
</form>
{{range $t := $d.transactions}}
{{range $action := list "currency" "dismiss" "restore"}}
<form id="tx-{{$t.id}}-{{$action}}" method="post" action="/money/transactions/{{$t.id}}/{{$action}}" hidden><input type="hidden" name="csrf_token" value="{{$csrf}}"></form>
{{end}}
{{end}}
<section class="flex flex-col gap-3" aria-labelledby="edit-h">
  <h2 id="edit-h" class="text-sm font-medium">Edit a transaction</h2>
  <ul class="flex flex-col gap-2" role="list" aria-label="Transaction actions">
    {{$n := 0}}
    {{range $t := $d.transactions}}{{if or (gt $t.source_count 1) (isnil $t.account_id) $t.review}}{{$n = inc $n}}
    <li class="flex flex-wrap items-center gap-3 rounded-lg border bg-card px-3 py-2 text-sm">
      <span class="text-xs text-muted-foreground">#{{$t.id}} {{$t.display_payee}}</span>
      {{if gt $t.source_count 1}}
      <form method="post" action="/money/transactions/{{$t.id}}/split">
        <input type="hidden" name="csrf_token" value="{{$csrf}}">
        <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "split"}}Split</button>
      </form>
      {{end}}
      {{if and $d.accounts (ne $t.kind "fx_adjustment")}}{{template "money_assign_form" (dict "tx" $t "accounts" $d.accounts "back" "transactions" "csrf" $csrf)}}{{end}}
      <form method="post" action="/money/transactions/{{$t.id}}/category" class="flex items-center gap-2">
        <input type="hidden" name="csrf_token" value="{{$csrf}}">
        <select name="category_id" class="select" aria-label="Category for transaction {{$t.id}}">
          <option value="">Payee's category</option>
          {{range $c := $d.categories}}<option value="{{$c.id}}"{{if eq $c.id $t.category_id}} selected{{end}}>{{$c.name}}</option>{{end}}
        </select>
        <button type="submit" class="btn" data-size="sm" data-variant="outline">Set category</button>
      </form>
    </li>
    {{end}}{{end}}
    {{if eq $n 0}}
    <li class="text-sm text-muted-foreground">Merged, unassigned or flagged transactions get split, assign and category controls here.</li>
    {{end}}
  </ul>
</section>
{{else}}
{{template "empty_state" (dict "icon_name" "receipt" "title" "No transactions match" "body" "Loosen the filters, or wait for the next mail pass.")}}
{{end}}
{{end}}
