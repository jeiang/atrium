{{define "money_nav"}}<nav class="button-group" aria-label="Money pages">
  {{$current := .}}{{range $p := list (list "/money" "Overview") (list "/money/transactions" "Transactions") (list "/money/payees" "Payees") (list "/money/bills" "Bills") (list "/money/accounts" "Accounts")}}
  <a class="btn" data-size="sm" data-variant="{{if eq $current (index $p 0)}}secondary{{else}}outline{{end}}" href="{{index $p 0}}"{{if eq $current (index $p 0)}} aria-current="page"{{end}}>{{index $p 1}}</a>
  {{end}}
</nav>{{end}}

{{define "money_value"}}{{if isnil .value}}<span class="text-muted-foreground">—</span>{{else}}<span class="tabular-nums">{{printf "%.2f" (mul .value 1)}} {{.currency}}</span>{{end}}{{end}}

{{define "money_amount"}}{{if not (isnil .amount)}}{{template "money_value" (dict "value" .amount "currency" .currency)}}{{if or (ne .original_currency .currency) (ne (mul .original_amount 1) (mul .amount 1))}} <span class="text-xs text-muted-foreground">(paid {{printf "%.2f" (mul .original_amount 1)}} {{.original_currency}}{{if not (isnil .computed_amount)}}, computed {{printf "%.2f" (mul .computed_amount 1)}} {{.currency}}{{end}})</span>{{end}}{{else}}{{template "money_value" (dict "value" .original_amount "currency" .original_currency)}} <span class="text-xs text-muted-foreground">(unresolved)</span>{{end}}{{end}}

{{define "money_kind_badge"}}<span class="badge" data-variant="{{if or (eq . "transfer") (eq . "card_payment")}}secondary{{else}}outline{{end}}">{{replace "_" " " .}}</span>{{end}}

{{define "money_assign_form"}}<form method="post" action="/money/transactions/{{.tx.id}}/account" class="flex min-w-0 max-w-full items-center gap-2">
  <input type="hidden" name="csrf_token" value="{{.csrf}}">
  <input type="hidden" name="back" value="{{.back}}">
  <select name="account_id" class="select min-w-0" aria-label="Account for transaction {{.tx.id}}">
    {{range $a := .accounts}}<option value="{{$a.id}}"{{if eq $a.id $.tx.account_id}} selected{{end}}>{{$a.name}} ({{$a.currency}})</option>{{end}}
  </select>
  <button type="submit" class="btn" data-size="sm" data-variant="outline">Assign</button>
</form>{{end}}

{{define "money_no_accounts_body"}}Add your bank accounts and cards on <a class="underline" href="/money/accounts">Accounts</a> so alerts can be matched.{{end}}

{{define "money_nothing_posted_body"}}Transactions appear after the next mail pass or <code>atrium money refresh</code>.{{end}}
