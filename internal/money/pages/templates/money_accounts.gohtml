{{define "title"}}Accounts{{end}}
{{define "heading"}}Money · Accounts{{end}}
{{define "content"}}{{$d := .Data}}{{$csrf := .CSRF}}
{{template "money_nav" "/money/accounts"}}
<p class="text-sm text-muted-foreground">Alerts map to an account by the bank's sender address and the last four digits in the mail. Only forex-enabled accounts take charges in another currency: a TTD account converts USD at the CBTT selling rate and BBD at half of it; a BBD account converts USD at 2.00 × 1.02 and TTD through the CBTT rate. An amount the alert states in the account currency wins over the conversion. Foreign charges on other accounts are flagged.</p>

{{if $d.accounts}}
<ul class="flex flex-col gap-3" role="list" aria-label="Accounts">
  {{range $a := $d.accounts}}
  <li class="flex flex-col gap-2 rounded-lg border bg-card p-4">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-sm font-medium">{{$a.name}}</span>
      <span class="badge" data-variant="outline">{{$a.bank_label}}</span>
      <span class="badge" data-variant="outline">{{replace "_" " " $a.kind}}</span>
      <span class="badge" data-variant="secondary">{{$a.currency}}</span>
      {{if $a.forex}}<span class="badge" data-variant="outline">forex</span>{{end}}
      {{if $a.last4}}<span class="font-mono text-xs text-muted-foreground">…{{$a.last4}}</span>{{end}}
      <span class="text-xs text-muted-foreground">#{{$a.id}}</span>
    </div>
    <form method="post" action="/money/accounts/{{$a.id}}" class="flex flex-wrap items-end gap-2 text-sm">
      <input type="hidden" name="csrf_token" value="{{$csrf}}">
      <label class="flex flex-col gap-1 text-xs">Name<input class="input" type="text" name="name" value="{{$a.name}}" maxlength="60" required></label>
      <label class="flex flex-col gap-1 text-xs">Last 4<input class="input w-20" type="text" name="last4" value="{{$a.last4}}" maxlength="4" inputmode="numeric"></label>
      <label class="flex flex-col gap-1 text-xs">Alert senders (domains or addresses, comma separated)<input class="input w-80" type="text" name="sender_patterns" value="{{join ", " $a.sender_patterns}}"></label>
      <label class="flex h-8 items-center gap-2 text-xs"><input class="input" type="checkbox" name="forex" value="1"{{if $a.forex}} checked{{end}}>Forex enabled</label>
      <button type="submit" class="btn" data-size="sm" data-variant="outline">Save</button>
    </form>
    <form method="post" action="/money/accounts/{{$a.id}}/delete" data-confirm-submit="Remove {{$a.name}}? Only possible while it has no transactions.">
      <input type="hidden" name="csrf_token" value="{{$csrf}}">
      <button type="submit" class="btn" data-size="sm" data-variant="ghost">{{icon "trash-2"}}Remove</button>
    </form>
  </li>
  {{end}}
</ul>
{{else}}
{{template "empty_state" (dict "icon_name" "wallet" "title" "No accounts yet" "body" "Add each bank account and card once; alerts from those banks are then posted automatically.")}}
{{end}}

<section class="flex flex-col gap-3" aria-labelledby="add-h">
  <h2 id="add-h" class="text-sm font-medium">Add an account</h2>
  <form method="post" action="/money/accounts" class="flex flex-wrap items-end gap-2 rounded-lg border bg-card p-4 text-sm">
    <input type="hidden" name="csrf_token" value="{{$csrf}}">
    <label class="flex flex-col gap-1 text-xs">Bank
      <select class="select" name="bank" required>{{range $b := items $d.banks}}<option value="{{$b.Key}}">{{$b.Value}}</option>{{end}}</select>
    </label>
    <label class="flex flex-col gap-1 text-xs">Name<input class="input" type="text" name="name" maxlength="60" required placeholder="e.g. FCB chequing"></label>
    <label class="flex flex-col gap-1 text-xs">Kind
      <select class="select" name="kind">{{range $k := $d.kinds}}<option value="{{$k}}">{{replace "_" " " $k}}</option>{{end}}</select>
    </label>
    <label class="flex flex-col gap-1 text-xs">Currency
      <select class="select" name="currency">{{range $c := $d.currencies}}<option value="{{$c}}">{{$c}}</option>{{end}}</select>
    </label>
    <label class="flex flex-col gap-1 text-xs">Last 4<input class="input w-20" type="text" name="last4" maxlength="4" inputmode="numeric"></label>
    <label class="flex flex-col gap-1 text-xs">Alert senders (blank = bank default: {{range $i, $s := items $d.default_senders}}{{if $i}}; {{end}}{{get $d.banks $s.Key}} {{join "/" $s.Value}}{{end}})<input class="input w-80" type="text" name="sender_patterns"></label>
    <label class="flex h-8 items-center gap-2 text-xs"><input class="input" type="checkbox" name="forex" value="1">Forex enabled</label>
    <button type="submit" class="btn" data-size="sm">{{icon "plus"}}Add account</button>
  </form>
</section>

<section class="flex flex-col gap-3" aria-labelledby="since-h">
  <h2 id="since-h" class="text-sm font-medium">Track spending from</h2>
  <form method="post" action="/money/since" class="flex flex-wrap items-end gap-2 rounded-lg border bg-card p-4 text-sm">
    <input type="hidden" name="csrf_token" value="{{$csrf}}">
    <label class="flex flex-col gap-1 text-xs">Before this date only bill charges count (blank = all history)<input class="input w-44" type="date" name="since" value="{{or $d.since ""}}"></label>
    <button type="submit" class="btn" data-size="sm">Save</button>
  </form>
</section>

<section class="flex flex-col gap-3" aria-labelledby="dismiss-h">
  <h2 id="dismiss-h" class="text-sm font-medium">Dismiss old transactions</h2>
  <p class="text-xs text-muted-foreground">Dismissed transactions are left out of lists, spending and bills. Restore one from Transactions with Dismissed only ticked, or undo the whole batch from Activity.</p>
  <form method="post" action="/money/transactions/dismiss-before" class="flex flex-wrap items-end gap-2 rounded-lg border bg-card p-4 text-sm" data-confirm-submit="Dismiss every transaction before this date? Undo it from Activity.">
    <input type="hidden" name="csrf_token" value="{{$csrf}}">
    <label class="flex flex-col gap-1 text-xs">Dated before<input class="input w-44" type="date" name="before" required></label>
    <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "x"}}Dismiss</button>
  </form>
</section>

<section class="flex flex-col gap-3" aria-labelledby="rates-h">
  <div class="flex items-center justify-between gap-2">
    <h2 id="rates-h" class="text-sm font-medium">CBTT USD selling rate</h2>
    <form method="post" action="/money/rates/fetch">
      <input type="hidden" name="csrf_token" value="{{$csrf}}">
      <button type="submit" class="btn" data-size="sm" data-variant="outline">{{icon "globe"}}Fetch now</button>
    </form>
  </div>
  {{if $d.rates}}
  <table class="w-full text-sm"><thead><tr class="text-left text-xs text-muted-foreground"><th>Stored</th><th>As of</th><th>Selling</th></tr></thead><tbody>
    {{range $r := $d.rates}}<tr><td class="tabular-nums">{{$r.date}}</td><td class="tabular-nums">{{or $r.as_of "—"}}</td><td class="tabular-nums">{{pystr $r.selling}}</td></tr>{{end}}
  </tbody></table>
  {{else}}
  <p class="text-sm text-muted-foreground">No rate stored yet. The weekly <code>fx-rates</code> job fetches it; Fetch now does it immediately.</p>
  {{end}}
</section>
{{end}}
