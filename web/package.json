{
  "name": "atrium-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "gen": "orval --config orval.config.ts",
    "dev": "npm run gen && npm run tokens && vite --mode mock",
    "build": "npm run gen && npm run tokens && vite build",
    "build:mock": "npm run gen && npm run tokens && vite build --mode mock",
    "check": "npm run gen && npm run tokens && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/worker",
    "lint": "npm run gen && npm run tokens && biome check --error-on-warnings . && node scripts/lint-commands.ts && node scripts/settings-placement.ts",
    "format": "biome check --write .",
    "e2e": "playwright test",
    "tokens": "node scripts/tokens.ts"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/fira-mono": "5.3.0",
    "@tanstack/svelte-query": "6.4.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-autolink-literal": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-gfm-table": "2.0.1",
    "micromark": "4.0.3",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-util-sanitize-uri": "2.0.1",
    "sv-router": "0.19.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "lighthouse": "13.6.0",
    "msw": "3.0.4",
    "orval": "8.47.0",
    "playwright-core": "1.63.0",
    "style-dictionary": "5.8.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
