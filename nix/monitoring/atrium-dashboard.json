{
  "title": "atrium",
  "uid": "atrium-overview",
  "editable": false,
  "schemaVersion": 39,
  "tags": ["atrium"],
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(atrium_budget_monthly_usd, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(atrium_budget_monthly_usd{job=~\"$job\"}, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Budget spent",
      "description": "Share of the monthly assistant budget spent this month.",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "atrium_budget_spent_ratio{job=~\"$job\", instance=~\"$instance\"}"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spend",
      "description": "Assistant spend this month and the monthly budget.",
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "atrium_budget_spent_usd{job=~\"$job\", instance=~\"$instance\"}", "legendFormat": "spent"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "atrium_budget_monthly_usd{job=~\"$job\", instance=~\"$instance\"}", "legendFormat": "budget"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Readiness",
      "description": "1 when the readiness check passes, 0 when it fails.",
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "bool"}, "overrides": []},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "atrium_readiness_check_ok{job=~\"$job\", instance=~\"$instance\"}", "legendFormat": "{{check}}"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Time since last successful pass",
      "description": "Seconds since each oneshot pass last succeeded.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "time() - atrium_job_last_success_timestamp_seconds{job=~\"$job\", instance=~\"$instance\"}", "legendFormat": "{{pass}}"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Stale passes",
      "description": "1 when a pass's last run failed or its last success is older than its limit.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "bool"}, "overrides": []},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "atrium_job_stale{job=~\"$job\", instance=~\"$instance\"}", "legendFormat": "{{pass}}"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Database lock waits",
      "description": "Exclusive database lock acquisitions that waited or timed out, per second.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (instance) (rate(atrium_db_exclusive_waits_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "waits"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (instance) (rate(atrium_db_exclusive_timeouts_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "timeouts"}
      ]
    }
  ]
}
