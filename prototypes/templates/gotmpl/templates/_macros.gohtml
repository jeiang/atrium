{{/* Macros from _macros.html. Convention: one {{define}} per macro; a single-argument macro takes its argument
     as dot, a multi-argument macro takes a dict (see `dict`). Template names are global: no namespacing. */}}

{{define "mode_badge" -}}
{{if and (eq .mode "live") .paused -}}
<span class="badge border-warning/30 bg-warning/10 text-warning">{{icon "lock"}}Live, paused</span>
{{- else if eq .mode "live" -}}
<span class="badge" data-variant="destructive">{{icon "zap"}}Live</span>
{{- else -}}
<span class="badge border-warning/30 bg-warning/10 text-warning">{{icon "eye-off"}}Shadow</span>
{{- end}}
{{- end}}

{{define "mode_note" -}}
{{if and (eq .mode "live") .paused -}}
Paused: routing is recorded but no mail is changed. Resume to apply it.
{{- else if eq .mode "live" -}}
Live mode: atrium files read mail, flags unread mail from your contacts and trashes mail your deletion rules match.
{{- else -}}
Shadow mode: nothing is changed automatically. Proposals you approve still run.
{{- end}}
{{- end}}

{{define "action_badge" -}}
{{$vl := split2 (lbl "action_badge" .status)}}
<span class="badge" data-variant="{{index $vl 0}}"{{if .error}} title="{{.error}}"{{end}}>{{index $vl 1}}</span>
{{- end}}

{{define "stage_label"}}{{lbl "stage" .}}{{end}}

{{define "stage_badge" -}}
<span class="badge" data-variant="outline"><span class="size-2 rounded-full {{lbl "stage_dot" . "bg-chart-6"}}" aria-hidden="true"></span>{{template "stage_label" .}}</span>
{{- end}}

{{define "pct"}}{{printf "%.0f%%" (fmul . 100)}}{{end}}

{{/* reason(d): reads the global `mode` in Jinja; here it must be passed in explicitly. */}}
{{define "reason" -}}
{{- $d := .d -}}{{- $detail := or $d.detail (dict) -}}
{{- if eq $d.stage "correction" -}}Recorded by you as a correction.{{if ne .mode "live"}} Shadow mode leaves the message where it is.{{end}}
{{- else if eq $d.stage "operator" -}}Rule <code class="font-mono">{{$d.key}}</code> matched first.
{{- else if eq $d.stage "learned" -}}{{template "pct" $d.confidence}} of {{$detail.n}} filed messages with this {{lbl "level" $d.key}} went here.
{{- else if eq $d.stage "knn" -}}The most similar filed messages vote {{template "pct" $d.confidence}} for this destination.
{{- else if eq $d.stage "llm" -}}The 9B chose this {{if $detail.confident}}and was confident{{else}}but was not confident{{end}}.
{{- else -}}No stage was sure, so the fallback applies.
{{- end -}}
{{- end}}

{{define "place" -}}
{{- if isnil . -}}Gone
{{- else if eq . "INBOX" -}}Inbox
{{- else -}}{{replace "|" " · " .}}
{{- end -}}
{{- end}}

{{define "proposal" -}}
{{- if eq .action "delete" -}}Delete
{{- else if or (eq .action "none") (not .dest) -}}Leave in inbox
{{- else -}}{{.dest}}
{{- end -}}
{{- end}}

{{define "agreement" -}}
{{if eq . "agree" -}}
<span class="inline-flex items-center gap-1 text-success">{{icon "check" "size-3.5"}}Matches</span>
{{- else if eq . "disagree" -}}
<span class="inline-flex items-center gap-1 text-warning">{{icon "equal-not" "size-3.5"}}Differs</span>
{{- else if eq . "pending" -}}
<span class="inline-flex items-center gap-1 text-muted-foreground">{{icon "inbox" "size-3.5"}}In inbox</span>
{{- else -}}
<span class="inline-flex items-center gap-1 text-muted-foreground">{{icon "x" "size-3.5"}}Gone</span>
{{- end}}
{{- end}}

{{define "noun"}}{{if eq . "gmail"}}label{{else}}folder{{end}}{{end}}

{{define "sender"}}{{or .from_name .from_addr "Unknown sender"}}{{end}}

{{/* open_attrs / preview_attrs / external emit attribute text; called from inside an open tag. */}}
{{define "open_attrs" -}}
href="/messages/{{.}}" hx-get="/messages/{{.}}" hx-target="#reader-body" hx-swap="innerHTML show:top"
{{- end}}

{{define "preview_attrs" -}}
href="{{.}}" hx-get="{{.}}" hx-target="#preview-body" hx-swap="innerHTML show:top"
{{- end}}

{{define "external" -}}
href="{{.}}" target="_blank" rel="noopener noreferrer"
{{- end}}

{{define "when" -}}
{{- if .epoch -}}<time datetime="{{ts .epoch "iso"}}">{{ts .epoch (or .style "date")}}</time>{{- end -}}
{{- end}}

{{define "account_switch" -}}
<nav class="button-group" aria-label="{{or .label "Account"}}">
  <a class="btn" data-size="sm" data-variant="{{if not .current}}secondary{{else}}outline{{end}}" href="{{.path}}"{{if not .current}} aria-current="page"{{end}}>All accounts</a>
  {{- $current := .current}}{{$path := .path}}
  {{range accounts}}
  <a class="btn" data-size="sm" data-variant="{{if eq $current .}}secondary{{else}}outline{{end}}" href="{{$path}}?account={{.}}"{{if eq $current .}} aria-current="page"{{end}}>{{.}}</a>
  {{- end}}
</nav>
{{- end}}

{{define "folder_options" -}}
{{$sel := .selected}}
{{range .folders}}
<option value="{{.folder}}"{{if eq .folder $sel}} selected{{end}}>{{.folder}}</option>
{{end}}
{{- end}}

{{/* empty_state uses caller(): the caller body arrives as a pre-rendered template.HTML in .body. */}}
{{define "empty_state" -}}
<div class="empty border">
  <header>
    <figure>{{icon .icon}}</figure>
    <h3>{{.title}}</h3>
    {{if .body}}<p>{{.body}}</p>{{end}}
  </header>
</div>
{{- end}}

{{define "condition_text" -}}
{{- $value := .value -}}
<span class="font-medium">{{lbl "field" .field}}</span>
<span class="text-muted-foreground">{{lbl "op" .op}}</span>
{{- if not (blank $value)}}
<code class="rounded-sm bg-muted px-1 py-0.5 font-mono text-xs break-all">{{if isslice $value}}{{join ", " $value}}{{else}}{{$value}}{{end}}</code>
{{- end}}
{{- end}}

{{define "spinner" -}}
<span id="{{.id}}" class="htmx-indicator inline-flex text-muted-foreground" role="status" aria-label="{{or .label "Loading"}}">{{icon "loader-circle" "size-4 animate-spin"}}</span>
{{- end}}

{{define "status_badge" -}}
{{if eq . "applied" -}}
<span class="badge border-success/30 bg-success/10 text-success">{{icon "check"}}{{lbl "status" .}}</span>
{{- else if eq . "failed" -}}
<span class="badge" data-variant="destructive">{{icon "circle-alert"}}{{lbl "status" .}}</span>
{{- else if eq . "approved" -}}
<span class="badge" data-variant="outline">{{icon "loader-circle" "animate-spin"}}{{lbl "status" .}}</span>
{{- else if eq . "pending" -}}
<span class="badge" data-variant="outline">{{lbl "status" .}}</span>
{{- else -}}
<span class="badge" data-variant="secondary">{{lbl "status" .}}</span>
{{- end}}
{{- end}}

{{define "pending_badge" -}}
<span id="pending-count" class="badge ms-auto empty:hidden" data-variant="secondary"{{if .oob}} hx-swap-oob="true"{{end}}>{{if .count}}{{.count}}<span class="sr-only"> pending</span>{{end}}</span>
{{- end}}

{{define "page_path" -}}
{{- range $i, $c := . -}}{{$c.title}}{{if lt (add $i 1) (len $)}} / {{end}}{{- end -}}
{{- end}}

{{define "page_link" -}}
<a class="rounded-sm font-medium underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring {{.class}}" href="/notion/{{urlencode .ref.id}}">{{or .ref.title "Untitled"}}</a>
{{- end}}

{{define "run_badge" -}}
{{with lbl "run_badge" . ""}}{{$vl := split2 .}}<span class="badge" data-variant="{{index $vl 0}}">{{if eq $ "running"}}{{icon "loader-circle" "animate-spin"}}{{end}}{{index $vl 1}}</span>{{end}}
{{- end}}

{{define "branch_button" -}}
<form method="post" action="/chat/{{.thread.id}}/branch" class="inline">
  <input type="hidden" name="csrf_token" value="{{csrf_token}}">
  <input type="hidden" name="seq" value="{{.seq}}">
  <button type="submit" class="btn" data-size="sm" data-variant="ghost" title="Start a new thread with the conversation up to here">{{icon "git-branch" "size-3.5"}}Branch</button>
</form>
{{- end}}

{{define "file_icon" -}}
{{icon (ternary (hasprefix .media_type "image/") "image" "file-text") (or .class "size-3.5 shrink-0 text-muted-foreground")}}
{{- end}}

{{define "file_chips" -}}
{{if .files}}
{{$tid := .thread_id}}
<ul class="flex flex-wrap gap-1" aria-label="Attached files" data-attachments>
  {{range .files}}<li><a class="badge max-w-64" data-variant="outline" {{template "preview_attrs" (printf "/chat/%v/files/%v" $tid .id)}}>{{template "file_icon" (dict "media_type" .media_type "class" "size-3")}}<span class="truncate">{{.name}}</span></a></li>{{end}}
</ul>
{{end}}
{{- end}}

{{define "attach_field" -}}
<input type="file" name="upload" multiple class="sr-only" tabindex="-1" data-upload>
<ul class="flex flex-wrap gap-1 empty:hidden" aria-label="Files to send" data-chips></ul>
{{- end}}

{{define "attach_button" -}}
<button type="button" class="btn" data-size="sm" data-variant="ghost" data-action="pick-files" title="Attach files: PDF, images, text, CSV, docx, xlsx">{{icon "paperclip" "size-3.5"}}Attach</button>
{{- end}}

{{define "activity_step" -}}
{{if eq .kind "thinking"}}
<li class="flex gap-2" data-step="thinking">{{icon "brain" "mt-0.5 size-3.5 shrink-0"}}<div class="min-w-0 whitespace-pre-wrap break-words text-muted-foreground">{{.text}}</div></li>
{{else if eq .kind "note"}}
<li class="flex gap-2" data-step="note">{{icon "bot" "mt-0.5 size-3.5 shrink-0"}}<div class="markdown min-w-0">{{markdown .text}}</div></li>
{{else if eq .kind "tool"}}
<li data-step="tool" data-tool-id="{{.id}}">
  <details class="rounded-md border bg-card">
    <summary class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-muted-foreground">
      {{icon (ternary (eq .name "research") "users" "wrench") "size-3.5 shrink-0"}}<code class="font-mono text-foreground">{{.name}}</code>
      <span class="truncate font-mono">{{.args}}</span>
      {{if eq .state "unknown"}}<span class="badge ms-auto" data-variant="destructive">unverified</span>
      {{else if .is_error}}<span class="badge ms-auto" data-variant="destructive">error</span>
      {{else if eq .state "started"}}<span class="badge ms-auto" data-variant="outline">{{icon "loader-circle" "animate-spin"}}running</span>{{end}}
    </summary>
    <div class="border-t px-3 py-2 font-mono whitespace-pre-wrap break-words">{{or .result "(no result yet)"}}</div>
    {{if .child_thread_id}}<a class="block border-t px-3 py-1.5 underline underline-offset-4" href="/chat/{{.child_thread_id}}">Subagent transcript</a>{{end}}
  </details>
</li>
{{else if eq .kind "web_search"}}
<li data-step="web_search">
  <details class="rounded-md border bg-card">
    <summary class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-muted-foreground">{{icon "globe" "size-3.5"}}web search: {{len .results}} results{{if .error}} <span class="badge ms-auto" data-variant="destructive">{{.error}}</span>{{end}}</summary>
    <ul class="flex flex-col gap-1 border-t px-3 py-2">
      {{range .results}}<li><a class="underline underline-offset-4" {{template "external" .url}}>{{.title | truncate 80}}</a></li>{{end}}
    </ul>
  </details>
</li>
{{end}}
{{- end}}

{{/* chat_item(item, thread=None, last_seq=None, busy=False): dict with those keys. */}}
{{define "chat_item" -}}
{{$item := .item}}{{$thread := .thread}}{{$last := .last_seq}}{{$busy := .busy}}
{{if eq $item.kind "user"}}
<li class="group flex gap-3" data-seq="{{$item.seq}}">
  <span class="mt-1 grid size-7 shrink-0 place-items-center rounded-full bg-secondary text-secondary-foreground" aria-hidden="true">{{icon "user" "size-4"}}</span>
  <div class="flex min-w-0 flex-1 flex-col gap-1">
    <div class="rounded-lg bg-secondary/60 px-4 py-3 text-sm whitespace-pre-wrap break-words" data-text>{{$item.text}}</div>
    {{if $thread}}{{template "file_chips" (dict "thread_id" $thread.id "files" $item.files)}}{{end}}
    {{if and $thread (eq $thread.kind "chat")}}
    <div class="flex items-center gap-1 text-xs opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
      {{if and (eq $item.seq $last) (not $busy)}}<button type="button" class="btn" data-size="sm" data-variant="ghost" data-action="edit-message">{{icon "pencil" "size-3.5"}}Edit</button>{{end}}
      {{template "branch_button" (dict "thread" $thread "seq" $item.seq)}}
    </div>
    {{end}}
  </div>
</li>
{{else if eq $item.kind "assistant"}}
<li class="group flex gap-3" data-seq="{{$item.seq}}">
  <span class="mt-1 grid size-7 shrink-0 place-items-center rounded-full bg-primary text-primary-foreground" aria-hidden="true">{{icon "bot" "size-4"}}</span>
  <div class="min-w-0 flex-1 flex flex-col gap-2 px-1 py-2">
    <div class="markdown">{{markdown $item.text}}</div>
    {{if $item.citations}}
    <ol class="flex flex-wrap gap-2 text-xs" aria-label="Sources">
      {{range $i, $c := $item.citations}}
      {{if $c.url}}
      <li><a class="badge" data-variant="secondary" {{template "external" $c.url}}>[{{add $i 1}}] {{icon "external-link" "size-3"}}{{$c.title | truncate 60}}</a></li>
      {{else}}
      <li><span class="badge" data-variant="secondary" title="{{$c.cited}}">[{{add $i 1}}] {{icon "file-text" "size-3"}}{{$c.title | truncate 40}}: “{{$c.cited | truncate 60}}”</span></li>
      {{end}}
      {{end}}
    </ol>
    {{end}}
    {{if and $thread (eq $thread.kind "chat")}}
    <div class="flex items-center gap-1 text-xs opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
      {{if and $last (gt $item.seq $last) (not $busy)}}
      <button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post="/chat/{{$thread.id}}/regenerate" hx-target="#transcript" hx-swap="innerHTML" hx-disabled-elt="this">{{icon "refresh-cw" "size-3.5"}}Regenerate</button>
      {{end}}
      {{template "branch_button" (dict "thread" $thread "seq" $item.seq)}}
    </div>
    {{end}}
  </div>
</li>
{{else if eq $item.kind "activity"}}
<li class="ps-10" data-seq="{{$item.seq}}" data-run="{{$item.run_id}}">
  <details class="activity text-xs">
    <summary class="flex cursor-pointer items-center gap-2 text-muted-foreground">{{icon "chevron-down" "size-3.5"}}{{len $item.steps}} step{{if ne (len $item.steps) 1}}s{{end}}</summary>
    <ol class="mt-2 flex flex-col gap-1.5 border-s ps-3">
      {{range $item.steps}}{{template "activity_step" .}}{{end}}
    </ol>
  </details>
</li>
{{else if eq $item.kind "draft"}}
{{$d := $item.draft}}
<li class="ps-10" data-seq="{{$item.seq}}" data-draft="{{$d.id}}">
  <a class="flex items-center gap-3 rounded-lg border bg-card px-3 py-2 text-sm hover:bg-accent" {{template "preview_attrs" (printf "/drafts/%v" $d.id)}}>
    {{icon "mail" "size-4 shrink-0 text-muted-foreground"}}
    <span class="flex min-w-0 flex-1 flex-col">
      <span class="truncate font-medium">{{or $d.subject "(no subject)"}}</span>
      <span class="truncate text-xs text-muted-foreground">to {{$d.to_addrs}}</span>
    </span>
    <span class="badge" data-variant="{{if eq $d.status "sent"}}secondary{{else}}outline{{end}}">{{$d.status}}</span>
  </a>
</li>
{{else if eq $item.kind "queued"}}
<li class="flex gap-3" data-queued="{{$item.id}}">
  <span class="mt-1 grid size-7 shrink-0 place-items-center rounded-full bg-secondary text-secondary-foreground" aria-hidden="true">{{icon "user" "size-4"}}</span>
  <div class="flex min-w-0 flex-1 flex-col gap-1">
    <div class="rounded-lg border border-dashed px-4 py-3 text-sm whitespace-pre-wrap break-words">{{$item.text}}</div>
    {{if $item.files}}<span class="text-xs text-muted-foreground">{{icon "paperclip" "size-3"}} {{join ", " (mapattr "name" $item.files)}}</span>{{end}}
    <span class="text-xs text-muted-foreground">{{icon "clock" "size-3"}} Queued: joins the conversation at the assistant's next step</span>
  </div>
</li>
{{else if eq $item.kind "compaction"}}
<li class="flex items-center gap-3 text-xs text-muted-foreground" data-seq="{{$item.seq}}" role="separator">
  <span class="h-px flex-1 bg-border"></span>Context compacted<span class="h-px flex-1 bg-border"></span>
</li>
{{end}}
{{- end}}
