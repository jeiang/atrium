{{$t := .view.thread}}
{{$active := .view.active}}
{{$busy := and $active (eq $active.state "running")}}
{{range .view.items}}{{template "chat_item" (dict "item" . "thread" $t "last_seq" $.view.last_operator_seq "busy" $busy)}}{{end}}
{{range .view.runs}}{{if and (eq .state "failed") (not .superseded)}}
<li class="ps-10" data-run="{{.id}}">
  <div class="alert" data-variant="destructive" role="alert">
    {{icon "circle-alert"}}
    <p>Run {{.id}} stopped: {{.error}}</p>
    {{if and (eq $t.kind "chat") (eq .id (last $.view.runs).id) $.view.last_operator_seq (not $busy)}}
    <button type="button" class="btn" data-size="sm" data-variant="outline" hx-post="/chat/{{$t.id}}/regenerate" hx-target="#transcript" hx-swap="innerHTML" hx-disabled-elt="this">{{icon "refresh-cw" "size-3.5"}}Try again</button>
    {{end}}
  </div>
</li>
{{end}}{{end}}
{{if not .view.items}}
<li>{{template "empty_state" (dict "icon" "messages-square" "title" "Say something" "body" (partial "transcript_empty" .))}}</li>
{{end}}
{{if $busy}}
{{$after := 0}}{{with last .view.items}}{{$after = .seq}}{{end}}
{{template "_run_live.gohtml" (dict "thread_id" $t.id "run_id" $active.id "after" $after)}}
{{else if and $active (eq $active.state "interrupted")}}
<li class="ps-10" id="run-{{$active.id}}">
  <div class="alert" role="alert">
    {{icon "circle-alert"}}
    <p>This run was interrupted while a write was in flight. Resume to let the assistant check what happened and continue.</p>
    <button type="button" class="btn" data-size="sm" hx-post="/chat/{{$t.id}}/runs/{{$active.id}}/resume" hx-target="#run-{{$active.id}}" hx-swap="outerHTML" hx-disabled-elt="this">{{icon "play"}}Resume</button>
  </div>
</li>
{{end}}
{{range .view.queued}}{{template "chat_item" (dict "item" (dict "kind" "queued" "id" .id "text" .text "files" .files))}}{{end}}

{{define "transcript_empty"}}The assistant can search your mail, contacts, Notion and the web, and read what it finds.{{end}}
