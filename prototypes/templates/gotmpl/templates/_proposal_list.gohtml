{{if and (haskey . "partial") .partial}}<title>Proposals · atrium</title>{{end}}
<p class="text-xs text-muted-foreground tabular-nums" role="status">
  {{- len .proposals}} {{if ne .status "all"}}{{lower (lbl "status" .status "")}} {{end}}{{if eq (len .proposals) 1}}proposal{{else}}proposals{{end}}{{if .kind}} · {{lbl "kind" .kind .kind}}{{end -}}
</p>
{{if .proposals}}
<ul class="flex flex-col gap-3" role="list">
  {{range .proposals}}{{template "_proposal.gohtml" (ctx $ "proposal" .)}}{{end}}
</ul>
{{else if eq .status "pending"}}
{{template "empty_state" (dict "icon" "list-checks" "title" "Nothing to review" "body" (partial "proposal_list_empty_pending" .))}}
{{else}}
{{template "empty_state" (dict "icon" "list-checks" "title" "No proposals match" "body" (partial "proposal_list_empty_none" .))}}
{{end}}

{{define "proposal_list_empty_pending"}}Folder rebalancing is proposed monthly. Notion links and edits appear here when you propose them from a Notion page.{{end}}
{{define "proposal_list_empty_none"}}Choose another status or kind.{{end}}
