{{$p := .proposal}}
{{$v := $p.preview}}
{{$pending := eq $p.status "pending"}}
{{/* {% set PICKS = {...} %} {% set picks = PICKS.get(kind, []) | selectattr("messages") | list %} */}}
{{$PICKS := dict
  "rebalance_split" $v.groups
  "inbox_backlog" $v.groups
  "rebalance_merge" (list $v.group)
  "deletion_rule" (list (dict "messages" $v.messages "count" $v.backlog))
  "gmail_label_merge" (list (dict "messages" $v.messages "count" $v.from_count))}}
{{$picks := selattr "messages" (get $PICKS $p.kind (list))}}
{{$picker := and $pending (gt (len $picks) 0)}}
{{/* The macros in this file close over p/picks/picker in Jinja; Go has no closures, so a ctx dict is threaded explicitly. */}}
{{$c := ctx . "p" $p "v" $v "pending" $pending "picks" $picks "picker" $picker}}
<li id="proposal-{{$p.id}}" class="scroll-mt-20 rounded-lg border bg-card target:ring-2 target:ring-ring {{if or (eq $p.status "dismissed") (eq $p.status "suppressed")}}opacity-80{{end}}">
  <article aria-labelledby="proposal-title-{{$p.id}}">
    {{if $pending}}
    <form class="flex flex-col" hx-post="/proposals/{{$p.id}}/approve" hx-target="#proposal-{{$p.id}}" hx-swap="outerHTML"
          hx-disabled-elt="find button" hx-indicator="#proposal-spinner-{{$p.id}}"{{if $picker}} data-selection{{end}}>
    {{end}}
    <header class="flex flex-col gap-2 p-4 pb-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge" data-variant="secondary">{{icon (lbl "kind_icon" $p.kind "list-checks")}}{{lbl "kind" $p.kind}}</span>
        {{if $p.account}}<span class="badge" data-variant="outline">{{$p.account}}</span>{{end}}
        {{template "status_badge" $p.status}}
        <span class="ml-auto text-xs text-muted-foreground">#{{$p.id}} · {{template "when" (dict "epoch" $p.created_ts)}}</span>
      </div>
      <h3 id="proposal-title-{{$p.id}}" class="font-medium text-pretty">{{$p.title}}</h3>
    </header>
    <div class="flex flex-col gap-4 px-4 pb-4">{{partial "proposal_body" $c}}</div>
    <footer class="border-t px-4 py-3">{{partial "proposal_footer" $c}}</footer>
    {{if $pending}}</form>{{end}}
  </article>
</li>
{{if and (haskey . "pending_oob") .pending_oob}}{{template "pending_badge" (dict "count" .pending_count "oob" true)}}{{end}}
{{if and (haskey . "toast") .toast}}{{template "_toast.gohtml" .}}{{end}}

{{/* ---- macros defined in _proposal.html ---- */}}
{{define "proposal_counted" -}}
<ul class="flex flex-col gap-1 text-sm sm:max-w-xs" role="list">
  {{range .}}
  <li class="flex min-w-0 items-baseline gap-2"><span class="truncate">{{.label}}</span><span class="ml-auto shrink-0 text-xs text-muted-foreground tabular-nums">{{.count}}</span></li>
  {{end}}
</ul>
{{- end}}

{{define "proposal_subjects" -}}
<ul class="flex flex-col gap-1 text-sm" role="list">
  {{range .}}<li class="truncate">{{or . "(no subject)"}}</li>{{end}}
</ul>
{{- end}}

{{define "proposal_toggle" -}}
<div role="group" class="field w-auto" data-orientation="horizontal">
  <input id="group-{{.uid}}" type="checkbox" checked data-group-toggle>
  <label for="group-{{.uid}}" class="font-normal"><span class="tabular-nums"><span data-picked>{{len .g.messages}}</span> of {{.g.count}} messages</span></label>
</div>
{{- end}}

{{define "proposal_message_list" -}}
{{$i := .i}}
<details class="group/list">
  <summary class="inline-flex gap-1 rounded-sm text-xs font-medium text-muted-foreground hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
    {{icon "chevron-down" "size-3.5 transition-transform group-open/list:rotate-180"}}Choose exactly which messages {{.verb}}
  </summary>
  <ul class="mt-2 flex max-h-96 flex-col divide-y overflow-y-auto rounded-md border bg-background" role="list">
    {{range .messages}}
    <li class="flex items-center gap-1 pe-2 hover:bg-accent/60 has-[input:focus-visible]:bg-accent/60">
      <label class="flex min-w-0 flex-1 items-center gap-3 py-2 ps-3">
        <input class="input shrink-0" type="checkbox" name="msg-{{$i}}" value="{{.id}}" checked data-message>
        <span class="flex min-w-0 flex-1 flex-col">
          <span class="truncate text-sm">{{or .subject "(no subject)"}}</span>
          <span class="truncate text-xs text-muted-foreground">{{template "sender" .}} · {{template "when" (dict "epoch" .date_ts)}}</span>
        </span>
      </label>
      <a class="btn shrink-0" data-size="icon-sm" data-variant="ghost" {{template "open_attrs" .id}} aria-label="Read {{or .subject "message"}}" title="Read">{{icon "mail"}}</a>
    </li>
    {{end}}
  </ul>
</details>
{{- end}}

{{define "proposal_group_picker" -}}
{{$p := .p}}{{$g := .g}}{{$i := .i}}
{{$uid := printf "%v-%d" $p.id $i}}
<fieldset class="flex flex-col gap-3 border-t pt-4"{{if .picker}} data-group{{end}}>
  <legend class="sr-only">{{$g.name}}</legend>
  <div class="flex flex-wrap items-end gap-x-4 gap-y-2">
    {{if and .editable .pending}}
    <div role="group" class="field min-w-0 flex-1 sm:max-w-sm">
      <label for="name-{{$uid}}">New {{template "noun" $p.account}}</label>
      <input id="name-{{$uid}}" name="name-{{$i}}" type="text" value="{{$g.name}}" required autocomplete="off" spellcheck="false">
    </div>
    {{else}}
    <p class="min-w-0 flex-1 text-sm"><span class="text-muted-foreground">Into</span> <span class="font-medium">{{template "place" $g.name}}</span></p>
    {{end}}
    {{if and .picker $g.messages}}{{template "proposal_toggle" (dict "uid" $uid "g" $g)}}{{else}}<p class="text-sm text-muted-foreground tabular-nums">{{$g.count}} messages</p>{{end}}
  </div>
  {{if $g.terms}}
  <ul class="flex flex-wrap gap-1.5" role="list" aria-label="Common words">
    {{range $g.terms}}<li class="badge" data-variant="outline">{{.}}</li>{{end}}
  </ul>
  {{end}}
  <div class="grid gap-4 sm:grid-cols-2">
    {{if $g.senders}}
    <div class="flex min-w-0 flex-col gap-1.5">
      <h4 class="text-xs font-medium text-muted-foreground">Top senders</h4>
      {{template "proposal_counted" $g.senders}}
    </div>
    {{end}}
    {{if $g.subjects}}
    <div class="flex min-w-0 flex-col gap-1.5">
      <h4 class="text-xs font-medium text-muted-foreground">Sample subjects</h4>
      {{template "proposal_subjects" $g.subjects}}
    </div>
    {{end}}
  </div>
  {{if and .picker $g.messages}}{{template "proposal_message_list" (dict "i" $i "messages" $g.messages "verb" "move")}}{{end}}
</fieldset>
{{- end}}

{{define "proposal_plain_picker" -}}
{{$g := index .picks 0}}
<fieldset class="flex flex-col gap-2" data-group>
  <legend class="sr-only">Messages</legend>
  {{template "proposal_toggle" (dict "uid" (printf "%v-0" .p.id) "g" $g)}}
  {{template "proposal_message_list" (dict "i" 0 "messages" $g.messages "verb" .verb)}}
</fieldset>
{{- end}}

{{define "proposal_page_ref" -}}
<div class="flex min-w-0 flex-col gap-0.5">
  <span class="flex min-w-0 items-center gap-1.5">{{template "page_link" (dict "ref" . "class" "truncate text-sm")}}<a class="shrink-0 text-muted-foreground hover:text-foreground" {{template "external" .url}} title="Open in Notion" aria-label="Open {{or .title "Untitled"}} in Notion">{{icon "external-link" "size-3.5"}}</a></span>
  {{if .path}}<span class="truncate text-xs text-muted-foreground">{{template "page_path" .path}}</span>{{end}}
</div>
{{- end}}

{{/* {% set body %}...{% endset %} */}}
{{define "proposal_body" -}}
{{$p := .p}}{{$v := .v}}
{{if and (eq $p.status "failed") $p.result $p.result.error}}
<div class="alert" data-variant="destructive" role="alert">
  {{icon "circle-alert"}}
  <h4>It did not finish</h4>
  <section><p>{{$p.result.error}}</p></section>
</div>
{{end}}

{{if eq $p.kind "rebalance_split"}}
<p class="text-sm"><span class="text-muted-foreground">Split</span> <span class="font-medium">{{template "place" $v.folder}}</span> <span class="text-muted-foreground">into {{len $v.groups}} new {{template "noun" $p.account}}{{if ne (len $v.groups) 1}}s{{end}}. Anything not moved stays where it is.</span></p>
<div class="flex flex-col gap-3">
  {{range $i, $g := $v.groups}}{{template "proposal_group_picker" (ctx $ "i" $i "g" $g "editable" true)}}{{end}}
</div>

{{else if eq $p.kind "inbox_backlog"}}
<p class="text-sm text-muted-foreground">Read mail that was already in the inbox when atrium went live, grouped by where atrium would file it. Anything not moved stays where it is.</p>
<div class="flex flex-col gap-3">
  {{range $i, $g := $v.groups}}{{template "proposal_group_picker" (ctx $ "i" $i "g" $g "editable" false)}}{{end}}
</div>

{{else if eq $p.kind "rebalance_merge"}}
<div class="flex flex-wrap items-center gap-2 text-sm">
  {{range $v.sources}}<span class="badge" data-variant="secondary">{{template "place" .folder}} <span class="tabular-nums text-muted-foreground">{{.count}}</span></span>{{end}}
  {{icon "arrow-right" "size-3.5 text-muted-foreground"}}
  <span class="font-medium">{{template "place" $v.into}}</span>
  <span class="text-xs text-muted-foreground">{{if $v.into_exists}}existing {{template "noun" $p.account}}{{else}}new {{template "noun" $p.account}}{{end}}</span>
</div>
{{template "proposal_group_picker" (ctx . "i" 0 "g" $v.group "editable" (not $v.into_exists))}}

{{else if eq $p.kind "deletion_rule"}}
{{$reasons := dict "operator_deleted" "You have deleted mail like this before." "otp" "One-time codes are useless once they expire."}}
<div class="grid gap-4 md:grid-cols-2">
  <div class="flex flex-col gap-3">
    <div class="flex flex-col gap-1.5">
      <h4 class="text-xs font-medium text-muted-foreground">Rule{{if $v.rule.account}} for {{$v.rule.account}}{{end}}</h4>
      <ul class="flex flex-col gap-1 text-sm" role="list" aria-label="Conditions, all must hold">
        {{range $i, $c := $v.rule.when}}
        <li class="flex flex-wrap items-baseline gap-x-1.5">{{if ne $i 0}}<span class="text-xs text-muted-foreground">and</span>{{end}}{{template "condition_text" $c}}</li>
        {{end}}
      </ul>
      <p class="flex items-center gap-1.5 text-sm">{{icon "arrow-right" "size-3.5 text-muted-foreground"}}<span class="font-medium text-destructive">Delete</span></p>
    </div>
    {{with index $reasons $v.reason}}<p class="text-sm text-muted-foreground">{{.}}</p>{{end}}
    <p class="text-sm"><span class="text-2xl font-semibold tabular-nums">{{$v.backlog}}</span> <span class="text-muted-foreground">existing {{if eq $v.backlog 1}}message matches{{else}}messages match{{end}}</span></p>
  </div>
  <div class="flex min-w-0 flex-col gap-4">
    {{if $v.senders}}
    <div class="flex flex-col gap-1.5">
      <h4 class="text-xs font-medium text-muted-foreground">Top senders</h4>
      {{template "proposal_counted" $v.senders}}
    </div>
    {{end}}
    {{if $v.subjects}}
    <div class="flex flex-col gap-1.5">
      <h4 class="text-xs font-medium text-muted-foreground">Sample subjects</h4>
      {{template "proposal_subjects" $v.subjects}}
    </div>
    {{end}}
  </div>
</div>
{{if .picker}}{{template "proposal_plain_picker" (ctx . "verb" "are deleted")}}{{end}}
<p class="flex gap-2 text-xs text-muted-foreground">
  {{icon "trash-2" "mt-0.5 size-3.5 shrink-0"}}
  <span>Deleting moves mail to Trash, so it can still be recovered there. {{if eq .mode "live"}}The rule also deletes new matching mail from now on.{{else}}The rule deletes new matching mail only once routing is live.{{end}}</span>
</p>

{{else if eq $p.kind "gmail_label_merge"}}
<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
  <span class="inline-flex items-center gap-1.5">{{icon "tag" "size-3.5 text-muted-foreground"}}<span class="font-medium">{{$v.from}}</span><span class="text-xs text-muted-foreground tabular-nums">{{$v.from_count}}</span></span>
  {{icon "arrow-right" "size-3.5 text-muted-foreground"}}
  <span class="inline-flex items-center gap-1.5">{{icon "tag" "size-3.5 text-muted-foreground"}}<span class="font-medium">{{$v.into}}</span><span class="text-xs text-muted-foreground tabular-nums">{{$v.into_count}}</span></span>
</div>
<p class="text-xs text-muted-foreground">Adds “{{$v.into}}” to the messages labelled “{{$v.from}}”, then removes “{{$v.from}}” from them. No mail is deleted.</p>
{{if .picker}}{{template "proposal_plain_picker" (ctx . "verb" "are relabelled")}}{{end}}

{{else if eq $p.kind "notion_link"}}
<div class="grid items-center gap-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]">
  {{template "proposal_page_ref" $v.a}}
  <span class="flex items-center gap-2 text-muted-foreground max-sm:ps-1">{{icon "link" "size-4"}}<span class="sr-only">linked with</span></span>
  {{template "proposal_page_ref" $v.b}}
</div>
<p class="text-xs text-muted-foreground">Adds a link to the page text under a “Related” heading.</p>
{{if $v.reason}}<blockquote class="border-s-2 ps-3 text-sm text-muted-foreground">{{$v.reason}}</blockquote>{{end}}

{{else if eq $p.kind "calendar_event"}}
<dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_minmax(0,1fr)]">
  <dt class="text-muted-foreground">Calendar</dt>
  <dd>{{if eq $v.calendar "google"}}Google{{else}}iCloud{{end}}</dd>
  <dt class="text-muted-foreground">{{if $v.all_day}}Date{{else}}When{{end}}</dt>
  <dd class="tabular-nums">{{$v.start}} → {{$v.end}}</dd>
  {{if $v.location}}<dt class="text-muted-foreground">Where</dt><dd>{{$v.location}}</dd>{{end}}
  {{if $v.notes}}<dt class="text-muted-foreground">Notes</dt><dd class="whitespace-pre-wrap">{{$v.notes}}</dd>{{end}}
  {{if and $v.source $v.source.subject}}<dt class="text-muted-foreground">From mail</dt><dd>{{$v.source.subject}}</dd>{{end}}
</dl>
<p class="text-xs text-muted-foreground">Nobody is invited and no notification is sent.</p>

{{else if eq $p.kind "reminder"}}
<dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_minmax(0,1fr)]">
  <dt class="text-muted-foreground">Reminder</dt>
  <dd>{{$v.text}}</dd>
  <dt class="text-muted-foreground">Due</dt>
  <dd class="tabular-nums">{{$v.due}}</dd>
  <dt class="text-muted-foreground">Remind at</dt>
  <dd class="tabular-nums">{{$v.remind_at}}</dd>
  {{if $v.subject}}<dt class="text-muted-foreground">From mail</dt><dd>{{$v.subject}}</dd>{{end}}
</dl>
<p class="text-xs text-muted-foreground">Approving creates a one-time schedule that notifies you.</p>

{{else if eq $p.kind "notion_edit"}}
{{template "proposal_page_ref" $v.page}}
<dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_minmax(0,1fr)]">
  <dt class="text-muted-foreground">You asked</dt>
  <dd>{{$v.instruction}}</dd>
  {{if $v.summary}}
  <dt class="text-muted-foreground">The 9B changed</dt>
  <dd>{{$v.summary}}</dd>
  {{end}}
</dl>
{{$added := countwhere $v.diff "op" "add"}}
{{$removed := countwhere $v.diff "op" "del"}}
<div class="flex flex-col overflow-hidden rounded-md border">
  <p class="flex items-center gap-3 border-b bg-muted/50 px-3 py-1.5 text-xs tabular-nums">
    <span class="text-success">+{{$added}}<span class="sr-only"> lines added</span></span>
    <span class="text-destructive">−{{$removed}}<span class="sr-only"> lines removed</span></span>
  </p>
  <div class="max-h-96 overflow-auto bg-background py-1 font-mono text-xs/5" role="group" aria-label="Changes">
    {{range $v.diff}}
    {{if eq .op "add"}}
    <ins class="grid grid-cols-[--spacing(6)_minmax(0,1fr)] bg-success/10 no-underline"><span class="select-none text-center text-success" aria-hidden="true">+</span><span class="whitespace-pre-wrap break-words pe-3">{{.text}}</span></ins>
    {{else if eq .op "del"}}
    <del class="grid grid-cols-[--spacing(6)_minmax(0,1fr)] bg-destructive/10 no-underline"><span class="select-none text-center text-destructive" aria-hidden="true">−</span><span class="whitespace-pre-wrap break-words pe-3 text-muted-foreground line-through decoration-destructive/40">{{.text}}</span></del>
    {{else}}
    <div class="grid grid-cols-[--spacing(6)_minmax(0,1fr)]"><span aria-hidden="true"></span><span class="whitespace-pre-wrap break-words pe-3 text-muted-foreground">{{.text}}</span></div>
    {{end}}
    {{end}}
  </div>
</div>

{{else if eq $p.kind "notion_wiki_plan"}}
<p class="text-sm text-muted-foreground">Turns the Notion workspace into the wiki page tree under Wiki Home. Dropped rows and emptied databases are archived (never deleted); every step is undoable.</p>
<div class="flex flex-wrap gap-1.5">
  {{range $d, $n := $v.counts}}<span class="badge" data-variant="{{if eq $d "drop"}}destructive{{else}}secondary{{end}}">{{$n}} {{lower (lbl "decision" $d)}}</span>{{end}}
</div>
<div class="grid gap-4 md:grid-cols-2">
  <div class="flex min-w-0 flex-col gap-1.5">
    <h4 class="text-xs font-medium text-muted-foreground">Hubs under Wiki Home</h4>
    <ul class="flex flex-col gap-1 text-sm" role="list">
      {{range $v.hubs}}<li><span class="font-medium">{{.title}}</span>{{if .description}} <span class="text-muted-foreground">{{.description}}</span>{{end}}</li>{{end}}
    </ul>
  </div>
  <div class="flex min-w-0 flex-col gap-1.5">
    <h4 class="text-xs font-medium text-muted-foreground">Databases</h4>
    <ul class="flex flex-col gap-1 text-sm" role="list">
      {{range $v.databases}}
      <li class="flex min-w-0 flex-col"><span><span class="font-medium">{{.title}}</span> <span class="text-muted-foreground">→ {{if eq .mode "table"}}one page with a table{{else}}hub with child pages{{end}} under {{.hub}}</span></span><span class="truncate text-xs text-muted-foreground">{{.reason}}</span></li>
      {{end}}
    </ul>
  </div>
</div>
<details class="group/list">
  <summary class="inline-flex gap-1 rounded-sm text-xs font-medium text-muted-foreground hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
    {{icon "chevron-down" "size-3.5 transition-transform group-open/list:rotate-180"}}Every row and page ({{len $v.items}})
  </summary>
  <ul class="mt-2 flex max-h-96 flex-col divide-y overflow-y-auto rounded-md border bg-background" role="list">
    {{range $v.items}}
    <li class="flex min-w-0 flex-col gap-0.5 px-3 py-2">
      <span class="flex min-w-0 items-center gap-2">
        <span class="badge shrink-0" data-variant="{{if eq .decision "drop"}}destructive{{else if eq .decision "keep"}}outline{{else}}secondary{{end}}">{{lbl "decision" .decision}}</span>
        <a class="truncate text-sm hover:underline" href="/notion/{{.id}}">{{or .title "Untitled"}}</a>
        {{if .source}}<span class="shrink-0 text-xs text-muted-foreground">{{.source}}</span>{{end}}
        {{if .hub}}<span class="shrink-0 text-xs text-muted-foreground">→ {{.hub}}</span>{{end}}
        {{if .merge_into}}<span class="truncate text-xs text-muted-foreground">→ into {{.merge_into}}</span>{{end}}
      </span>
      <span class="text-xs text-muted-foreground">{{.reason}}</span>
    </li>
    {{end}}
  </ul>
</details>
{{end}}
{{- end}}

{{/* {% set footer %}...{% endset %} */}}
{{define "proposal_footer" -}}
{{$p := .p}}
{{if .pending}}
<div class="flex flex-wrap items-center gap-2">
  {{$deletes := eq $p.kind "deletion_rule"}}
  <button type="submit" class="btn" data-size="sm" name="all" value="1"{{if $deletes}} data-confirm="{{if .picker}}Move all matching messages to Trash now and save the rule?{{else}}Save the rule? Nothing moves to Trash now.{{end}}"{{end}}>
    {{icon (ternary .picker "check-check" "check")}}{{if .picker}}Approve all{{else}}Approve{{end}}
  </button>
  {{if .picker}}
  {{$picked := sumlens "messages" .picks}}
  <button type="submit" class="btn" data-size="sm" data-variant="outline" data-approve-picked{{if $deletes}} data-confirm="Move the selected messages to Trash now and save the rule?" data-confirm-none="Save the rule without moving any messages to Trash?"{{end}}>{{icon "check"}}<span data-some>Approve <span class="tabular-nums" data-picked-total>{{$picked}}</span> selected</span>{{if $deletes}}<span data-none hidden>Save rule only</span>{{end}}</button>
  {{end}}
  <span id="proposal-spinner-{{$p.id}}" class="htmx-indicator inline-flex items-center gap-1.5 text-xs text-muted-foreground" role="status">{{icon "loader-circle" "size-4 animate-spin"}}Applying…</span>
  <div class="ml-auto flex gap-1">
    <button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post="/proposals/{{$p.id}}/dismiss" hx-indicator="unset">Dismiss</button>
    <button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post="/proposals/{{$p.id}}/dismiss" hx-vals='{"forever": "1"}' hx-indicator="unset"
            title="Never propose this again">Dismiss forever</button>
  </div>
</div>
{{else if eq $p.status "applied"}}
<div class="flex flex-wrap items-center gap-2">
  <p class="flex min-w-0 flex-1 items-start gap-2 text-sm text-success">{{icon "check" "mt-0.5 size-4 shrink-0"}}<span>{{if and $p.result $p.result.summary}}{{$p.result.summary}}{{else}}Applied{{end}} <span class="text-xs text-muted-foreground">{{template "when" (dict "epoch" $p.applied_ts "style" "datetime")}}</span></span></p>
  {{if $p.undoable}}
  <button type="button" class="btn" data-size="sm" data-variant="outline" hx-post="/proposals/{{$p.id}}/undo" hx-target="#proposal-{{$p.id}}" hx-swap="outerHTML" hx-disabled-elt="this"
          hx-confirm="Undo this proposal and put everything back?">{{icon "undo-2"}}Undo</button>
  {{end}}
</div>
{{else if eq $p.status "failed"}}
<div class="flex flex-wrap items-center gap-2">
  <p class="flex-1 text-xs whitespace-nowrap text-muted-foreground">Tried {{template "when" (dict "epoch" $p.decided_ts "style" "datetime")}}</p>
  {{if eq $p.kind "notion_wiki_plan"}}
  <span id="proposal-spinner-{{$p.id}}" class="htmx-indicator inline-flex items-center gap-1.5 text-xs text-muted-foreground" role="status">{{icon "loader-circle" "size-4 animate-spin"}}Applying…</span>
  <button type="button" class="btn" data-size="sm" hx-post="/proposals/{{$p.id}}/approve" hx-vals='{"all": "1"}' hx-target="#proposal-{{$p.id}}" hx-swap="outerHTML" hx-disabled-elt="this" hx-indicator="#proposal-spinner-{{$p.id}}"
          title="Skips the steps the earlier attempt finished">{{icon "play"}}Resume</button>
  {{end}}
  {{if $p.undoable}}
  <button type="button" class="btn" data-size="sm" data-variant="outline" hx-post="/proposals/{{$p.id}}/undo" hx-target="#proposal-{{$p.id}}" hx-swap="outerHTML" hx-disabled-elt="this">{{icon "undo-2"}}Undo what it did</button>
  {{end}}
  <button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post="/proposals/{{$p.id}}/dismiss" hx-target="#proposal-{{$p.id}}" hx-swap="outerHTML">Dismiss</button>
</div>
{{else}}
<p class="text-xs text-muted-foreground">{{if or (eq $p.status "dismissed") (eq $p.status "suppressed")}}Dismissed{{else}}Decided{{end}} {{template "when" (dict "epoch" $p.decided_ts "style" "datetime")}}{{if eq $p.status "suppressed"}}. atrium will not propose this again.{{end}}</p>
{{end}}
{{- end}}
