{{$m := .view.meter}}
<span id="meter" class="flex items-center gap-2 tabular-nums" title="Prompt tokens of the last request against the point where the context is compacted ({{$m.compact_at}} of the {{$m.limit}} limit)"{{if .oob}} hx-swap-oob="true"{{end}}>
  <span class="badge" data-variant="outline">effort {{.view.thread.effort}}</span>
  <span class="flex items-center gap-1.5" aria-label="Context used">
    <span class="h-1.5 w-16 overflow-hidden rounded-full bg-muted" aria-hidden="true"><span class="block h-full rounded-full {{if ge $m.share 0.8}}bg-warning{{else}}bg-chart-3{{end}}" style="width: {{round (fmul $m.share 100)}}%"></span></span>
    <span>{{printf "%.1f" (fdiv $m.tokens 1000)}}K / {{round (fdiv $m.compact_at 1000)}}K</span>
  </span>
  <span data-cost>${{printf "%.3f" .view.cost}}</span>
</span>
