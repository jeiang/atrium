package main

import "strings"

// proposals.html
templ ProposalsPage(d ProposalsPageData) {
	@Layout(Base{Page: "proposals", PendingCount: d.PendingCount, Paused: d.Paused, Mode: d.Mode, Toast: d.Toast}, Slots{Title: "Proposals", Heading: "Proposals"}) {
		<div class="alert" role="note">
			@Icon("zap", "text-warning")
			<h2>Approving runs it now</h2>
			<section>
				<p>An approved proposal moves or relabels mail, deletes to Trash, or edits Notion as soon as you approve it{ cond(d.Mode != "live", ", even though nothing is applied automatically in shadow mode", "") }. Applied proposals can be undone here.</p>
			</section>
		</div>
		<form class="flex flex-wrap items-end gap-3" action="/proposals" method="get" hx-get="/proposals" hx-target="#proposal-list" hx-push-url="true" hx-trigger="change" hx-sync="this:replace" hx-indicator="#proposal-list">
			<div role="group" class="field w-auto">
				<label for="p-status">Status</label>
				<select id="p-status" name="status">
					for _, value := range []string{"pending", "applied", "failed", "dismissed", "suppressed", "all"} {
						<option value={ value } selected?={ d.Status == value }>{ get(statusLabels, value, "Any status") }{ countSuffix(d.Counts, value) }</option>
					}
				</select>
			</div>
			<div role="group" class="field w-auto">
				<label for="p-kind">Kind</label>
				<select id="p-kind" name="kind">
					<option value="">All kinds</option>
					for _, e := range kindLabels {
						<option value={ e.K } selected?={ d.Kind == e.K }>{ e.V }</option>
					}
				</select>
			</div>
			<noscript><button type="submit" class="btn" data-variant="outline">Apply</button></noscript>
		</form>
		<div id="proposal-list" class="flex flex-col gap-3 transition-opacity [&.htmx-request]:opacity-60">
			@ProposalList(d)
		</div>
	}
}

// _proposal_list.html
templ ProposalList(d ProposalsPageData) {
	<p class="text-xs text-muted-foreground tabular-nums" role="status">{ proposalCount(len(d.Proposals), d.Status, d.Kind) }</p>
	if len(d.Proposals) > 0 {
		<ul class="flex flex-col gap-3" role="list">
			for _, p := range d.Proposals {
				@ProposalCard(p, d)
			}
		</ul>
	} else if d.Status == "pending" {
		@EmptyState("list-checks", "Nothing to review") {
			Folder rebalancing is proposed monthly. Notion links and edits appear here when you propose them from a Notion page.
		}
	} else {
		@EmptyState("list-checks", "No proposals match") {
			Choose another status or kind.
		}
	}
}

// ---- macros local to _proposal.html ----
templ counted(items []Counted) {
	<ul class="flex flex-col gap-1 text-sm sm:max-w-xs" role="list">
		for _, s := range items {
			<li class="flex min-w-0 items-baseline gap-2"><span class="truncate">{ s.Label }</span><span class="ml-auto shrink-0 text-xs text-muted-foreground tabular-nums">{ itoa(s.Count) }</span></li>
		}
	</ul>
}

templ subjects(items []string) {
	<ul class="flex flex-col gap-1 text-sm" role="list">
		for _, s := range items {
			<li class="truncate">{ or(s, "(no subject)") }</li>
		}
	</ul>
}

templ toggle(uid string, g Group) {
	<div role="group" class="field w-auto" data-orientation="horizontal">
		<input id={ "group-" + uid } type="checkbox" checked data-group-toggle/>
		<label for={ "group-" + uid } class="font-normal"><span class="tabular-nums"><span data-picked>{ itoa(len(g.Messages)) }</span> of { itoa(g.Count) } messages</span></label>
	</div>
}

templ messageList(i int, messages []Message, verb string) {
	<details class="group/list">
		<summary class="inline-flex gap-1 rounded-sm text-xs font-medium text-muted-foreground hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
			@Icon("chevron-down", "size-3.5 transition-transform group-open/list:rotate-180")
			Choose exactly which messages { verb }
		</summary>
		<ul class="mt-2 flex max-h-96 flex-col divide-y overflow-y-auto rounded-md border bg-background" role="list">
			for _, m := range messages {
				<li class="flex items-center gap-1 pe-2 hover:bg-accent/60 has-[input:focus-visible]:bg-accent/60">
					<label class="flex min-w-0 flex-1 items-center gap-3 py-2 ps-3">
						<input class="input shrink-0" type="checkbox" name={ "msg-" + itoa(i) } value={ itoa(m.ID) } checked data-message/>
						<span class="flex min-w-0 flex-1 flex-col">
							<span class="truncate text-sm">{ or(m.Subject, "(no subject)") }</span>
							<span class="truncate text-xs text-muted-foreground">{ sender(m) } · @When(m.DateTS, "date")</span>
						</span>
					</label>
					<a class="btn shrink-0" data-size="icon-sm" data-variant="ghost" href={ "/messages/" + itoa(m.ID) } hx-get={ "/messages/" + itoa(m.ID) } hx-target="#reader-body" hx-swap="innerHTML show:top" aria-label={ "Read " + or(m.Subject, "message") } title="Read">@Icon("mail")</a>
				</li>
			}
		</ul>
	</details>
}

templ groupPicker(pc PC, i int, g Group, editable bool) {
	{{ uid := itoa(pc.P.ID) + "-" + itoa(i) }}
	<fieldset
		class="flex flex-col gap-3 border-t pt-4"
		if pc.Picker {
			data-group
		}
	>
		<legend class="sr-only">{ g.Name }</legend>
		<div class="flex flex-wrap items-end gap-x-4 gap-y-2">
			if editable && pc.Pending {
				<div role="group" class="field min-w-0 flex-1 sm:max-w-sm">
					<label for={ "name-" + uid }>New { noun(pc.P.Account) }</label>
					<input id={ "name-" + uid } name={ "name-" + itoa(i) } type="text" value={ g.Name } required autocomplete="off" spellcheck="false"/>
				</div>
			} else {
				<p class="min-w-0 flex-1 text-sm"><span class="text-muted-foreground">Into</span> <span class="font-medium">{ place(g.Name) }</span></p>
			}
			if pc.Picker && len(g.Messages) > 0 {
				@toggle(uid, g)
			} else {
				<p class="text-sm text-muted-foreground tabular-nums">{ itoa(g.Count) } messages</p>
			}
		</div>
		if len(g.Terms) > 0 {
			<ul class="flex flex-wrap gap-1.5" role="list" aria-label="Common words">
				for _, t := range g.Terms {
					<li class="badge" data-variant="outline">{ t }</li>
				}
			</ul>
		}
		<div class="grid gap-4 sm:grid-cols-2">
			if len(g.Senders) > 0 {
				<div class="flex min-w-0 flex-col gap-1.5">
					<h4 class="text-xs font-medium text-muted-foreground">Top senders</h4>
					@counted(g.Senders)
				</div>
			}
			if len(g.Subjects) > 0 {
				<div class="flex min-w-0 flex-col gap-1.5">
					<h4 class="text-xs font-medium text-muted-foreground">Sample subjects</h4>
					@subjects(g.Subjects)
				</div>
			}
		</div>
		if pc.Picker && len(g.Messages) > 0 {
			@messageList(i, g.Messages, "move")
		}
	</fieldset>
}

templ plainPicker(pc PC, verb string) {
	{{ g := pc.Picks[0] }}
	<fieldset class="flex flex-col gap-2" data-group>
		<legend class="sr-only">Messages</legend>
		@toggle(itoa(pc.P.ID)+"-0", g)
		@messageList(0, g.Messages, verb)
	</fieldset>
}

templ pageRef(ref *PageRef) {
	<div class="flex min-w-0 flex-col gap-0.5">
		<span class="flex min-w-0 items-center gap-1.5">
			@PageLink(ref, "truncate text-sm")
			<a class="shrink-0 text-muted-foreground hover:text-foreground" href={ ref.URL } target="_blank" rel="noopener noreferrer" title="Open in Notion" aria-label={ "Open " + or(ref.Title, "Untitled") + " in Notion" }>@Icon("external-link", "size-3.5")</a>
		</span>
		if len(ref.Path) > 0 {
			<span class="truncate text-xs text-muted-foreground">{ pagePath(ref.Path) }</span>
		}
	</div>
}

// `{% set body %}...{% endset %}`: a block capture becomes a component (a templ.Component value).
templ proposalBody(pc PC, mode string) {
	{{ p := pc.P }}
	{{ v := pc.V }}
	if p.Status == "failed" && p.Result != nil && p.Result.Error != "" {
		<div class="alert" data-variant="destructive" role="alert">
			@Icon("circle-alert")
			<h4>It did not finish</h4>
			<section><p>{ p.Result.Error }</p></section>
		</div>
	}
	switch p.Kind {
		case "rebalance_split":
			<p class="text-sm"><span class="text-muted-foreground">Split</span> <span class="font-medium">{ place(v.Folder) }</span> <span class="text-muted-foreground">into { itoa(len(v.Groups)) } new { noun(p.Account) }{ cond(len(v.Groups) != 1, "s", "") }. Anything not moved stays where it is.</span></p>
			<div class="flex flex-col gap-3">
				for i, g := range v.Groups {
					@groupPicker(pc, i, g, true)
				}
			</div>
		case "inbox_backlog":
			<p class="text-sm text-muted-foreground">Read mail that was already in the inbox when atrium went live, grouped by where atrium would file it. Anything not moved stays where it is.</p>
			<div class="flex flex-col gap-3">
				for i, g := range v.Groups {
					@groupPicker(pc, i, g, false)
				}
			</div>
		case "rebalance_merge":
			<div class="flex flex-wrap items-center gap-2 text-sm">
				for _, s := range v.Sources {
					<span class="badge" data-variant="secondary">{ place(s.Folder) } <span class="tabular-nums text-muted-foreground">{ itoa(s.Count) }</span></span>
				}
				@Icon("arrow-right", "size-3.5 text-muted-foreground")
				<span class="font-medium">{ place(v.Into) }</span>
				<span class="text-xs text-muted-foreground">{ cond(v.IntoExists, "existing "+noun(p.Account), "new "+noun(p.Account)) }</span>
			</div>
			@groupPicker(pc, 0, *v.Group, !v.IntoExists)
		case "deletion_rule":
			<div class="grid gap-4 md:grid-cols-2">
				<div class="flex flex-col gap-3">
					<div class="flex flex-col gap-1.5">
						<h4 class="text-xs font-medium text-muted-foreground">Rule{ cond(v.Rule.Account != "", " for "+v.Rule.Account, "") }</h4>
						<ul class="flex flex-col gap-1 text-sm" role="list" aria-label="Conditions, all must hold">
							for i, c := range v.Rule.When {
								<li class="flex flex-wrap items-baseline gap-x-1.5">
									if i != 0 {
										<span class="text-xs text-muted-foreground">and</span>
									}
									@ConditionText(c)
								</li>
							}
						</ul>
						<p class="flex items-center gap-1.5 text-sm">@Icon("arrow-right", "size-3.5 text-muted-foreground")<span class="font-medium text-destructive">Delete</span></p>
					</div>
					if r, ok := deletionReasons[v.Reason]; ok {
						<p class="text-sm text-muted-foreground">{ r }</p>
					}
					<p class="text-sm"><span class="text-2xl font-semibold tabular-nums">{ itoa(v.Backlog) }</span> <span class="text-muted-foreground">existing { cond(v.Backlog == 1, "message matches", "messages match") }</span></p>
				</div>
				<div class="flex min-w-0 flex-col gap-4">
					if len(v.Senders) > 0 {
						<div class="flex flex-col gap-1.5">
							<h4 class="text-xs font-medium text-muted-foreground">Top senders</h4>
							@counted(v.Senders)
						</div>
					}
					if len(v.Subjects) > 0 {
						<div class="flex flex-col gap-1.5">
							<h4 class="text-xs font-medium text-muted-foreground">Sample subjects</h4>
							@subjects(v.Subjects)
						</div>
					}
				</div>
			</div>
			if pc.Picker {
				@plainPicker(pc, "are deleted")
			}
			<p class="flex gap-2 text-xs text-muted-foreground">
				@Icon("trash-2", "mt-0.5 size-3.5 shrink-0")
				<span>
					Deleting moves mail to Trash, so it can still be recovered there.
					if mode == "live" {
						The rule also deletes new matching mail from now on.
					} else {
						The rule deletes new matching mail only once routing is live.
					}
				</span>
			</p>
		case "gmail_label_merge":
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
				<span class="inline-flex items-center gap-1.5">@Icon("tag", "size-3.5 text-muted-foreground")<span class="font-medium">{ v.From }</span><span class="text-xs text-muted-foreground tabular-nums">{ itoa(v.FromCount) }</span></span>
				@Icon("arrow-right", "size-3.5 text-muted-foreground")
				<span class="inline-flex items-center gap-1.5">@Icon("tag", "size-3.5 text-muted-foreground")<span class="font-medium">{ v.Into }</span><span class="text-xs text-muted-foreground tabular-nums">{ itoa(v.IntoCount) }</span></span>
			</div>
			<p class="text-xs text-muted-foreground">Adds “{ v.Into }” to the messages labelled “{ v.From }”, then removes “{ v.From }” from them. No mail is deleted.</p>
			if pc.Picker {
				@plainPicker(pc, "are relabelled")
			}
		case "notion_link":
			<div class="grid items-center gap-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]">
				@pageRef(v.A)
				<span class="flex items-center gap-2 text-muted-foreground max-sm:ps-1">@Icon("link", "size-4")<span class="sr-only">linked with</span></span>
				@pageRef(v.B)
			</div>
			<p class="text-xs text-muted-foreground">Adds a link to the page text under a “Related” heading.</p>
			if v.Reason != "" {
				<blockquote class="border-s-2 ps-3 text-sm text-muted-foreground">{ v.Reason }</blockquote>
			}
		case "calendar_event":
			<dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_minmax(0,1fr)]">
				<dt class="text-muted-foreground">Calendar</dt>
				<dd>{ cond(v.Calendar == "google", "Google", "iCloud") }</dd>
				<dt class="text-muted-foreground">{ cond(v.AllDay, "Date", "When") }</dt>
				<dd class="tabular-nums">{ v.Start } → { v.End }</dd>
				if v.Location != "" {
					<dt class="text-muted-foreground">Where</dt>
					<dd>{ v.Location }</dd>
				}
				if v.Notes != "" {
					<dt class="text-muted-foreground">Notes</dt>
					<dd class="whitespace-pre-wrap">{ v.Notes }</dd>
				}
				if v.Source != nil && v.Source.Subject != "" {
					<dt class="text-muted-foreground">From mail</dt>
					<dd>{ v.Source.Subject }</dd>
				}
			</dl>
			<p class="text-xs text-muted-foreground">Nobody is invited and no notification is sent.</p>
		case "reminder":
			<dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_minmax(0,1fr)]">
				<dt class="text-muted-foreground">Reminder</dt>
				<dd>{ v.Text }</dd>
				<dt class="text-muted-foreground">Due</dt>
				<dd class="tabular-nums">{ v.Due }</dd>
				<dt class="text-muted-foreground">Remind at</dt>
				<dd class="tabular-nums">{ v.RemindAt }</dd>
				if v.Subject != "" {
					<dt class="text-muted-foreground">From mail</dt>
					<dd>{ v.Subject }</dd>
				}
			</dl>
			<p class="text-xs text-muted-foreground">Approving creates a one-time schedule that notifies you.</p>
		case "notion_edit":
			@pageRef(v.Page)
			<dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_minmax(0,1fr)]">
				<dt class="text-muted-foreground">You asked</dt>
				<dd>{ v.Instruction }</dd>
				if v.Summary != "" {
					<dt class="text-muted-foreground">The 9B changed</dt>
					<dd>{ v.Summary }</dd>
				}
			</dl>
			<div class="flex flex-col overflow-hidden rounded-md border">
				<p class="flex items-center gap-3 border-b bg-muted/50 px-3 py-1.5 text-xs tabular-nums">
					<span class="text-success">+{ itoa(countDiff(v.Diff, "add")) }<span class="sr-only">lines added</span></span>
					<span class="text-destructive">−{ itoa(countDiff(v.Diff, "del")) }<span class="sr-only">lines removed</span></span>
				</p>
				<div class="max-h-96 overflow-auto bg-background py-1 font-mono text-xs/5" role="group" aria-label="Changes">
					for _, line := range v.Diff {
						switch line.Op {
							case "add":
								<ins class="grid grid-cols-[--spacing(6)_minmax(0,1fr)] bg-success/10 no-underline"><span class="select-none text-center text-success" aria-hidden="true">+</span><span class="whitespace-pre-wrap break-words pe-3">{ line.Text }</span></ins>
							case "del":
								<del class="grid grid-cols-[--spacing(6)_minmax(0,1fr)] bg-destructive/10 no-underline"><span class="select-none text-center text-destructive" aria-hidden="true">−</span><span class="whitespace-pre-wrap break-words pe-3 text-muted-foreground line-through decoration-destructive/40">{ line.Text }</span></del>
							default:
								<div class="grid grid-cols-[--spacing(6)_minmax(0,1fr)]"><span aria-hidden="true"></span><span class="whitespace-pre-wrap break-words pe-3 text-muted-foreground">{ line.Text }</span></div>
						}
					}
				</div>
			</div>
		case "notion_wiki_plan":
			<p class="text-sm text-muted-foreground">Turns the Notion workspace into the wiki page tree under Wiki Home. Dropped rows and emptied databases are archived (never deleted); every step is undoable.</p>
			<div class="flex flex-wrap gap-1.5">
				for _, e := range sortedCounts(v.Counts) {
					<span class="badge" data-variant={ cond(e.K == "drop", "destructive", "secondary") }>{ itoa(e.N) } { strings.ToLower(get(decisionLabels, e.K, e.K)) }</span>
				}
			</div>
			<div class="grid gap-4 md:grid-cols-2">
				<div class="flex min-w-0 flex-col gap-1.5">
					<h4 class="text-xs font-medium text-muted-foreground">Hubs under Wiki Home</h4>
					<ul class="flex flex-col gap-1 text-sm" role="list">
						for _, h := range v.Hubs {
							<li>
								<span class="font-medium">{ h.Title }</span>
								if h.Description != "" {
									<span class="text-muted-foreground">{ h.Description }</span>
								}
							</li>
						}
					</ul>
				</div>
				<div class="flex min-w-0 flex-col gap-1.5">
					<h4 class="text-xs font-medium text-muted-foreground">Databases</h4>
					<ul class="flex flex-col gap-1 text-sm" role="list">
						for _, d := range v.Databases {
							<li class="flex min-w-0 flex-col"><span><span class="font-medium">{ d.Title }</span> <span class="text-muted-foreground">→ { cond(d.Mode == "table", "one page with a table", "hub with child pages") } under { d.Hub }</span></span><span class="truncate text-xs text-muted-foreground">{ d.Reason }</span></li>
						}
					</ul>
				</div>
			</div>
			<details class="group/list">
				<summary class="inline-flex gap-1 rounded-sm text-xs font-medium text-muted-foreground hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
					@Icon("chevron-down", "size-3.5 transition-transform group-open/list:rotate-180")
					Every row and page ({ itoa(len(v.Items)) })
				</summary>
				<ul class="mt-2 flex max-h-96 flex-col divide-y overflow-y-auto rounded-md border bg-background" role="list">
					for _, i := range v.Items {
						<li class="flex min-w-0 flex-col gap-0.5 px-3 py-2">
							<span class="flex min-w-0 items-center gap-2">
								<span class="badge shrink-0" data-variant={ cond(i.Decision == "drop", "destructive", cond(i.Decision == "keep", "outline", "secondary")) }>{ get(decisionLabels, i.Decision, i.Decision) }</span>
								<a class="truncate text-sm hover:underline" href={ "/notion/" + i.ID }>{ or(i.Title, "Untitled") }</a>
								if i.Source != "" {
									<span class="shrink-0 text-xs text-muted-foreground">{ i.Source }</span>
								}
								if i.Hub != "" {
									<span class="shrink-0 text-xs text-muted-foreground">→ { i.Hub }</span>
								}
								if i.MergeInto != "" {
									<span class="truncate text-xs text-muted-foreground">→ into { i.MergeInto }</span>
								}
							</span>
							<span class="text-xs text-muted-foreground">{ i.Reason }</span>
						</li>
					}
				</ul>
			</details>
	}
}

// `{% set footer %}...{% endset %}`
templ proposalFooter(pc PC) {
	{{ p := pc.P }}
	if pc.Pending {
		{{ deletes := p.Kind == "deletion_rule" }}
		<div class="flex flex-wrap items-center gap-2">
			<button
				type="submit"
				class="btn"
				data-size="sm"
				name="all"
				value="1"
				if deletes {
					data-confirm={ cond(pc.Picker, "Move all matching messages to Trash now and save the rule?", "Save the rule? Nothing moves to Trash now.") }
				}
			>
				@Icon(cond(pc.Picker, "check-check", "check"))
				{ cond(pc.Picker, "Approve all", "Approve") }
			</button>
			if pc.Picker {
				<button
					type="submit"
					class="btn"
					data-size="sm"
					data-variant="outline"
					data-approve-picked
					if deletes {
						data-confirm="Move the selected messages to Trash now and save the rule?"
						data-confirm-none="Save the rule without moving any messages to Trash?"
					}
				>
					@Icon("check")<span data-some>Approve <span class="tabular-nums" data-picked-total>{ itoa(pickedTotal(pc.Picks)) }</span> selected</span>
					if deletes {
						<span data-none hidden>Save rule only</span>
					}
				</button>
			}
			<span id={ "proposal-spinner-" + itoa(p.ID) } class="htmx-indicator inline-flex items-center gap-1.5 text-xs text-muted-foreground" role="status">
				@Icon("loader-circle", "size-4 animate-spin")
				Applying…
			</span>
			<div class="ml-auto flex gap-1">
				<button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post={ "/proposals/" + itoa(p.ID) + "/dismiss" } hx-indicator="unset">Dismiss</button>
				<button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post={ "/proposals/" + itoa(p.ID) + "/dismiss" } hx-vals='{"forever": "1"}' hx-indicator="unset" title="Never propose this again">Dismiss forever</button>
			</div>
		</div>
	} else if p.Status == "applied" {
		<div class="flex flex-wrap items-center gap-2">
			<p class="flex min-w-0 flex-1 items-start gap-2 text-sm text-success">@Icon("check", "mt-0.5 size-4 shrink-0")<span>{ resultSummary(p) } <span class="text-xs text-muted-foreground">@When(p.AppliedTS, "datetime")</span></span></p>
			if p.Undoable {
				<button type="button" class="btn" data-size="sm" data-variant="outline" hx-post={ "/proposals/" + itoa(p.ID) + "/undo" } hx-target={ "#proposal-" + itoa(p.ID) } hx-swap="outerHTML" hx-disabled-elt="this" hx-confirm="Undo this proposal and put everything back?">
					@Icon("undo-2")
					Undo
				</button>
			}
		</div>
	} else if p.Status == "failed" {
		<div class="flex flex-wrap items-center gap-2">
			<p class="flex-1 text-xs whitespace-nowrap text-muted-foreground">Tried @When(p.DecidedTS, "datetime")</p>
			if p.Kind == "notion_wiki_plan" {
				<span id={ "proposal-spinner-" + itoa(p.ID) } class="htmx-indicator inline-flex items-center gap-1.5 text-xs text-muted-foreground" role="status">
					@Icon("loader-circle", "size-4 animate-spin")
					Applying…
				</span>
				<button type="button" class="btn" data-size="sm" hx-post={ "/proposals/" + itoa(p.ID) + "/approve" } hx-vals='{"all": "1"}' hx-target={ "#proposal-" + itoa(p.ID) } hx-swap="outerHTML" hx-disabled-elt="this" hx-indicator={ "#proposal-spinner-" + itoa(p.ID) } title="Skips the steps the earlier attempt finished">
					@Icon("play")
					Resume
				</button>
			}
			if p.Undoable {
				<button type="button" class="btn" data-size="sm" data-variant="outline" hx-post={ "/proposals/" + itoa(p.ID) + "/undo" } hx-target={ "#proposal-" + itoa(p.ID) } hx-swap="outerHTML" hx-disabled-elt="this">
					@Icon("undo-2")
					Undo what it did
				</button>
			}
			<button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post={ "/proposals/" + itoa(p.ID) + "/dismiss" } hx-target={ "#proposal-" + itoa(p.ID) } hx-swap="outerHTML">Dismiss</button>
		</div>
	} else {
		<p class="text-xs text-muted-foreground">
			{ cond(p.Status == "dismissed" || p.Status == "suppressed", "Dismissed", "Decided") }
			@When(p.DecidedTS, "datetime")
			if p.Status == "suppressed" {
				. atrium will not propose this again.
			}
		</p>
	}
}

// The Jinja wraps the shared header/body/footer in `{% if pending %}<form>...{% endif %}`: unbalanced tags
// across an if are not expressible in templ, so the inner content is a component used in both branches.
templ proposalInner(pc PC, mode string) {
	{{ p := pc.P }}
	<header class="flex flex-col gap-2 p-4 pb-3">
		<div class="flex flex-wrap items-center gap-2">
			<span class="badge" data-variant="secondary">
				@Icon(kindIcon(p.Kind))
				{ kindLabel(p.Kind) }
			</span>
			if p.Account != "" {
				<span class="badge" data-variant="outline">{ p.Account }</span>
			}
			@StatusBadge(p.Status)
			<span class="ml-auto text-xs text-muted-foreground">#{ itoa(p.ID) } · @When(p.CreatedTS, "date")</span>
		</div>
		<h3 id={ "proposal-title-" + itoa(p.ID) } class="font-medium text-pretty">{ p.Title }</h3>
	</header>
	<div class="flex flex-col gap-4 px-4 pb-4">@proposalBody(pc, mode)</div>
	<footer class="border-t px-4 py-3">@proposalFooter(pc)</footer>
}

// _proposal.html
templ ProposalCard(p Proposal, d ProposalsPageData) {
	{{ pc := newPC(p) }}
	<li id={ "proposal-" + itoa(p.ID) } class={ "scroll-mt-20 rounded-lg border bg-card target:ring-2 target:ring-ring", templ.KV("opacity-80", p.Status == "dismissed" || p.Status == "suppressed") }>
		<article aria-labelledby={ "proposal-title-" + itoa(p.ID) }>
			if pc.Pending {
				<form
					class="flex flex-col"
					hx-post={ "/proposals/" + itoa(p.ID) + "/approve" }
					hx-target={ "#proposal-" + itoa(p.ID) }
					hx-swap="outerHTML"
					hx-disabled-elt="find button"
					hx-indicator={ "#proposal-spinner-" + itoa(p.ID) }
					if pc.Picker {
						data-selection
					}
				>
					@proposalInner(pc, d.Mode)
				</form>
			} else {
				@proposalInner(pc, d.Mode)
			}
		</article>
	</li>
	if d.PendingOOB {
		@PendingBadge(d.PendingCount, true)
	}
	if d.Toast != nil {
		@ToastOOB(*d.Toast)
	}
}

// _toast.html
templ ToastOOB(t Toast) {
	<div id="toaster" hx-swap-oob="beforeend">@ToastC(Toast{Category: t.Category, Title: t.Title, Description: t.Description})</div>
}
