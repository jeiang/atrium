package main

// ---- _icons.html ----
// `{{ ICONS[name] | safe }}`: the icon map is compile-time Go data, so templ.Raw is the (only) trust point.
templ Icon(name string, class ...string) {
	<svg class={ "lucide lucide-" + name, class } xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		@iconPaths(name)
	</svg>
}

// ---- _macros.html ----
templ ModeBadge(mode string, paused bool) {
	if mode == "live" && paused {
		<span class="badge border-warning/30 bg-warning/10 text-warning">
			@Icon("lock")
			Live, paused
		</span>
	} else if mode == "live" {
		<span class="badge" data-variant="destructive">
			@Icon("zap")
			Live
		</span>
	} else {
		<span class="badge border-warning/30 bg-warning/10 text-warning">
			@Icon("eye-off")
			Shadow
		</span>
	}
}

templ PendingBadge(count int, oob bool) {
	<span
		id="pending-count"
		class="badge ms-auto empty:hidden"
		data-variant="secondary"
		if oob {
			hx-swap-oob="true"
		}
	>
		if count != 0 {
			{ itoa(count) }
			<span class="sr-only">pending</span>
		}
	</span>
}

templ When(epoch float64, style string) {
	if epoch != 0 {
		<time datetime={ ts(epoch, "iso") }>{ ts(epoch, style) }</time>
	}
}

templ Spinner(id, label string) {
	<span id={ id } class="htmx-indicator inline-flex text-muted-foreground" role="status" aria-label={ label }>@Icon("loader-circle", "size-4 animate-spin")</span>
}

// {% macro empty_state(icon_name, title) %}...{{ caller() }}: caller() becomes children.
templ EmptyState(iconName, title string) {
	<div class="empty border">
		<header>
			<figure>@Icon(iconName)</figure>
			<h3>{ title }</h3>
			if templ.GetChildren(ctx) != nil {
				<p>
					{ children... }
				</p>
			}
		</header>
	</div>
}

// `{% macro external(url) %}href=... target=... rel=...{% endmacro %}` returns an ATTRIBUTE FRAGMENT.
// templ has no such thing; the equivalent is a wrapper element component taking children and extra attrs
// (attrs are emitted BEFORE href so the attribute order matches the Jinja output).
templ ExtLink(url, class string, attrs templ.Attributes) {
	<a class={ class } { attrs... } href={ url } target="_blank" rel="noopener noreferrer">
		{ children... }
	</a>
}

// {% macro preview_attrs(url) %} same story.
templ PreviewLink(url, class string, attrs templ.Attributes) {
	<a class={ class } { attrs... } href={ url } hx-get={ url } hx-target="#preview-body" hx-swap="innerHTML show:top">
		{ children... }
	</a>
}

templ StatusBadge(status string) {
	switch status {
		case "applied":
			<span class="badge border-success/30 bg-success/10 text-success">
				@Icon("check")
				{ statusLabels[status] }
			</span>
		case "failed":
			<span class="badge" data-variant="destructive">
				@Icon("circle-alert")
				{ statusLabels[status] }
			</span>
		case "approved":
			<span class="badge" data-variant="outline">
				@Icon("loader-circle", "animate-spin")
				{ statusLabels[status] }
			</span>
		case "pending":
			<span class="badge" data-variant="outline">{ statusLabels[status] }</span>
		default:
			<span class="badge" data-variant="secondary">{ get(statusLabels, status, status) }</span>
	}
}

templ PageLink(ref *PageRef, class string) {
	<a class={ "rounded-sm font-medium underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", class } href={ "/notion/" + enc(ref.ID) }>{ or(ref.Title, "Untitled") }</a>
}

templ BranchButton(t Thread, seq int) {
	<form method="post" action={ "/chat/" + itoa(t.ID) + "/branch" } class="inline">
		<input type="hidden" name="csrf_token" value={ csrf(ctx) }/>
		<input type="hidden" name="seq" value={ itoa(seq) }/>
		<button type="submit" class="btn" data-size="sm" data-variant="ghost" title="Start a new thread with the conversation up to here">
			@Icon("git-branch", "size-3.5")
			Branch
		</button>
	</form>
}

templ FileIcon(mediaType, class string) {
	@Icon(cond(hasPrefix(mediaType, "image/"), "image", "file-text"), class)
}

templ FileChips(threadID int, files []File) {
	if len(files) > 0 {
		<ul class="flex flex-wrap gap-1" aria-label="Attached files" data-attachments>
			for _, f := range files {
				<li>
					@PreviewLink("/chat/"+itoa(threadID)+"/files/"+itoa(f.ID), "badge max-w-64", templ.Attributes{"data-variant": "outline"}) {
						@FileIcon(f.MediaType, "size-3")
						<span class="truncate">{ f.Name }</span>
					}
				</li>
			}
		</ul>
	}
}

templ AttachField() {
	<input type="file" name="upload" multiple class="sr-only" tabindex="-1" data-upload/>
	<ul class="flex flex-wrap gap-1 empty:hidden" aria-label="Files to send" data-chips></ul>
}

templ AttachButton() {
	<button type="button" class="btn" data-size="sm" data-variant="ghost" data-action="pick-files" title="Attach files: PDF, images, text, CSV, docx, xlsx">
		@Icon("paperclip", "size-3.5")
		Attach
	</button>
}

templ ConditionText(c Condition) {
	<span class="font-medium">{ get(fieldLabels, c.Field, c.Field) }</span>
	<span class="text-muted-foreground">{ get(opLabels, c.Op, c.Op) }</span>
	if v, ok := conditionValue(c.Value); ok {
		<code class="rounded-sm bg-muted px-1 py-0.5 font-mono text-xs break-all">{ v }</code>
	}
}

templ ActivityStep(step Step) {
	switch step.Kind {
		case "thinking":
			<li class="flex gap-2" data-step="thinking">@Icon("brain", "mt-0.5 size-3.5 shrink-0")<div class="min-w-0 whitespace-pre-wrap break-words text-muted-foreground">{ step.Text }</div></li>
		case "note":
			<li class="flex gap-2" data-step="note">@Icon("bot", "mt-0.5 size-3.5 shrink-0")<div class="markdown min-w-0">@md(step.Text)</div></li>
		case "tool":
			<li data-step="tool" data-tool-id={ step.ID }>
				<details class="rounded-md border bg-card">
					<summary class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-muted-foreground">
						@Icon(cond(step.Name == "research", "users", "wrench"), "size-3.5 shrink-0")<code class="font-mono text-foreground">{ step.Name }</code>
						<span class="truncate font-mono">{ step.Args }</span>
						if step.State == "unknown" {
							<span class="badge ms-auto" data-variant="destructive">unverified</span>
						} else if step.IsError {
							<span class="badge ms-auto" data-variant="destructive">error</span>
						} else if step.State == "started" {
							<span class="badge ms-auto" data-variant="outline">
								@Icon("loader-circle", "animate-spin")
								running
							</span>
						}
					</summary>
					<div class="border-t px-3 py-2 font-mono whitespace-pre-wrap break-words">{ or(step.Result, "(no result yet)") }</div>
					if step.ChildThreadID != 0 {
						<a class="block border-t px-3 py-1.5 underline underline-offset-4" href={ "/chat/" + itoa(step.ChildThreadID) }>Subagent transcript</a>
					}
				</details>
			</li>
		case "web_search":
			<li data-step="web_search">
				<details class="rounded-md border bg-card">
					<summary class="flex cursor-pointer items-center gap-2 px-3 py-1.5 text-muted-foreground">
						@Icon("globe", "size-3.5")
						web search: { itoa(len(step.Results)) } results
						if step.Error != "" {
							<span class="badge ms-auto" data-variant="destructive">{ step.Error }</span>
						}
					</summary>
					<ul class="flex flex-col gap-1 border-t px-3 py-2">
						for _, r := range step.Results {
							<li>
								@ExtLink(r.URL, "underline underline-offset-4", nil) {
									{ trunc(r.Title, 80) }
								}
							</li>
						}
					</ul>
				</details>
			</li>
	}
}

// chat_item(item, thread=None, last_seq=None, busy=False): optional args become a nil pointer / zero values.
templ ChatItem(item Item, t *Thread, lastSeq int, busy bool) {
	switch item.Kind {
		case "user":
			<li class="group flex gap-3" data-seq={ itoa(item.Seq) }>
				<span class="mt-1 grid size-7 shrink-0 place-items-center rounded-full bg-secondary text-secondary-foreground" aria-hidden="true">@Icon("user", "size-4")</span>
				<div class="flex min-w-0 flex-1 flex-col gap-1">
					<div class="rounded-lg bg-secondary/60 px-4 py-3 text-sm whitespace-pre-wrap break-words" data-text>{ item.Text }</div>
					if t != nil {
						@FileChips(t.ID, item.Files)
					}
					if t != nil && t.Kind == "chat" {
						<div class="flex items-center gap-1 text-xs opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
							if item.Seq == lastSeq && !busy {
								<button type="button" class="btn" data-size="sm" data-variant="ghost" data-action="edit-message">
									@Icon("pencil", "size-3.5")
									Edit
								</button>
							}
							@BranchButton(*t, item.Seq)
						</div>
					}
				</div>
			</li>
		case "assistant":
			<li class="group flex gap-3" data-seq={ itoa(item.Seq) }>
				<span class="mt-1 grid size-7 shrink-0 place-items-center rounded-full bg-primary text-primary-foreground" aria-hidden="true">@Icon("bot", "size-4")</span>
				<div class="min-w-0 flex-1 flex flex-col gap-2 px-1 py-2">
					<div class="markdown">@md(item.Text)</div>
					if len(item.Citations) > 0 {
						<ol class="flex flex-wrap gap-2 text-xs" aria-label="Sources">
							for i, c := range item.Citations {
								if c.URL != "" {
									<li>
										@ExtLink(c.URL, "badge", templ.Attributes{"data-variant": "secondary"}) {
											[{ itoa(i + 1) }]
											@Icon("external-link", "size-3")
											{ trunc(c.Title, 60) }
										}
									</li>
								} else {
									<li>
										<span class="badge" data-variant="secondary" title={ c.Cited }>
											[{ itoa(i + 1) }]
											@Icon("file-text", "size-3")
											{ trunc(c.Title, 40) }: “{ trunc(c.Cited, 60) }”
										</span>
									</li>
								}
							}
						</ol>
					}
					if t != nil && t.Kind == "chat" {
						<div class="flex items-center gap-1 text-xs opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
							if lastSeq != 0 && item.Seq > lastSeq && !busy {
								<button type="button" class="btn" data-size="sm" data-variant="ghost" hx-post={ "/chat/" + itoa(t.ID) + "/regenerate" } hx-target="#transcript" hx-swap="innerHTML" hx-disabled-elt="this">
									@Icon("refresh-cw", "size-3.5")
									Regenerate
								</button>
							}
							@BranchButton(*t, item.Seq)
						</div>
					}
				</div>
			</li>
		case "activity":
			<li class="ps-10" data-seq={ itoa(item.Seq) } data-run={ itoa(item.RunID) }>
				<details class="activity text-xs">
					<summary class="flex cursor-pointer items-center gap-2 text-muted-foreground">
						@Icon("chevron-down", "size-3.5")
						{ itoa(len(item.Steps)) } step{ cond(len(item.Steps) == 1, "", "s") }
					</summary>
					<ol class="mt-2 flex flex-col gap-1.5 border-s ps-3">
						for _, step := range item.Steps {
							@ActivityStep(step)
						}
					</ol>
				</details>
			</li>
		case "draft":
			<li class="ps-10" data-seq={ itoa(item.Seq) } data-draft={ itoa(item.Draft.ID) }>
				@PreviewLink("/drafts/"+itoa(item.Draft.ID), "flex items-center gap-3 rounded-lg border bg-card px-3 py-2 text-sm hover:bg-accent", nil) {
					@Icon("mail", "size-4 shrink-0 text-muted-foreground")
					<span class="flex min-w-0 flex-1 flex-col">
						<span class="truncate font-medium">{ or(item.Draft.Subject, "(no subject)") }</span>
						<span class="truncate text-xs text-muted-foreground">to { item.Draft.ToAddrs }</span>
					</span>
					<span class="badge" data-variant={ cond(item.Draft.Status == "sent", "secondary", "outline") }>{ item.Draft.Status }</span>
				}
			</li>
		case "queued":
			<li class="flex gap-3" data-queued={ itoa(item.ID) }>
				<span class="mt-1 grid size-7 shrink-0 place-items-center rounded-full bg-secondary text-secondary-foreground" aria-hidden="true">@Icon("user", "size-4")</span>
				<div class="flex min-w-0 flex-1 flex-col gap-1">
					<div class="rounded-lg border border-dashed px-4 py-3 text-sm whitespace-pre-wrap break-words">{ item.Text }</div>
					if len(item.Files) > 0 {
						<span class="text-xs text-muted-foreground">
							@Icon("paperclip", "size-3")
							{ fileNames(item.Files) }
						</span>
					}
					<span class="text-xs text-muted-foreground">
						@Icon("clock", "size-3")
						Queued: joins the conversation at the assistant's next step
					</span>
				</div>
			</li>
		case "compaction":
			<li class="flex items-center gap-3 text-xs text-muted-foreground" data-seq={ itoa(item.Seq) } role="separator">
				<span class="h-px flex-1 bg-border"></span>Context compacted<span class="h-px flex-1 bg-border"></span>
			</li>
	}
}

// Text emits an escaped string. Needed because `@Icon(x) { expr }` on one line parses as a children block,
// so "icon followed by dynamic text" has no direct spelling in templ.
templ Text(s string) {
	{ s }
}
