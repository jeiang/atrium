{
  "globals": {
    "asset_version": "golden",
    "csrf_token": "csrf-golden-token",
    "mode": "live",
    "accounts": [
      "icloud",
      "gmail"
    ],
    "stages": [
      "correction",
      "operator",
      "learned",
      "knn",
      "llm",
      "fallback"
    ],
    "rule_fields": [
      "from_addr",
      "from_domain",
      "from_name",
      "reply_to",
      "rpath_domain",
      "list_id",
      "subject",
      "subject_tmpl",
      "msgid_domain",
      "precedence",
      "category",
      "to",
      "dkim_d",
      "esp",
      "att_type",
      "att_name",
      "age_days"
    ],
    "rule_ops": [
      "eq",
      "in",
      "suffix",
      "re",
      "present",
      "absent",
      "gte"
    ],
    "valueless_ops": [
      "present",
      "absent"
    ]
  },
  "context": {},
  "calls": [
    {
      "macro": "tabs",
      "args": [],
      "kwargs": {
        "id": "rules-tabs",
        "tabsets": [
          {
            "tab": "Operator <span class=\"badge\" data-variant=\"secondary\">3</span>",
            "panel": {
              "$safe": "<div><p>Operator panel &amp; rules</p></div>"
            }
          },
          {
            "tab": "Learned <span class=\"badge\" data-variant=\"secondary\">0</span>",
            "panel": {
              "$safe": "<div><p>Café naïve — 東京 🎉 مرحبا</p></div>"
            }
          }
        ],
        "main_attrs": {
          "class": "gap-0"
        },
        "tablist_attrs": {
          "data-variant": "line",
          "aria-label": "Rule sources"
        }
      }
    }
  ]
}
