{
  "globals": {
    "asset_version": "golden",
    "csrf_token": "csrf-golden-token",
    "mode": "live",
    "accounts": [
      "icloud",
      "gmail"
    ],
    "stages": [
      "correction",
      "operator",
      "learned",
      "knn",
      "llm",
      "fallback"
    ],
    "rule_fields": [
      "from_addr",
      "from_domain",
      "from_name",
      "reply_to",
      "rpath_domain",
      "list_id",
      "subject",
      "subject_tmpl",
      "msgid_domain",
      "precedence",
      "category",
      "to",
      "dkim_d",
      "esp",
      "att_type",
      "att_name",
      "age_days"
    ],
    "rule_ops": [
      "eq",
      "in",
      "suffix",
      "re",
      "present",
      "absent",
      "gte"
    ],
    "valueless_ops": [
      "present",
      "absent"
    ]
  },
  "context": {
    "rule": {
      "id": "receipts",
      "account": "gmail",
      "action": "file",
      "dest": "Travel|Flights",
      "when": [
        {
          "field": "from_domain",
          "op": "suffix",
          "value": [
            "shop.example",
            "store.example"
          ]
        },
        {
          "field": "subject",
          "op": "re",
          "value": "^Order <\\d+>"
        },
        {
          "field": "list_id",
          "op": "present"
        },
        {
          "field": "age_days",
          "op": "gte",
          "value": 30
        }
      ]
    },
    "is_new": false,
    "errors": [
      "“is” needs a value.",
      "<script>alert(\"xss\")</script>"
    ],
    "folders": {
      "icloud": [
        {
          "folder": "Receipts",
          "count": 1
        },
        {
          "folder": "Odd <folder> & co",
          "count": 2
        }
      ],
      "gmail": [
        {
          "folder": "Travel|Flights",
          "count": 4
        }
      ]
    },
    "suggestions": []
  }
}
