          "messages": [
            {
              "content": "You read one email for its owner and list explicit commitments and deadlines. A commitment is a clear promise to do something (owner 'me' when the mailbox owner promises or must act, owner 'them' when the other party promises or must act). Include a deadline only as an explicit calendar date written YYYY-MM-DD, resolved from a date the message states (for example 'by March 3'); when no explicit date is given set due to null. Never invent dates, skip vague pleasantries ('let's catch up'), newsletters and automated notices. Return an empty list when there is nothing.",
              "role": "system"
            },
            {
              "content": "This message was received by the mailbox owner on 2026-10-14.\nFrom: Landlord <landlord@homes.test>\nTo: me@icloud.test\nSubject: Lease\nBody:\nPlease send the signed lease by October 20.",
              "role": "user"
            }
          ],
          "model": "qwen",
          "response_format": {
            "json_schema": {
              "name": "answer",
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "commitments": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "due": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "owner": {
                          "enum": [
                            "me",
                            "them"
                          ],
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "text",
                        "owner",
                        "due"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "commitments"
                ],
                "type": "object"
              },
              "strict": true
            },
            "type": "json_schema"
          },
          "temperature": 0
        },
        "body_encoding": "json",
        "headers": {
          "content-type": "application/json"
        },
        "method": "POST",
        "path": "/v1/chat/completions",
        "query": "",
        "url": "http://chat.invalid/v1/chat/completions"
      },
      "response": {
