{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "font": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": ["Alegreya Sans", "Alegreya Sans Fallback", "Gill Sans", "Seravek", "Optima", "ui-sans-serif", "sans-serif"]
    },
    "font-read": { "$type": "fontFamily", "$value": "{font.font-sans}" },
    "font-mono": {
      "$type": "fontFamily",
      "$value": ["Fira Mono", "Fira Mono Fallback", "ui-monospace", "SF Mono", "Menlo", "monospace"]
    },
    "t-xs": { "$type": "dimension", "$value": { "value": 0.8125, "unit": "rem" } },
    "t-sm": { "$type": "dimension", "$value": { "value": 0.9375, "unit": "rem" } },
    "t-md": { "$type": "dimension", "$value": { "value": 1.0625, "unit": "rem" } },
    "t-lg": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
    "t-xl": { "$type": "dimension", "$value": { "value": 1.625, "unit": "rem" } },
    "t-2xl": { "$type": "dimension", "$value": { "value": 2.25, "unit": "rem" } },
    "t-3xl": {
      "$type": "dimension",
      "$value": { "value": 3.25, "unit": "rem" },
      "$extensions": { "org.atrium.css": "clamp(2.25rem, 1.6rem + 2.4vw, 3.25rem)" }
    },
    "t-figure": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
    "t-display": {
      "$type": "dimension",
      "$value": { "value": 4, "unit": "rem" },
      "$extensions": { "org.atrium.css": "clamp(2.75rem, 1.9rem + 3.2vw, 4rem)" }
    },
    "t-input": { "$type": "dimension", "$value": "{font.t-sm}" },
    "lh-tight": { "$type": "number", "$value": 1.15 },
    "lh-body": { "$type": "number", "$value": 1.5 },
    "lh-read": { "$type": "number", "$value": 1.65 },
    "lh-display": { "$type": "number", "$value": 1 }
  },
  "space": {
    "$type": "dimension",
    "s-1": { "$value": { "value": 4, "unit": "px" } },
    "s-2": { "$value": { "value": 8, "unit": "px" } },
    "s-3": { "$value": { "value": 12, "unit": "px" } },
    "s-4": { "$value": { "value": 16, "unit": "px" } },
    "s-5": { "$value": { "value": 24, "unit": "px" } },
    "s-6": { "$value": { "value": 32, "unit": "px" } },
    "s-7": { "$value": { "value": 48, "unit": "px" } },
    "s-8": { "$value": { "value": 64, "unit": "px" } },
    "s-9": { "$value": { "value": 96, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "r-sm": { "$value": { "value": 10, "unit": "px" } },
    "r-md": { "$value": { "value": 16, "unit": "px" } },
    "r-lg": { "$value": { "value": 24, "unit": "px" } },
    "r-pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.25, 1, 0.5, 1] },
    "ease-in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
    "dur-1": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
    "dur-2": { "$type": "duration", "$value": { "value": 220, "unit": "ms" } },
    "dur-3": { "$type": "duration", "$value": { "value": 380, "unit": "ms" } },
    "dur-hold": { "$type": "duration", "$value": { "value": 600, "unit": "ms" } }
  },
  "layout": {
    "$type": "dimension",
    "rail-w": { "$value": { "value": 272, "unit": "px" } },
    "read-w": { "$value": { "value": 46, "unit": "rem" } },
    "target": { "$value": { "value": 44, "unit": "px" } },
    "row": { "$value": { "value": 36, "unit": "px" } },
    "row-phone": { "$value": { "value": 48, "unit": "px" } }
  },
  "safe": {
    "$type": "dimension",
    "safe-top": {
      "$value": { "value": 0, "unit": "px" },
      "$extensions": { "org.atrium.css": "env(safe-area-inset-top, 0px)" }
    },
    "safe-right": {
      "$value": { "value": 0, "unit": "px" },
      "$extensions": { "org.atrium.css": "env(safe-area-inset-right, 0px)" }
    },
    "safe-bottom": {
      "$value": { "value": 0, "unit": "px" },
      "$extensions": { "org.atrium.css": "env(safe-area-inset-bottom, 0px)" }
    },
    "safe-left": {
      "$value": { "value": 0, "unit": "px" },
      "$extensions": { "org.atrium.css": "env(safe-area-inset-left, 0px)" }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "desktop": { "$value": { "value": 861, "unit": "px" } },
    "wide": { "$value": { "value": 1240, "unit": "px" } }
  }
}
